diff --git a/apps/cli/script/telemetry-defines.ts b/apps/cli/script/telemetry-defines.ts
new file mode 100644
index 0000000..1af3e62
--- /dev/null
+++ b/apps/cli/script/telemetry-defines.ts
@@ -0,0 +1,139 @@
+/**
+ * Build-time telemetry configuration for the Cline CLI.
+ *
+ * Telemetry and OpenTelemetry settings are inlined into the CLI bundle
+ * (`bun.mts`) and the compiled binaries (`script/build.ts`) as Bun `define`
+ * values, so the runtime environment cannot change them afterwards.
+ *
+ * - `on` inlines the build shell's values. The release workflow sets them
+ *   from repository secrets and opts in with `CLINE_BUILD_TELEMETRY=on`.
+ * - `off` (the default) inlines disabled values whatever the build shell
+ *   contains, so from-source and downstream builds ship with OpenTelemetry
+ *   export, trace content recording, PostHog feature-flag polling and error
+ *   reporting compiled out.
+ */
+
+export type BuildTelemetryMode = "on" | "off";
+
+/** Variables the compiled binaries inline (unchanged from the release build). */
+export const CLI_BINARY_TELEMETRY_ENV_VARS = [
+	"TELEMETRY_SERVICE_API_KEY",
+	"ERROR_SERVICE_API_KEY",
+	"OTEL_TELEMETRY_ENABLED",
+	"OTEL_LOGS_EXPORTER",
+	"OTEL_METRICS_EXPORTER",
+	"OTEL_TRACES_EXPORTER",
+	"CLINE_TRACE_SAMPLE_PERCENT",
+	"CLINE_TRACE_RECORD_CONTENT",
+	"OTEL_EXPORTER_OTLP_PROTOCOL",
+	"OTEL_EXPORTER_OTLP_ENDPOINT",
+	"OTEL_EXPORTER_OTLP_HEADERS",
+] as const;
+
+/** Every telemetry variable either CLI build inlines. */
+export const BUILD_TIME_TELEMETRY_ENV_VARS = [
+	...CLI_BINARY_TELEMETRY_ENV_VARS,
+	"OTEL_METRIC_EXPORT_INTERVAL",
+] as const;
+
+export type BuildTimeTelemetryEnvVar =
+	(typeof BUILD_TIME_TELEMETRY_ENV_VARS)[number];
+
+/** Values that identify a telemetry destination or credential. */
+const TELEMETRY_SECRET_ENV_VARS: readonly BuildTimeTelemetryEnvVar[] = [
+	"TELEMETRY_SERVICE_API_KEY",
+	"ERROR_SERVICE_API_KEY",
+	"OTEL_EXPORTER_OTLP_ENDPOINT",
+	"OTEL_EXPORTER_OTLP_HEADERS",
+];
+
+/** Disabled values for an `off` build; unlisted variables inline as "". */
+const TELEMETRY_OFF_VALUES: Partial<Record<BuildTimeTelemetryEnvVar, string>> =
+	{
+		OTEL_TELEMETRY_ENABLED: "false",
+		OTEL_LOGS_EXPORTER: "none",
+		OTEL_METRICS_EXPORTER: "none",
+		OTEL_TRACES_EXPORTER: "none",
+		CLINE_TRACE_SAMPLE_PERCENT: "0",
+		CLINE_TRACE_RECORD_CONTENT: "false",
+	};
+
+type BuildEnv = Readonly<Record<string, string | undefined>>;
+
+const TELEMETRY_FLAG_PREFIX = "--telemetry=";
+
+function parseMode(value: string, source: string): BuildTelemetryMode {
+	const normalized = value.trim().toLowerCase();
+	if (normalized === "on" || normalized === "off") {
+		return normalized;
+	}
+	throw new Error(
+		`Invalid ${source} value "${value}": expected "on" or "off" for the CLI build telemetry mode.`,
+	);
+}
+
+/**
+ * Resolves the build telemetry mode: `--telemetry=on|off` wins, then
+ * `CLINE_BUILD_TELEMETRY`, then `off`.
+ */
+export function resolveBuildTelemetryMode(
+	args: readonly string[],
+	env: BuildEnv,
+): BuildTelemetryMode {
+	const flag = args
+		.filter((arg) => arg.startsWith(TELEMETRY_FLAG_PREFIX))
+		.at(-1);
+	if (flag !== undefined) {
+		return parseMode(flag.slice(TELEMETRY_FLAG_PREFIX.length), "--telemetry");
+	}
+	const fromEnv = env.CLINE_BUILD_TELEMETRY;
+	if (fromEnv !== undefined && fromEnv.trim() !== "") {
+		return parseMode(fromEnv, "CLINE_BUILD_TELEMETRY");
+	}
+	return "off";
+}
+
+/**
+ * Bun `define` entries for the telemetry variables.
+ *
+ * `on` inlines `env[name] ?? ""` for each of `names`; `off` inlines the
+ * disabled value for every telemetry variable, ignoring `env`.
+ */
+export function buildTelemetryDefines(input: {
+	mode: BuildTelemetryMode;
+	env: BuildEnv;
+	names?: readonly string[];
+}): Record<string, string> {
+	const defines: Record<string, string> = {};
+	if (input.mode === "off") {
+		for (const name of BUILD_TIME_TELEMETRY_ENV_VARS) {
+			defines[`process.env.${name}`] = JSON.stringify(
+				TELEMETRY_OFF_VALUES[name] ?? "",
+			);
+		}
+		return defines;
+	}
+	for (const name of input.names ?? CLI_BINARY_TELEMETRY_ENV_VARS) {
+		defines[`process.env.${name}`] = JSON.stringify(input.env[name] ?? "");
+	}
+	return defines;
+}
+
+/**
+ * Names of telemetry destination/credential variables whose build-shell value
+ * appears in `artifact`. An `off` build asserts this list is empty.
+ */
+export function findLeakedTelemetryValues(
+	artifact: Uint8Array,
+	env: BuildEnv,
+): BuildTimeTelemetryEnvVar[] {
+	const content = Buffer.from(
+		artifact.buffer,
+		artifact.byteOffset,
+		artifact.byteLength,
+	);
+	return TELEMETRY_SECRET_ENV_VARS.filter((name) => {
+		const value = env[name]?.trim();
+		return value ? content.includes(value) : false;
+	});
+}
diff --git a/apps/cli/src/commands/telemetry-defines.test.ts b/apps/cli/src/commands/telemetry-defines.test.ts
new file mode 100644
index 0000000..e93634e
--- /dev/null
+++ b/apps/cli/src/commands/telemetry-defines.test.ts
@@ -0,0 +1,156 @@
+import { createClineTelemetryServiceConfig } from "@cline/shared";
+import { afterEach, describe, expect, it } from "vitest";
+import {
+	BUILD_TIME_TELEMETRY_ENV_VARS,
+	buildTelemetryDefines,
+	CLI_BINARY_TELEMETRY_ENV_VARS,
+	findLeakedTelemetryValues,
+	resolveBuildTelemetryMode,
+} from "../../script/telemetry-defines";
+
+// The values the release workflow injects from repository secrets.
+const RELEASE_ENV = {
+	TELEMETRY_SERVICE_API_KEY: "phc_release_posthog_project_key",
+	ERROR_SERVICE_API_KEY: "phc_release_error_service_key",
+	OTEL_TELEMETRY_ENABLED: "true",
+	OTEL_LOGS_EXPORTER: "otlp",
+	OTEL_METRICS_EXPORTER: "otlp",
+	OTEL_TRACES_EXPORTER: "otlp",
+	CLINE_TRACE_SAMPLE_PERCENT: "100",
+	CLINE_TRACE_RECORD_CONTENT: "true",
+	OTEL_EXPORTER_OTLP_PROTOCOL: "http/json",
+	OTEL_EXPORTER_OTLP_ENDPOINT: "https://otel.release-collector.example",
+	OTEL_EXPORTER_OTLP_HEADERS: "authorization=Bearer release-otel-token",
+	OTEL_METRIC_EXPORT_INTERVAL: "60000",
+} as const;
+
+function inlined(defines: Record<string, string>, name: string): unknown {
+	const raw = defines[`process.env.${name}`];
+	return raw === undefined ? undefined : JSON.parse(raw);
+}
+
+describe("CLI build telemetry mode", () => {
+	it("defaults to off when neither the flag nor CLINE_BUILD_TELEMETRY is set", () => {
+		expect(resolveBuildTelemetryMode([], {})).toBe("off");
+		expect(resolveBuildTelemetryMode(["--single"], {})).toBe("off");
+	});
+
+	it("opts into release telemetry only when asked, with the flag winning over the environment", () => {
+		expect(resolveBuildTelemetryMode([], { CLINE_BUILD_TELEMETRY: "on" })).toBe(
+			"on",
+		);
+		expect(resolveBuildTelemetryMode(["--telemetry=on"], {})).toBe("on");
+		expect(
+			resolveBuildTelemetryMode(["--telemetry=off"], {
+				CLINE_BUILD_TELEMETRY: "on",
+			}),
+		).toBe("off");
+	});
+
+	it("rejects unknown telemetry modes instead of guessing", () => {
+		expect(() => resolveBuildTelemetryMode(["--telemetry=maybe"], {})).toThrow(
+			/telemetry/i,
+		);
+		expect(() =>
+			resolveBuildTelemetryMode([], { CLINE_BUILD_TELEMETRY: "1" }),
+		).toThrow(/telemetry/i);
+	});
+});
+
+describe("CLI build telemetry defines", () => {
+	it("off inlines disabled values even when the build shell carries release telemetry settings", () => {
+		const defines = buildTelemetryDefines({ mode: "off", env: RELEASE_ENV });
+
+		expect(inlined(defines, "OTEL_TELEMETRY_ENABLED")).toBe("false");
+		expect(inlined(defines, "CLINE_TRACE_RECORD_CONTENT")).toBe("false");
+		expect(inlined(defines, "CLINE_TRACE_SAMPLE_PERCENT")).toBe("0");
+		expect(inlined(defines, "TELEMETRY_SERVICE_API_KEY")).toBe("");
+		expect(inlined(defines, "ERROR_SERVICE_API_KEY")).toBe("");
+		expect(inlined(defines, "OTEL_EXPORTER_OTLP_ENDPOINT")).toBe("");
+		expect(inlined(defines, "OTEL_EXPORTER_OTLP_HEADERS")).toBe("");
+		for (const name of ["LOGS", "METRICS", "TRACES"]) {
+			expect(inlined(defines, `OTEL_${name}_EXPORTER`)).toBe("none");
+		}
+		const serialized = JSON.stringify(defines);
+		for (const value of Object.values(RELEASE_ENV)) {
+			if (value.length >= 8) {
+				expect(serialized).not.toContain(value);
+			}
+		}
+	});
+
+	it("off defines every telemetry variable either CLI build inlines", () => {
+		const defines = buildTelemetryDefines({ mode: "off", env: {} });
+
+		for (const name of [
+			...CLI_BINARY_TELEMETRY_ENV_VARS,
+			...BUILD_TIME_TELEMETRY_ENV_VARS,
+		]) {
+			expect(defines, name).toHaveProperty(`process.env.${name}`);
+		}
+	});
+
+	it("on reproduces the existing inline-from-environment behavior for the given variables", () => {
+		const defines = buildTelemetryDefines({
+			mode: "on",
+			env: RELEASE_ENV,
+			names: CLI_BINARY_TELEMETRY_ENV_VARS,
+		});
+
+		expect(Object.keys(defines).sort()).toEqual(
+			CLI_BINARY_TELEMETRY_ENV_VARS.map((name) => `process.env.${name}`).sort(),
+		);
+		for (const name of CLI_BINARY_TELEMETRY_ENV_VARS) {
+			expect(defines[`process.env.${name}`]).toBe(
+				JSON.stringify(RELEASE_ENV[name]),
+			);
+		}
+		expect(
+			buildTelemetryDefines({
+				mode: "on",
+				env: {},
+				names: ["OTEL_TELEMETRY_ENABLED"],
+			}),
+		).toEqual({ "process.env.OTEL_TELEMETRY_ENABLED": '""' });
+	});
+});
+
+describe("CLI build telemetry off: runtime effect", () => {
+	const saved = { ...process.env };
+	afterEach(() => {
+		process.env = { ...saved };
+	});
+
+	it("leaves OpenTelemetry disabled in the shared telemetry config", () => {
+		const defines = buildTelemetryDefines({ mode: "off", env: RELEASE_ENV });
+		for (const name of BUILD_TIME_TELEMETRY_ENV_VARS) {
+			process.env[name] = inlined(defines, name) as string;
+		}
+
+		const config = createClineTelemetryServiceConfig();
+
+		expect(config.enabled).toBe(false);
+		expect(config.otlpEndpoint).toBeFalsy();
+		expect(config.otlpHeaders).toBeUndefined();
+	});
+});
+
+describe("findLeakedTelemetryValues", () => {
+	it("reports build-shell telemetry values that appear in a built artifact", () => {
+		const artifact = new TextEncoder().encode(
+			`...binary...${RELEASE_ENV.OTEL_EXPORTER_OTLP_ENDPOINT}...${RELEASE_ENV.TELEMETRY_SERVICE_API_KEY}...`,
+		);
+
+		expect(findLeakedTelemetryValues(artifact, RELEASE_ENV).sort()).toEqual([
+			"OTEL_EXPORTER_OTLP_ENDPOINT",
+			"TELEMETRY_SERVICE_API_KEY",
+		]);
+	});
+
+	it("checks only destination and credential values, and skips unset variables", () => {
+		const artifact = new TextEncoder().encode("otlp true http/json 100 none");
+
+		expect(findLeakedTelemetryValues(artifact, RELEASE_ENV)).toEqual([]);
+		expect(findLeakedTelemetryValues(artifact, {})).toEqual([]);
+	});
+});
