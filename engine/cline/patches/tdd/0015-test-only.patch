+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+	afterEach,
+	beforeEach,
+	describe,
+	expect,
+	it,
+	type MockInstance,
+	vi,
+} from "vitest";
+import { createShellExecutor } from "./executors/bash";
+import { createBuiltinTools } from "./index";
+import { SHELL_TIMEOUT_ENV } from "./shell-timeout";
+
+type RunCommandsResult = Array<{
+	query: string;
+	result: string;
+	error?: string;
+	success: boolean;
+}>;
+
+const ctx = { agentId: "agent-1", conversationId: "conv-1", iteration: 1 };
+
+function runCommands(options: Parameters<typeof createBuiltinTools>[0] = {}) {
+	const tool = createBuiltinTools({ cwd: process.cwd(), ...options }).find(
+		(t) => t.name === "run_commands",
+	);
+	if (!tool) throw new Error("Expected the run_commands tool");
+	return (command: string) =>
+		tool.execute(
+			{ commands: [command] } as never,
+			ctx,
+		) as Promise<RunCommandsResult>;
+}
+
+/** The delays of every setTimeout armed while `fn` ran. */
+async function armedDelays(fn: () => Promise<unknown>): Promise<number[]> {
+	const spy = vi.spyOn(globalThis, "setTimeout");
+	try {
+		await fn();
+		return spy.mock.calls.map((call) => Number(call[1]));
+	} finally {
+		spy.mockRestore();
+	}
+}
+
+const count = (delays: number[], value: number) =>
+	delays.filter((d) => d === value).length;
+
+function isAlive(pid: number): boolean {
+	try {
+		process.kill(pid, 0);
+		return true;
+	} catch {
+		return false;
+	}
+}
+
+describe("the built-in run_commands tool with the real shell executor", () => {
+	let errSpy: MockInstance;
+
+	beforeEach(() => {
+		vi.stubEnv(SHELL_TIMEOUT_ENV, "");
+		errSpy = vi.spyOn(process.stderr, "write").mockImplementation(() => true);
+	});
+	afterEach(() => {
+		errSpy.mockRestore();
+		vi.unstubAllEnvs();
+	});
+
+	it("arms 600000 ms in the tool and in the executor, and not the old 30000 ms", async () => {
+		const run = runCommands();
+		const delays = await armedDelays(() => run("echo hi"));
+		expect(count(delays, 600_000)).toBeGreaterThanOrEqual(2);
+		expect(delays).not.toContain(30_000);
+	});
+
+	it("arms the value of the environment variable in both", async () => {
+		vi.stubEnv(SHELL_TIMEOUT_ENV, "45000");
+		const delays = await armedDelays(() => runCommands()("echo hi"));
+		expect(count(delays, 45_000)).toBeGreaterThanOrEqual(2);
+		expect(delays).not.toContain(600_000);
+	});
+
+	it("caps a value above the ceiling at 1800000 ms in both", async () => {
+		vi.stubEnv(SHELL_TIMEOUT_ENV, "99999999999");
+		const delays = await armedDelays(() => runCommands()("echo hi"));
+		expect(count(delays, 1_800_000)).toBeGreaterThanOrEqual(2);
+		expect(delays.some((delay) => delay > 1_800_000)).toBe(false);
+	});
+
+	it("uses a timeout the host gives the executor in both", async () => {
+		vi.stubEnv(SHELL_TIMEOUT_ENV, "45000");
+		const run = runCommands({
+			executorOptions: { bash: { timeoutMs: 70_000 } },
+		});
+		const delays = await armedDelays(() => run("echo hi"));
+		expect(count(delays, 70_000)).toBeGreaterThanOrEqual(2);
+		expect(delays).not.toContain(45_000);
+	});
+
+	it("keeps the SDK default of a stand-alone shell executor at 30000 ms", async () => {
+		const shell = createShellExecutor();
+		const delays = await armedDelays(() =>
+			shell("echo hi", process.cwd(), ctx),
+		);
+		expect(delays).toContain(30_000);
+		expect(delays).not.toContain(600_000);
+	});
+
+	it("kills a command that never ends when the limit passes, and reports it", async () => {
+		vi.stubEnv(SHELL_TIMEOUT_ENV, "1500");
+		const dir = await mkdtemp(join(tmpdir(), "shell-timeout-"));
+		try {
+			const pidFile = join(dir, "pid");
+			await writeFile(pidFile, "");
+			const run = runCommands();
+			const startedAt = Date.now();
+
+			const result = await run(`echo $$ > '${pidFile}'; exec sleep 120`);
+
+			const elapsedMs = Date.now() - startedAt;
+			expect(result[0].success).toBe(false);
+			expect(result[0].error).toContain("Command timed out after 1500ms");
+			expect(elapsedMs).toBeGreaterThanOrEqual(1_400);
+			expect(elapsedMs).toBeLessThan(8_000);
+			const pid = Number((await readFile(pidFile, "utf8")).trim());
+			expect(pid).toBeGreaterThan(1);
+			await vi.waitFor(() => expect(isAlive(pid)).toBe(false), {
+				timeout: 5_000,
+				interval: 50,
+			});
+		} finally {
+			await rm(dir, { recursive: true, force: true });
+		}
+	});
+});
