+import {
+	afterEach,
+	beforeEach,
+	describe,
+	expect,
+	it,
+	type MockInstance,
+	vi,
+} from "vitest";
+import { buildRunCommandsDescription, createShellTool } from "./definitions";
+import { createBuiltinTools } from "./index";
+import { SHELL_TIMEOUT_ENV } from "./shell-timeout";
+
+type RunCommandsResult = Array<{
+	query: string;
+	result: string;
+	error?: string;
+	success: boolean;
+}>;
+
+const ctx = { agentId: "agent-1", conversationId: "conv-1", iteration: 1 };
+
+function runCommandsTool(options: Parameters<typeof createBuiltinTools>[0]) {
+	const tool = createBuiltinTools(options).find(
+		(t) => t.name === "run_commands",
+	);
+	if (!tool) throw new Error("Expected the run_commands tool");
+	return tool;
+}
+
+function run(tool: ReturnType<typeof runCommandsTool>) {
+	return tool.execute(
+		{ commands: ["make test"] } as never,
+		ctx,
+	) as Promise<RunCommandsResult>;
+}
+
+/** Tells "still running" from "settled" without awaiting the promise. */
+function watch<T>(promise: Promise<T>): { settled: () => boolean } {
+	let done = false;
+	void promise.then(
+		() => {
+			done = true;
+		},
+		() => {
+			done = true;
+		},
+	);
+	return { settled: () => done };
+}
+
+const never = (): Promise<string> => new Promise<string>(() => {});
+
+describe("run_commands limit in the built-in tools", () => {
+	let errSpy: MockInstance;
+
+	beforeEach(() => {
+		vi.useFakeTimers();
+		vi.stubEnv(SHELL_TIMEOUT_ENV, "");
+		errSpy = vi.spyOn(process.stderr, "write").mockImplementation(() => true);
+	});
+	afterEach(() => {
+		errSpy.mockRestore();
+		vi.unstubAllEnvs();
+		vi.useRealTimers();
+	});
+
+	it("lets a 120 second command finish (the old default ended every command at 30 seconds)", async () => {
+		const execute = vi.fn(
+			() =>
+				new Promise<string>((resolve) =>
+					setTimeout(() => resolve("built"), 120_000),
+				),
+		);
+		const pending = run(runCommandsTool({ executors: { bash: execute } }));
+		const watched = watch(pending);
+
+		await vi.advanceTimersByTimeAsync(30_001);
+		expect(watched.settled()).toBe(false);
+		await vi.advanceTimersByTimeAsync(90_000);
+
+		const result = await pending;
+		expect(result[0]).toMatchObject({ result: "built", success: true });
+		expect(result[0].error).toBeUndefined();
+	});
+
+	it("ends a command that never returns at exactly 600000 ms", async () => {
+		const pending = run(runCommandsTool({ executors: { bash: never } }));
+		const watched = watch(pending);
+
+		await vi.advanceTimersByTimeAsync(599_999);
+		expect(watched.settled()).toBe(false);
+		await vi.advanceTimersByTimeAsync(1);
+
+		const result = await pending;
+		expect(result[0].success).toBe(false);
+		expect(result[0].error).toContain("Command timed out after 600000ms");
+	});
+
+	it("gives the agent runtime twice the command limit before it cuts the tool call", () => {
+		expect(runCommandsTool({ executors: { bash: never } }).timeoutMs).toBe(
+			1_200_000,
+		);
+	});
+
+	it("follows the environment variable, in the limit, the tool call limit and the description", async () => {
+		vi.stubEnv(SHELL_TIMEOUT_ENV, "45000");
+		const tool = runCommandsTool({ executors: { bash: never } });
+		const pending = run(tool);
+		const watched = watch(pending);
+
+		await vi.advanceTimersByTimeAsync(44_999);
+		expect(watched.settled()).toBe(false);
+		await vi.advanceTimersByTimeAsync(1);
+
+		const result = await pending;
+		expect(result[0].error).toContain("Command timed out after 45000ms");
+		expect(tool.timeoutMs).toBe(90_000);
+		expect(tool.description).toContain(
+			"Each command is stopped after 45 seconds.",
+		);
+	});
+
+	it("caps a value above the ceiling at 1800000 ms, so a hung command still ends", async () => {
+		vi.stubEnv(SHELL_TIMEOUT_ENV, "99999999999");
+		const tool = runCommandsTool({ executors: { bash: never } });
+		const pending = run(tool);
+		const watched = watch(pending);
+
+		await vi.advanceTimersByTimeAsync(1_799_999);
+		expect(watched.settled()).toBe(false);
+		await vi.advanceTimersByTimeAsync(1);
+
+		const result = await pending;
+		expect(result[0].error).toContain("Command timed out after 1800000ms");
+		expect(tool.timeoutMs).toBe(3_600_000);
+		expect(tool.description).toContain(
+			"Each command is stopped after 1800 seconds.",
+		);
+	});
+
+	it.each([
+		"0",
+		"999",
+		"-5",
+		"abc",
+		"1.5",
+		"600000ms",
+		"20m",
+	])("ignores the unusable value %j and keeps the 600000 ms default", async (value) => {
+		vi.stubEnv(SHELL_TIMEOUT_ENV, value);
+		const pending = run(runCommandsTool({ executors: { bash: never } }));
+
+		await vi.advanceTimersByTimeAsync(600_000);
+
+		const result = await pending;
+		expect(result[0].error).toContain("Command timed out after 600000ms");
+	});
+
+	it("lets bashTimeoutMs win over the environment, for the tool and its description", async () => {
+		vi.stubEnv(SHELL_TIMEOUT_ENV, "45000");
+		const tool = runCommandsTool({
+			bashTimeoutMs: 5_000,
+			executors: { bash: never },
+		});
+		const pending = run(tool);
+
+		await vi.advanceTimersByTimeAsync(5_000);
+
+		const result = await pending;
+		expect(result[0].error).toContain("Command timed out after 5000ms");
+		expect(tool.description).toContain(
+			"Each command is stopped after 5 seconds.",
+		);
+	});
+
+	it("applies an executor timeout of the host to the tool as well, so the two cannot disagree", async () => {
+		vi.stubEnv(SHELL_TIMEOUT_ENV, "45000");
+		const tool = runCommandsTool({
+			executorOptions: { bash: { timeoutMs: 70_000 } },
+			executors: { bash: never },
+		});
+		const pending = run(tool);
+
+		await vi.advanceTimersByTimeAsync(70_000);
+
+		const result = await pending;
+		expect(result[0].error).toContain("Command timed out after 70000ms");
+		expect(tool.timeoutMs).toBe(140_000);
+		expect(tool.description).toContain(
+			"Each command is stopped after 70 seconds.",
+		);
+	});
+
+	it("does not resolve the limit when run_commands is off", () => {
+		vi.stubEnv(SHELL_TIMEOUT_ENV, "value-for-the-off-test");
+		const names = createBuiltinTools({ enableBash: false }).map((t) => t.name);
+		expect(names).not.toContain("run_commands");
+		expect(errSpy).not.toHaveBeenCalled();
+	});
+
+	it("warns once on stderr about an unusable value and keeps working", async () => {
+		vi.resetModules();
+		vi.stubEnv(SHELL_TIMEOUT_ENV, "10 minutes");
+		errSpy.mockClear();
+		const fresh = await import("./index");
+		fresh.createBuiltinTools({ executors: { bash: never } });
+		fresh.createBuiltinTools({ executors: { bash: never } });
+		const lines = errSpy.mock.calls.map((call) => String(call[0]));
+		expect(lines).toHaveLength(1);
+		expect(lines[0]).toContain(SHELL_TIMEOUT_ENV);
+		expect(lines[0]).toContain("600000");
+		expect(lines[0].endsWith("\n")).toBe(true);
+	});
+
+	it("keeps the SDK default of a stand-alone shell tool at 30000 ms and its description unchanged", async () => {
+		const tool = createShellTool(never);
+		expect(tool.timeoutMs).toBe(60_000);
+		expect(tool.description).not.toContain("Each command is stopped after");
+		const pending = tool.execute(
+			{ commands: ["make"] } as never,
+			ctx,
+		) as Promise<RunCommandsResult>;
+		await vi.advanceTimersByTimeAsync(30_000);
+		const result = await pending;
+		expect(result[0].error).toContain("Command timed out after 30000ms");
+	});
+});
+
+describe("run_commands description with a limit", () => {
+	it("keeps the two-argument form free of a limit sentence", () => {
+		const description = buildRunCommandsDescription("/bin/bash", false);
+		expect(description).not.toContain("Each command is stopped after");
+		expect(description).toContain(
+			"For long-running commands, run them in background",
+		);
+	});
+
+	it("names the limit, keeps finite non-interactive work in the foreground and sends the rest to the background", () => {
+		const description = buildRunCommandsDescription(
+			"/bin/bash",
+			false,
+			600_000,
+		);
+		expect(description).toContain("Each command is stopped after 600 seconds.");
+		expect(description).toContain(
+			"Run builds, installs and test suites in the foreground when they are expected to finish within that time, using non-interactive, single-run flags.",
+		);
+		expect(description).toContain(
+			"Do not run servers, watchers or commands that wait for input in the foreground.",
+		);
+		expect(description).toContain(
+			"Run those, and any work expected to take longer, in background and redirect output to a tmp file that you can read from later.",
+		);
+		expect(description).not.toContain(
+			"For long-running commands, run them in background",
+		);
+	});
+
+	it("shows the limit exactly, in seconds", () => {
+		expect(buildRunCommandsDescription("/bin/bash", false, 1_000)).toContain(
+			"after 1 second.",
+		);
+		expect(buildRunCommandsDescription("/bin/bash", false, 1_500)).toContain(
+			"after 1.5 seconds.",
+		);
+		expect(buildRunCommandsDescription("/bin/bash", false, 1)).toContain(
+			"after 0.001 seconds.",
+		);
+		expect(
+			buildRunCommandsDescription("/bin/bash", false, 1_800_000),
+		).toContain("after 1800 seconds.");
+	});
+
+	it("names the limit in the Windows form too", () => {
+		const description = buildRunCommandsDescription("cmd", true, 600_000);
+		expect(description).toContain("Each command is stopped after 600 seconds.");
+	});
+});
