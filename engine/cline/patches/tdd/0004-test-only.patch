+import type { AgentSideConnection } from "@agentclientprotocol/sdk";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+// Catalog stand-in: the provider default is minimax.minimax-m2.5, as on Bedrock,
+// so a silent fallback would show up as that id.
+vi.mock("@cline/core", async (importOriginal) => {
+	const actual = await importOriginal<typeof import("@cline/core")>();
+	return {
+		...actual,
+		Llms: {
+			...actual.Llms,
+			getModelsForProvider: vi.fn(async () => ({
+				"minimax.minimax-m2.5": { name: "MiniMax M2.5" },
+				"us.anthropic.claude-sonnet-5": { name: "Claude Sonnet 5" },
+			})),
+			getProvider: vi.fn(async (id: string) => ({
+				id,
+				name: id,
+				defaultModelId: "minimax.minimax-m2.5",
+			})),
+		},
+	};
+});
+
+import { AcpAgent } from "./acpAgent";
+
+const FALLBACK = "minimax.minimax-m2.5";
+const MANTLE_ID = "aws-mantle/qwen.qwen3-coder-next";
+const UNROUTABLE_ID = "aws-mantle/"; // criteria k2.unroutableId
+const ARN =
+	"arn:aws:bedrock:us-west-2:123456789012:inference-profile/us.anthropic.claude-sonnet-4-5-20250929-v1:0";
+
+const conn = {
+	sessionUpdate: vi.fn(async () => {}),
+} as unknown as AgentSideConnection;
+
+type SessionView = { currentModelId: string };
+
+function sessionOf(agent: AcpAgent, id: string): SessionView {
+	return (
+		agent as unknown as { sessions: Map<string, SessionView> }
+	).sessions.get(id) as SessionView;
+}
+
+function modelOption(configOptions: unknown): {
+	currentValue?: string;
+	options?: Array<{ value: string }>;
+} {
+	return (configOptions as Array<{ id: string }>).find(
+		(o) => o.id === "model",
+	) as {
+		currentValue?: string;
+		options?: Array<{ value: string }>;
+	};
+}
+
+describe("ACP model pin fails loud (fork patch 0005)", () => {
+	const saved = { ...process.env };
+
+	beforeEach(() => {
+		process.env.CLINE_PROVIDER = "bedrock";
+		process.env.CLINE_API_KEY = "unused";
+		delete process.env.CLINE_MODEL;
+	});
+
+	afterEach(() => {
+		process.env = { ...saved };
+	});
+
+	it("keeps an aws-mantle/ id that is not in the catalog at session/new", async () => {
+		process.env.CLINE_MODEL = MANTLE_ID;
+		const created = await new AcpAgent(conn).newSession({
+			cwd: process.cwd(),
+			mcpServers: [],
+		});
+		expect(created.models?.currentModelId).toBe(MANTLE_ID);
+		const option = modelOption(created.configOptions);
+		expect(option.currentValue).toBe(MANTLE_ID);
+		expect(option.options?.map((o) => o.value)).toContain(MANTLE_ID);
+	});
+
+	it("keeps an inference-profile ARN at session/new", async () => {
+		process.env.CLINE_MODEL = ARN;
+		const created = await new AcpAgent(conn).newSession({
+			cwd: process.cwd(),
+			mcpServers: [],
+		});
+		expect(created.models?.currentModelId).toBe(ARN);
+	});
+
+	it("rejects an unroutable id at session/new with an error naming it", async () => {
+		process.env.CLINE_MODEL = UNROUTABLE_ID;
+		await expect(
+			new AcpAgent(conn).newSession({ cwd: process.cwd(), mcpServers: [] }),
+		).rejects.toMatchObject({
+			code: -32602,
+			message: expect.stringContaining(`"${UNROUTABLE_ID}"`),
+		});
+	});
+
+	it("never substitutes the provider default for a pinned id", async () => {
+		for (const id of [MANTLE_ID, ARN, "us.anthropic.claude-sonnet-5"]) {
+			process.env.CLINE_MODEL = id;
+			const created = await new AcpAgent(conn).newSession({
+				cwd: process.cwd(),
+				mcpServers: [],
+			});
+			expect(created.models?.currentModelId).toBe(id);
+			expect(created.models?.currentModelId).not.toBe(FALLBACK);
+		}
+	});
+
+	it("uses the provider default only when no model is pinned", async () => {
+		const created = await new AcpAgent(conn).newSession({
+			cwd: process.cwd(),
+			mcpServers: [],
+		});
+		expect(created.models?.currentModelId).toBe(FALLBACK);
+	});
+
+	it("accepts an aws-mantle/ id through session/set_config_option", async () => {
+		const agent = new AcpAgent(conn);
+		const created = await agent.newSession({
+			cwd: process.cwd(),
+			mcpServers: [],
+		});
+		await agent.setSessionConfigOption({
+			sessionId: created.sessionId,
+			configId: "model",
+			value: "aws-mantle/xai.grok-4.3",
+		});
+		expect(sessionOf(agent, created.sessionId).currentModelId).toBe(
+			"aws-mantle/xai.grok-4.3",
+		);
+	});
+
+	it("rejects an unroutable id through session/set_config_option and keeps the current model", async () => {
+		process.env.CLINE_MODEL = MANTLE_ID;
+		const agent = new AcpAgent(conn);
+		const created = await agent.newSession({
+			cwd: process.cwd(),
+			mcpServers: [],
+		});
+		await expect(
+			agent.setSessionConfigOption({
+				sessionId: created.sessionId,
+				configId: "model",
+				value: UNROUTABLE_ID,
+			}),
+		).rejects.toMatchObject({
+			code: -32602,
+			message: expect.stringContaining(`"${UNROUTABLE_ID}"`),
+		});
+		expect(sessionOf(agent, created.sessionId).currentModelId).toBe(MANTLE_ID);
+	});
+
+	it("rejects an unroutable id through session/set_model", async () => {
+		const agent = new AcpAgent(conn);
+		const created = await agent.newSession({
+			cwd: process.cwd(),
+			mcpServers: [],
+		});
+		await expect(
+			agent.unstable_setSessionModel({
+				sessionId: created.sessionId,
+				modelId: UNROUTABLE_ID,
+			}),
+		).rejects.toMatchObject({ code: -32602 });
+	});
+
+	it("rejects an unknown id for a closed-catalog provider, naming it", async () => {
+		process.env.CLINE_PROVIDER = "anthropic";
+		process.env.CLINE_MODEL = "claude-imaginary-9";
+		await expect(
+			new AcpAgent(conn).newSession({ cwd: process.cwd(), mcpServers: [] }),
+		).rejects.toMatchObject({
+			code: -32602,
+			message: expect.stringContaining('"claude-imaginary-9"'),
+		});
+	});
+});
