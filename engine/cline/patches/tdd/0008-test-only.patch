+import { mkdirSync, mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { AgentSideConnection } from "@agentclientprotocol/sdk";
+import type { AgentConfig } from "@cline/shared";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+// The runtime's own model factory, so the wire test covers providers.json ->
+// ACP config -> core provider config -> Bedrock vendor -> HTTP request.
+// @cline/core exports no entrypoint for it, so this test imports the source
+// file directly.
+// biome-ignore lint/style/noRestrictedImports: wire test drives the runtime model factory
+import { createAgentModelFromConfig } from "../../../../sdk/packages/core/src/services/llms/handler-factory";
+import type { Config } from "../utils/types";
+
+vi.mock("../runtime/prompt", () => ({
+	resolveSystemPrompt: vi.fn(async () => "PROMPT"),
+}));
+vi.mock("@cline/core", async (importOriginal) => {
+	const actual = await importOriginal<typeof import("@cline/core")>();
+	return {
+		...actual,
+		Llms: {
+			...actual.Llms,
+			getModelsForProvider: vi.fn(async () => ({
+				"us.anthropic.claude-sonnet-5": { name: "Claude Sonnet 5" },
+			})),
+			getProvider: vi.fn(async (id: string) => ({
+				id,
+				name: id,
+				defaultModelId: "us.anthropic.claude-sonnet-5",
+			})),
+		},
+	};
+});
+
+import { AcpAgent } from "./acpAgent";
+
+const CONVERSE_MODEL = "us.anthropic.claude-sonnet-5";
+const MANTLE_MODEL = "aws-mantle/qwen.qwen3-coder-next";
+
+type Internals = {
+	sessions: Map<string, unknown>;
+	buildConfig(session: unknown): Promise<Config>;
+};
+
+interface Captured {
+	url: string;
+	body: Record<string, unknown>;
+}
+
+const conn = {
+	sessionUpdate: vi.fn(async () => {}),
+} as unknown as AgentSideConnection;
+
+function writeProviders(
+	dir: string,
+	model: string,
+	settings: Record<string, unknown>,
+): string {
+	const settingsDir = join(dir, "settings");
+	mkdirSync(settingsDir, { recursive: true });
+	const path = join(settingsDir, "providers.json");
+	writeFileSync(
+		path,
+		JSON.stringify({
+			version: 1,
+			lastUsedProvider: "bedrock",
+			modes: {},
+			providers: {
+				bedrock: {
+					settings: {
+						provider: "bedrock",
+						model,
+						aws: { region: "us-west-2", authentication: "iam" },
+						...settings,
+					},
+					updatedAt: "2026-09-27T00:00:00.000Z",
+					tokenSource: "manual",
+				},
+			},
+		}),
+	);
+	return path;
+}
+
+function bodyText(body: unknown): string {
+	if (typeof body === "string") return body;
+	if (body instanceof Uint8Array) return new TextDecoder().decode(body);
+	if (body instanceof ArrayBuffer) return new TextDecoder().decode(body);
+	return "{}";
+}
+
+/** The first model request an ACP session built from providers.json sends. */
+async function firstModelRequest(): Promise<Captured> {
+	const seen: Captured[] = [];
+	vi.stubGlobal(
+		"fetch",
+		vi.fn(async (input: unknown, init?: RequestInit) => {
+			const url =
+				typeof input === "string"
+					? input
+					: input instanceof URL
+						? input.href
+						: (input as Request).url;
+			seen.push({ url, body: JSON.parse(bodyText(init?.body)) });
+			return new Response(JSON.stringify({ message: "captured" }), {
+				status: 400,
+				headers: { "content-type": "application/json" },
+			});
+		}),
+	);
+	const agent = new AcpAgent(conn);
+	const created = await agent.newSession({
+		cwd: process.cwd(),
+		mcpServers: [],
+	});
+	const inner = agent as unknown as Internals;
+	const config = await inner.buildConfig(inner.sessions.get(created.sessionId));
+	const model = createAgentModelFromConfig(
+		{ ...config, tools: [] } as unknown as AgentConfig,
+		undefined,
+	);
+	try {
+		const stream = await model.stream({
+			systemPrompt: "PROMPT",
+			messages: [
+				{
+					id: "u1",
+					role: "user",
+					content: [{ type: "text", text: "hi" }],
+					createdAt: 1,
+				},
+			],
+			tools: [],
+		});
+		for await (const _event of stream) {
+			// Drain so the request is sent.
+		}
+	} catch {
+		// The stubbed 400 ends the stream after capture.
+	}
+	const first = seen[0];
+	if (!first) {
+		throw new Error("no model request was sent");
+	}
+	return first;
+}
+
+// Fork patch 0009: under ACP, providers.json `maxTokens` is the output cap of
+// every model request (it was dropped for an unset per-turn cap).
+describe("ACP honors providers.json maxTokens", () => {
+	const saved = { ...process.env };
+	let dir: string;
+
+	beforeEach(() => {
+		dir = mkdtempSync(join(tmpdir(), "acp-max-tokens-"));
+		process.env = { ...saved };
+		process.env.HOME = join(dir, "home");
+		process.env.CLINE_DATA_DIR = join(dir, "data");
+		process.env.CLINE_PROVIDER = "bedrock";
+		process.env.CLINE_API_KEY = "unused";
+		process.env.AWS_ACCESS_KEY_ID = "ASIA-test-0009";
+		process.env.AWS_SECRET_ACCESS_KEY = "role-secret-0009";
+		process.env.AWS_SESSION_TOKEN = "role-session-token-0009";
+		process.env.AWS_REGION = "us-west-2";
+		process.env.AWS_CONFIG_FILE = join(dir, "no-aws-config");
+		process.env.AWS_SHARED_CREDENTIALS_FILE = join(dir, "no-aws-credentials");
+		process.env.AWS_EC2_METADATA_DISABLED = "true";
+		delete process.env.AWS_PROFILE;
+		delete process.env.AWS_BEARER_TOKEN_BEDROCK;
+	});
+
+	afterEach(() => {
+		process.env = { ...saved };
+		vi.unstubAllGlobals();
+	});
+
+	it("sends maxTokens as the Converse inferenceConfig.maxTokens", async () => {
+		process.env.CLINE_MODEL = CONVERSE_MODEL;
+		process.env.CLINE_PROVIDER_SETTINGS_PATH = writeProviders(
+			dir,
+			CONVERSE_MODEL,
+			{ maxTokens: 4321 },
+		);
+		const request = await firstModelRequest();
+		expect(request.url).toContain("bedrock-runtime.us-west-2.amazonaws.com");
+		expect(
+			(request.body.inferenceConfig as { maxTokens?: number } | undefined)
+				?.maxTokens,
+		).toBe(4321);
+	});
+
+	it("sends maxTokens as max_tokens on a Mantle chat route", async () => {
+		process.env.CLINE_MODEL = MANTLE_MODEL;
+		process.env.CLINE_PROVIDER_SETTINGS_PATH = writeProviders(
+			dir,
+			MANTLE_MODEL,
+			{ maxTokens: 2345 },
+		);
+		const request = await firstModelRequest();
+		expect(request.url).toContain("bedrock-mantle.us-west-2.api.aws");
+		expect(request.body.max_tokens).toBe(2345);
+	});
+});
