+import type { AgentSideConnection } from "@agentclientprotocol/sdk";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Config } from "../utils/types";
+
+const mocks = vi.hoisted(() => ({
+	createCliCore: vi.fn(async () => ({
+		start: vi.fn(async () => ({ sessionId: "core-session" })),
+		readMessages: vi.fn(async () => []),
+		dispose: vi.fn(async () => {}),
+	})),
+}));
+
+vi.mock("../session/session", () => ({ createCliCore: mocks.createCliCore }));
+vi.mock("../runtime/session-events", () => ({
+	subscribeToAgentEvents: () => () => {},
+}));
+vi.mock("../runtime/prompt", () => ({
+	resolveSystemPrompt: vi.fn(async () => "PROMPT"),
+}));
+vi.mock("@cline/core", async (importOriginal) => {
+	const actual = await importOriginal<typeof import("@cline/core")>();
+	return {
+		...actual,
+		Llms: {
+			...actual.Llms,
+			getModelsForProvider: vi.fn(async () => ({
+				"us.anthropic.claude-sonnet-5": { name: "Claude Sonnet 5" },
+			})),
+			getProvider: vi.fn(async (id: string) => ({
+				id,
+				name: id,
+				defaultModelId: "us.anthropic.claude-sonnet-5",
+			})),
+		},
+	};
+});
+
+import { AcpAgent } from "./acpAgent";
+
+type AgentInternals = {
+	sessions: Map<string, unknown>;
+	ensureSessionManager(
+		session: unknown,
+		acpSessionId: string,
+	): Promise<unknown>;
+	buildConfig(session: unknown): Promise<Config>;
+};
+
+const conn = {
+	sessionUpdate: vi.fn(async () => {}),
+} as unknown as AgentSideConnection;
+
+async function startSession(agent: AcpAgent): Promise<{ config: Config }> {
+	const inner = agent as unknown as AgentInternals;
+	const created = await agent.newSession({
+		cwd: process.cwd(),
+		mcpServers: [],
+	});
+	const session = inner.sessions.get(created.sessionId);
+	await inner.ensureSessionManager(session, created.sessionId);
+	return { config: await inner.buildConfig(session) };
+}
+
+// Fork patch 0006: with a data dir, ACP runs the local backend (no hub daemon).
+describe("ACP backend selection", () => {
+	const saved = { ...process.env };
+
+	beforeEach(() => {
+		process.env.CLINE_PROVIDER = "bedrock";
+		process.env.CLINE_MODEL = "us.anthropic.claude-sonnet-5";
+		process.env.CLINE_API_KEY = "unused";
+		mocks.createCliCore.mockClear();
+	});
+
+	afterEach(() => {
+		process.env = { ...saved };
+	});
+
+	it("forces the local backend and sandbox config when ACP runs sandboxed", async () => {
+		const { config } = await startSession(
+			new AcpAgent(conn, { localBackend: true }),
+		);
+		expect(mocks.createCliCore).toHaveBeenCalledWith(
+			expect.objectContaining({ forceLocalBackend: true }),
+		);
+		expect(config.sandbox).toBe(true);
+	});
+
+	it("keeps the default backend when ACP is not sandboxed", async () => {
+		const { config } = await startSession(new AcpAgent(conn));
+		const options = (
+			mocks.createCliCore.mock.calls[0] as unknown[] | undefined
+		)?.[0] as { forceLocalBackend?: boolean } | undefined;
+		expect(options?.forceLocalBackend).not.toBe(true);
+		expect(config.sandbox).toBe(false);
+	});
+
+	// The rebase onto cli-v3.0.71 met this patch's `localBackend` option with upstream's
+	// `reasoning` option (--thinking now applies under ACP): both must reach the session config.
+	it("applies --thinking together with the local backend", async () => {
+		const { config } = await startSession(
+			new AcpAgent(conn, {
+				localBackend: true,
+				reasoning: { thinking: true, reasoningEffort: "high" },
+			}),
+		);
+		expect(config.sandbox).toBe(true);
+		expect(config.thinking).toBe(true);
+		expect(config.reasoningEffort).toBe("high");
+	});
+
+	it("keeps reasoning off under the local backend when --thinking is not given", async () => {
+		const { config } = await startSession(
+			new AcpAgent(conn, { localBackend: true }),
+		);
+		expect(config.sandbox).toBe(true);
+		expect(config.thinking).toBe(false);
+		expect(config.reasoningEffort).toBeUndefined();
+	});
+});
