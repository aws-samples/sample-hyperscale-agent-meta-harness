+import { mkdtempSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { AgentSideConnection } from "@agentclientprotocol/sdk";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+const mocks = vi.hoisted(() => ({
+	core: undefined as unknown,
+	listener: undefined as ((event: unknown) => void) | undefined,
+}));
+
+vi.mock("../session/session", () => ({
+	createCliCore: vi.fn(async () => mocks.core),
+}));
+vi.mock("../runtime/session-events", () => ({
+	subscribeToAgentEvents: (_core: unknown, listener: (event: unknown) => void) => {
+		mocks.listener = listener;
+		return () => {};
+	},
+}));
+vi.mock("../runtime/prompt", () => ({
+	resolveSystemPrompt: vi.fn(async () => "PROMPT"),
+}));
+vi.mock("@cline/core", async (importOriginal) => {
+	const actual = await importOriginal<typeof import("@cline/core")>();
+	return {
+		...actual,
+		Llms: {
+			...actual.Llms,
+			getModelsForProvider: vi.fn(async () => ({
+				"us.anthropic.claude-sonnet-5": { name: "Claude Sonnet 5" },
+			})),
+			getProvider: vi.fn(async (id: string) => ({
+				id,
+				name: id,
+				defaultModelId: "us.anthropic.claude-sonnet-5",
+			})),
+		},
+	};
+});
+
+import { AcpAgent } from "./acpAgent";
+
+// Harness patch 0011: a failed turn ends session/prompt with the JSON-RPC error whose `data` carries
+// the structure of the provider failure (AWS exception name, HTTP status, retryability, retry-after,
+// attempts) next to the unchanged `message`. Before the patch `data` was `{message}` only, so the
+// cline-agentcore-harness failover classifier had nothing to read (evidence
+// 2026-09-30-engine-fault-probe.md, "ACP error shape").
+
+const conn = {
+	sessionUpdate: vi.fn(async () => {}),
+} as unknown as AgentSideConnection;
+
+/** A core whose send() reports `event` as the run's terminal error and resolves with an error finish. */
+function coreFailingWith(event: Record<string, unknown>) {
+	return {
+		start: vi.fn(async () => ({ sessionId: "core-session" })),
+		readMessages: vi.fn(async () => []),
+		dispose: vi.fn(async () => {}),
+		abort: vi.fn(async () => {}),
+		getAccumulatedUsage: vi.fn(async () => undefined),
+		send: vi.fn(async () => {
+			mocks.listener?.({ recoverable: false, iteration: 1, ...event });
+			return {
+				text: "",
+				usage: { inputTokens: 0, outputTokens: 0 },
+				messages: [],
+				toolCalls: [],
+				iterations: 1,
+				finishReason: "error",
+				model: { id: "us.anthropic.claude-sonnet-5", provider: "bedrock" },
+				startedAt: new Date(0),
+				endedAt: new Date(0),
+				durationMs: 0,
+			};
+		}),
+	};
+}
+
+async function promptError(event: Record<string, unknown>) {
+	mocks.core = coreFailingWith(event);
+	const agent = new AcpAgent(conn);
+	const created = await agent.newSession({ cwd: process.cwd(), mcpServers: [] });
+	try {
+		await agent.prompt({
+			sessionId: created.sessionId,
+			prompt: [{ type: "text", text: "go" }],
+		});
+	} catch (error) {
+		return error as { code: number; message: string; data: unknown };
+	}
+	throw new Error("prompt did not fail");
+}
+
+describe("ACP prompt error data", () => {
+	const saved = { ...process.env };
+
+	beforeEach(() => {
+		const dir = mkdtempSync(join(tmpdir(), "acp-error-data-"));
+		process.env = { ...saved };
+		process.env.HOME = join(dir, "home");
+		process.env.CLINE_DATA_DIR = join(dir, "data");
+		process.env.CLINE_PROVIDER = "bedrock";
+		process.env.CLINE_MODEL = "us.anthropic.claude-sonnet-5";
+		process.env.CLINE_API_KEY = "unused";
+		mocks.listener = undefined;
+	});
+
+	afterEach(() => {
+		process.env = { ...saved };
+	});
+
+	it("carries the AWS exception name, status, retryability and attempts of an exhausted 503", async () => {
+		const text = "The service isn't currently available. Retry your request.";
+		const error = await promptError({
+			type: "error",
+			error: new Error(text),
+			errorClass: "unknown",
+			errorDetails: {
+				errorName: "ServiceUnavailableException",
+				statusCode: 503,
+				isRetryable: true,
+				attempts: 6,
+			},
+		});
+		expect(error.code).toBe(-32603);
+		expect(error.message).toBe(`Internal error: ${text}`);
+		expect(error.data).toEqual({
+			message: text,
+			errorName: "ServiceUnavailableException",
+			statusCode: 503,
+			isRetryable: true,
+			attempts: 6,
+		});
+	});
+
+	it("carries retry-after seconds and the network code of a connection failure", async () => {
+		const throttled = await promptError({
+			type: "error",
+			error: new Error("Too many requests, please wait before trying again."),
+			errorDetails: {
+				errorName: "ThrottlingException",
+				statusCode: 429,
+				isRetryable: true,
+				retryAfterS: 5,
+				attempts: 6,
+			},
+		});
+		expect(throttled.data).toMatchObject({
+			errorName: "ThrottlingException",
+			statusCode: 429,
+			retryAfterS: 5,
+		});
+		const reset = await promptError({
+			type: "error",
+			error: new Error("Cannot connect to API: read ECONNRESET"),
+			errorDetails: { code: "ECONNRESET", isRetryable: true, attempts: 6 },
+		});
+		expect(reset.data).toEqual({
+			message: "Cannot connect to API: read ECONNRESET",
+			code: "ECONNRESET",
+			isRetryable: true,
+			attempts: 6,
+		});
+	});
+
+	it("names a context-window stop reason and its class", async () => {
+		const error = await promptError({
+			type: "error",
+			error: new Error(
+				"The conversation still exceeds the model's context window after compacting it.",
+			),
+			errorClass: "context_window_exceeded",
+			errorDetails: {
+				errorName: "ModelContextWindowExceeded",
+				stopReason: "model_context_window_exceeded",
+				isRetryable: false,
+			},
+		});
+		expect(error.code).toBe(-32603);
+		expect(error.data).toEqual({
+			message:
+				"The conversation still exceeds the model's context window after compacting it.",
+			errorName: "ModelContextWindowExceeded",
+			stopReason: "model_context_window_exceeded",
+			isRetryable: false,
+			errorClass: "context_window_exceeded",
+		});
+	});
+
+	it("keeps data to the message when the failure has no structure", async () => {
+		const error = await promptError({
+			type: "error",
+			error: new Error("upstream failed"),
+			errorClass: "unknown",
+		});
+		expect(error.code).toBe(-32603);
+		expect(error.data).toEqual({ message: "upstream failed" });
+	});
+
+	it("puts the status of an authentication failure in the auth-required error too", async () => {
+		const error = await promptError({
+			type: "error",
+			error: new Error("Invalid API key (401 Unauthorized)"),
+			errorClass: "auth",
+			errorDetails: {
+				errorName: "AccessDeniedException",
+				statusCode: 403,
+				isRetryable: false,
+			},
+		});
+		expect(error.code).toBe(-32000);
+		expect(error.data).toMatchObject({
+			errorName: "AccessDeniedException",
+			statusCode: 403,
+			isRetryable: false,
+			errorClass: "auth",
+		});
+	});
+});
diff --git a/sdk/packages/agents/src/agent-runtime.error-details.test.ts b/sdk/packages/agents/src/agent-runtime.error-details.test.ts
new file mode 100644
index 0000000..42ae70d
--- /dev/null
+++ b/sdk/packages/agents/src/agent-runtime.error-details.test.ts
@@ -0,0 +1,246 @@
+import type {
+	AgentModel,
+	AgentModelEvent,
+	AgentModelRequest,
+	AgentRuntimeEvent,
+} from "@cline/shared";
+import { describe, expect, it, vi } from "vitest";
+import { AgentRuntime } from "./index";
+
+// Harness patch 0011: the run-failed event carries the structure of the provider failure that ended
+// the run (AWS exception name, HTTP status, retryability, attempts), whether the failure came in on
+// the model's finish event or was thrown from the prepareTurn pipeline (the compaction summary call).
+
+class ScriptedModel implements AgentModel {
+	public readonly requests: AgentModelRequest[] = [];
+
+	constructor(
+		private readonly steps: Array<
+			(request: AgentModelRequest) => Iterable<AgentModelEvent>
+		>,
+	) {}
+
+	async stream(
+		request: AgentModelRequest,
+	): Promise<AsyncIterable<AgentModelEvent>> {
+		this.requests.push(request);
+		const step = this.steps.shift();
+		if (!step) {
+			throw new Error("No scripted model step available");
+		}
+		const events = step(request);
+		return (async function* () {
+			for (const event of events) {
+				yield event;
+			}
+		})();
+	}
+}
+
+type RunFailed = Extract<AgentRuntimeEvent, { type: "run-failed" }>;
+
+async function runFailed(
+	runtime: AgentRuntime,
+	prompt = "Hi",
+): Promise<RunFailed> {
+	const seen: RunFailed[] = [];
+	runtime.subscribe((event) => {
+		if (event.type === "run-failed") {
+			seen.push(event);
+		}
+	});
+	const result = await runtime.run(prompt);
+	expect(result.status).toBe("failed");
+	expect(seen).toHaveLength(1);
+	return seen[0] as RunFailed;
+}
+
+const SERVICE_DOWN = {
+	errorName: "ServiceUnavailableException",
+	statusCode: 503,
+	isRetryable: true,
+	attempts: 6,
+};
+
+describe("run-failed error details", () => {
+	it("carries the details of the finish event that ended the run", async () => {
+		const model = new ScriptedModel([
+			() => [
+				{
+					type: "finish",
+					reason: "error",
+					error: "The service isn't currently available. Retry your request.",
+					errorClass: "unknown",
+					errorRetryable: false,
+					errorDetails: SERVICE_DOWN,
+				},
+			],
+		]);
+		const event = await runFailed(new AgentRuntime({ model }));
+		expect(event.error.message).toBe(
+			"The service isn't currently available. Retry your request.",
+		);
+		expect(event.errorDetails).toEqual(SERVICE_DOWN);
+	});
+
+	it("describes an error thrown from prepareTurn, the compaction summary call, by its own structure", async () => {
+		// The AI SDK's error shapes by their fields: the agents package does not depend on `ai`.
+		const last = Object.assign(
+			new Error("The service isn't currently available. Retry your request."),
+			{
+				name: "AI_APICallError",
+				statusCode: 503,
+				responseHeaders: {
+					"x-amzn-errortype": "ServiceUnavailableException:http://x/",
+				},
+				isRetryable: true,
+			},
+		);
+		const thrown = Object.assign(
+			new Error(`Failed after 3 attempts. Last error: ${last.message}`),
+			{
+				name: "AI_RetryError",
+				reason: "maxRetriesExceeded",
+				errors: [last, last, last],
+				lastError: last,
+			},
+		);
+		const model = new ScriptedModel([
+			() => [
+				{ type: "text-delta", text: "never reached" },
+				{ type: "finish", reason: "stop" },
+			],
+		]);
+		const prepareTurn = vi.fn(async () => {
+			throw thrown;
+		});
+		const event = await runFailed(new AgentRuntime({ model, prepareTurn }));
+		expect(model.requests).toHaveLength(0);
+		expect(event.errorDetails).toEqual({
+			errorName: "ServiceUnavailableException",
+			statusCode: 503,
+			isRetryable: true,
+			attempts: 3,
+			phase: "compaction",
+		});
+	});
+
+	it("ends the turn at a context-window stop reason without replaying it", async () => {
+		const details = {
+			errorName: "ModelContextWindowExceeded",
+			stopReason: "model_context_window_exceeded",
+			isRetryable: false,
+			phase: "stop" as const,
+		};
+		const model = new ScriptedModel([
+			() => [
+				{ type: "text-delta", text: "partial answer" },
+				{
+					type: "finish",
+					reason: "error",
+					error:
+						"Model reached the context window limit before completing the turn",
+					errorClass: "context_window_exceeded",
+					errorRetryable: false,
+					errorDetails: details,
+				},
+			],
+		]);
+		const prepareTurn = vi.fn(async () => undefined);
+		const event = await runFailed(new AgentRuntime({ model, prepareTurn }));
+		// One request, one ordinary prepareTurn: no forced compaction, no retry.
+		expect(model.requests).toHaveLength(1);
+		expect(prepareTurn).toHaveBeenCalledTimes(1);
+		expect(event.errorClass).toBe("context_window_exceeded");
+		expect(event.errorDetails).toEqual(details);
+	});
+
+	it("describes a summary-call failure by the details it carries, as a compaction failure", async () => {
+		// The compaction summary call goes through the legacy stream API, which flattens the failure to a
+		// message; the summariser rethrows it as an Error that carries the details of the finish event.
+		const thrown = Object.assign(
+			new Error("The service isn't currently available. Retry your request."),
+			{
+				errorDetails: {
+					errorName: "ServiceUnavailableException",
+					statusCode: 503,
+					isRetryable: true,
+					attempts: 6,
+					phase: "request" as const,
+				},
+			},
+		);
+		const model = new ScriptedModel([
+			() => [{ type: "finish", reason: "stop" }],
+		]);
+		const prepareTurn = vi.fn(async () => {
+			throw thrown;
+		});
+		const event = await runFailed(new AgentRuntime({ model, prepareTurn }));
+		expect(model.requests).toHaveLength(0);
+		expect(event.errorDetails).toEqual({
+			errorName: "ServiceUnavailableException",
+			statusCode: 503,
+			isRetryable: true,
+			attempts: 6,
+			phase: "compaction",
+		});
+	});
+
+	it("keeps the rejection's details when a window overflow cannot be compacted", async () => {
+		const details = {
+			errorName: "ValidationException",
+			statusCode: 400,
+			isRetryable: false,
+			phase: "request" as const,
+		};
+		const model = new ScriptedModel([
+			() => [
+				{
+					type: "finish",
+					reason: "error",
+					error: "Input is too long for requested model.",
+					errorClass: "context_window_exceeded",
+					errorRetryable: false,
+					errorDetails: details,
+				},
+			],
+		]);
+		// prepareTurn never shrinks the transcript: nothing to compact.
+		const prepareTurn = vi.fn(async () => undefined);
+		const event = await runFailed(new AgentRuntime({ model, prepareTurn }));
+		expect(prepareTurn).toHaveBeenCalledTimes(2);
+		expect(event.error.name).toBe("ContextWindowOverflowError");
+		expect(event.errorClass).toBe("context_window_exceeded");
+		expect(event.errorDetails).toEqual(details);
+	});
+
+	it("never attaches the details of an earlier failed attempt to a different error", async () => {
+		const model = new ScriptedModel([
+			() => [
+				{
+					type: "finish",
+					reason: "error",
+					error: "Cannot connect to API: read ECONNRESET",
+					errorClass: "unknown",
+					errorRetryable: true,
+					errorDetails: { code: "ECONNRESET", isRetryable: true },
+				},
+			],
+			() => [{ type: "finish", reason: "stop" }],
+		]);
+		const event = await runFailed(new AgentRuntime({ model }));
+		expect(model.requests).toHaveLength(2);
+		expect(event.error.message).toBe("Model returned empty response");
+		expect(event.errorDetails).toBeUndefined();
+	});
+
+	it("reports no details for an error that has no structure", async () => {
+		const model = new ScriptedModel([
+			() => [{ type: "finish", reason: "error", error: "upstream failed" }],
+		]);
+		const event = await runFailed(new AgentRuntime({ model }));
+		expect(event.error.message).toBe("upstream failed");
+		expect(event.errorDetails).toBeUndefined();
+	});
+});
