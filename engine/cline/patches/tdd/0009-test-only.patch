@@ -0,0 +1,176 @@
+import type { AgentMessage, AgentModelEvent } from "@cline/shared";
+import { APICallError, RetryError } from "ai";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { createGateway } from "./gateway";
+
+// Harness patch 0011: the model boundary keeps the structure of a provider failure on the `finish`
+// event (`errorDetails`) and reports Bedrock's stopReason model_context_window_exceeded as an error
+// instead of a clean stop. Shapes are the ones the pinned fork saw against a local fake Bedrock.
+
+const streamTextSpy = vi.fn();
+
+vi.mock("ai", async (importOriginal) => {
+	const actual = await importOriginal<typeof import("ai")>();
+	return {
+		...actual,
+		streamText: (input: unknown) => streamTextSpy(input),
+	};
+});
+
+vi.mock("@ai-sdk/openai", () => ({
+	createOpenAI: () => ({
+		responses: (modelId: string) => ({ modelId, family: "openai" }),
+	}),
+}));
+
+async function* parts(items: unknown[]) {
+	for (const item of items) {
+		yield item;
+	}
+}
+
+async function collect(
+	iterable: AsyncIterable<AgentModelEvent>,
+): Promise<AgentModelEvent[]> {
+	const events: AgentModelEvent[] = [];
+	for await (const event of iterable) {
+		events.push(event);
+	}
+	return events;
+}
+
+const messages: AgentMessage[] = [
+	{
+		id: "user_1",
+		role: "user",
+		content: [{ type: "text", text: "Hello" }],
+		createdAt: Date.now(),
+	},
+];
+
+async function run(streamParts: unknown[]): Promise<AgentModelEvent[]> {
+	streamTextSpy.mockReturnValue({ fullStream: parts(streamParts) });
+	const gateway = createGateway({
+		providerConfigs: [{ providerId: "openai-native", apiKey: "test" }],
+	});
+	return await collect(
+		await gateway.stream({
+			providerId: "openai-native",
+			modelId: "gpt-5-mini",
+			messages,
+		}),
+	);
+}
+
+beforeEach(() => {
+	streamTextSpy.mockReset();
+});
+
+describe("finish event error details", () => {
+	it("carries the AWS exception name, status and attempts of an exhausted request-start retry", async () => {
+		const last = new APICallError({
+			message: "The service isn't currently available. Retry your request.",
+			url: "https://bedrock-runtime.us-east-1.amazonaws.com/model/m/converse-stream",
+			requestBodyValues: {},
+			statusCode: 503,
+			responseHeaders: {
+				"x-amzn-errortype":
+					"ServiceUnavailableException:http://internal.amazon.com/coral/com.amazon.bedrock/",
+			},
+			isRetryable: true,
+		});
+		const error = new RetryError({
+			message: `Failed after 6 attempts. Last error: ${last.message}`,
+			reason: "maxRetriesExceeded",
+			errors: [1, 2, 3, 4, 5].map(() => last).concat(last),
+		});
+		const events = await run([{ type: "error", error }]);
+		expect(events.at(-1)).toMatchObject({
+			type: "finish",
+			reason: "error",
+			error: "The service isn't currently available. Retry your request.",
+			// The turn-level retry stays off: the SDK already spent its retries.
+			errorRetryable: false,
+			errorDetails: {
+				errorName: "ServiceUnavailableException",
+				statusCode: 503,
+				isRetryable: true,
+				attempts: 6,
+				phase: "request",
+			},
+		});
+	});
+
+	it("marks a failure after visible output as a stream failure", async () => {
+		const error = Object.assign(
+			new Error("stream failed after the first chunk"),
+			{
+				statusCode: 503,
+				isRetryable: true,
+			},
+		);
+		const events = await run([
+			{ type: "text-delta", text: "partial answer" },
+			{ type: "error", error },
+		]);
+		expect(events.at(-1)).toMatchObject({
+			type: "finish",
+			reason: "error",
+			errorDetails: { statusCode: 503, phase: "stream" },
+		});
+	});
+
+	it("carries no details for a failure with no structure", async () => {
+		const events = await run([
+			{ type: "error", error: new Error("Invalid API key") },
+		]);
+		const finish = events.at(-1) as Record<string, unknown>;
+		expect(finish).toMatchObject({ reason: "error", error: "Invalid API key" });
+		expect(finish.errorDetails).toBeUndefined();
+	});
+});
+
+describe("stopReason model_context_window_exceeded", () => {
+	it("ends the turn as a context-window error instead of a clean stop", async () => {
+		const events = await run([
+			{ type: "text-delta", text: "partial answer" },
+			{
+				type: "finish",
+				finishReason: "other",
+				rawFinishReason: "model_context_window_exceeded",
+				usage: { inputTokens: 1_000_000, outputTokens: 4 },
+			},
+		]);
+		expect(events.at(-1)).toEqual({
+			type: "finish",
+			reason: "error",
+			error:
+				"Model reached the context window limit before completing the turn",
+			errorClass: "context_window_exceeded",
+			errorRetryable: false,
+			errorDetails: {
+				errorName: "ModelContextWindowExceeded",
+				stopReason: "model_context_window_exceeded",
+				isRetryable: false,
+				phase: "stop",
+			},
+		});
+	});
+
+	it("leaves an ordinary end_turn finish alone", async () => {
+		const events = await run([
+			{ type: "text-delta", text: "done" },
+			{
+				type: "finish",
+				finishReason: "stop",
+				rawFinishReason: "end_turn",
+				usage: { inputTokens: 10, outputTokens: 1 },
+			},
+		]);
+		const finish = events.at(-1) as Record<string, unknown>;
+		expect(finish.type).toBe("finish");
+		expect(finish.reason).toBe("stop");
+		expect(finish.error).toBeUndefined();
+		expect(finish.errorDetails).toBeUndefined();
+	});
+});
diff --git a/sdk/packages/llms/src/providers/bedrock-exception-frames.test.ts b/sdk/packages/llms/src/providers/bedrock-exception-frames.test.ts
new file mode 100644
index 0000000..ab2d5d2
--- /dev/null
+++ b/sdk/packages/llms/src/providers/bedrock-exception-frames.test.ts
@@ -0,0 +1,136 @@
+import { crc32 } from "node:zlib";
+import { createAmazonBedrock } from "@ai-sdk/amazon-bedrock";
+import { describe, expect, it } from "vitest";
+import { describeProviderError } from "./error-classification";
+
+// Harness patch 0011: a ConverseStream exception frame (an exception inside an HTTP 200) must reach
+// describeProviderError with its exception type. @ai-sdk/amazon-bedrock 5.0.62 dropped it, so the
+// series carried a bun patch of that package that kept it as `__type`. From 5.0.98 (cli-v3.0.71) the
+// provider's own error part carries `type` (lower camel: "throttlingException"), `statusCode` and
+// `isRetryable`, so the bun patch is gone and describeProviderError reads `type` and names the
+// exception in the AWS form ("ThrottlingException"). This test fails if a provider upgrade drops either.
+
+function frame(headers: Record<string, string>, payload: string): Uint8Array {
+	const enc = new TextEncoder();
+	const headerBytes: number[] = [];
+	for (const [name, value] of Object.entries(headers)) {
+		const n = enc.encode(name);
+		const v = enc.encode(value);
+		headerBytes.push(n.length, ...n, 7, v.length >> 8, v.length & 255, ...v);
+	}
+	const body = enc.encode(payload);
+	const total = 12 + headerBytes.length + body.length + 4;
+	const out = new Uint8Array(total);
+	const view = new DataView(out.buffer);
+	view.setUint32(0, total);
+	view.setUint32(4, headerBytes.length);
+	view.setUint32(8, crc32(out.subarray(0, 8)));
+	out.set(headerBytes, 12);
+	out.set(body, 12 + headerBytes.length);
+	view.setUint32(total - 4, crc32(out.subarray(0, total - 4)));
+	return out;
+}
+
+function exceptionFrame(type: string, message: string): Uint8Array {
+	return frame(
+		{
+			":message-type": "exception",
+			":exception-type": type,
+			":content-type": "application/json",
+		},
+		JSON.stringify({ message }),
+	);
+}
+
+async function firstErrorPart(type: string, message: string): Promise<unknown> {
+	const body = exceptionFrame(type, message);
+	const fetchStub = (async () =>
+		new Response(
+			new ReadableStream({
+				start(controller) {
+					controller.enqueue(body);
+					controller.close();
+				},
+			}),
+			{
+				status: 200,
+				headers: { "content-type": "application/vnd.amazon.eventstream" },
+			},
+		)) as unknown as typeof fetch;
+	const provider = createAmazonBedrock({
+		region: "us-east-1",
+		apiKey: "unused",
+		fetch: fetchStub,
+	});
+	const model = provider.languageModel("us.anthropic.claude-sonnet-5");
+	const { stream } = await model.doStream({
+		prompt: [{ role: "user", content: [{ type: "text", text: "hi" }] }],
+	});
+	const reader = stream.getReader();
+	for (;;) {
+		const { done, value } = await reader.read();
+		if (done) {
+			throw new Error("the stream ended without an error part");
+		}
+		if ((value as { type: string }).type === "error") {
+			return (value as { error: unknown }).error;
+		}
+	}
+}
+
+describe("Bedrock stream exception frames keep their exception type", () => {
+	const cases: Array<[string, string, number, boolean]> = [
+		["throttlingException", "ThrottlingException", 429, true],
+		["serviceUnavailableException", "ServiceUnavailableException", 503, true],
+		["internalServerException", "InternalServerException", 500, true],
+		["modelStreamErrorException", "ModelStreamErrorException", 424, true],
+		["validationException", "ValidationException", 400, false],
+	];
+	for (const [frameType, name, status, retryable] of cases) {
+		it(`names a ${frameType} frame ${name}`, async () => {
+			const error = await firstErrorPart(frameType, "stream failed");
+			expect(error).toMatchObject({
+				message: "stream failed",
+				type: frameType,
+				statusCode: status,
+				isRetryable: retryable,
+			});
+			// The status is the provider's mapping of the exception type (the frame sits in an HTTP 200).
+			expect(describeProviderError(error)).toEqual({
+				errorName: name,
+				statusCode: status,
+				isRetryable: retryable,
+			});
+		});
+	}
+});
+
+describe("describeProviderError on a bare stream error part", () => {
+	it("names a lower camel exception type and judges it transient without a status", () => {
+		expect(
+			describeProviderError({
+				message: "slow down",
+				type: "throttlingException",
+			}),
+		).toEqual({ errorName: "ThrottlingException", isRetryable: true });
+	});
+
+	it("keeps an unknown Exception type's name and does not call it transient", () => {
+		expect(
+			describeProviderError({ message: "no", type: "accessDeniedException" }),
+		).toEqual({ errorName: "AccessDeniedException", isRetryable: false });
+	});
+
+	it("does not take a type that is not an AWS exception name for one", () => {
+		for (const type of [
+			"error",
+			"invalid_request_error",
+			"overloaded_error",
+			7,
+		]) {
+			expect(describeProviderError({ message: "x", type })).toEqual({
+				isRetryable: false,
+			});
+		}
+	});
+});
diff --git a/sdk/packages/llms/src/providers/error-details.test.ts b/sdk/packages/llms/src/providers/error-details.test.ts
new file mode 100644
index 0000000..9eff66f
--- /dev/null
+++ b/sdk/packages/llms/src/providers/error-details.test.ts
@@ -0,0 +1,357 @@
+import { APICallError, RetryError } from "ai";
+import { describe, expect, it } from "vitest";
+import { describeProviderError } from "./error-classification";
+import { extractErrorMessage } from "./format";
+
+// Harness patch 0011: the structure of a provider failure (AWS exception name, HTTP status,
+// retryability, retry-after, attempts) survives to the ACP error data, so the cline-agentcore-harness
+// failover classifier reads fields instead of guessing from message text. Shapes are the ones the
+// pinned fork raised against a local fake Bedrock (evidence 2026-09-30-engine-fault-probe.md).
+
+const ARN_SUFFIX = ":http://internal.amazon.com/coral/com.amazon.bedrock/";
+
+function bedrockHttpError(
+	statusCode: number,
+	errorType: string,
+	message: string,
+	extraHeaders: Record<string, string> = {},
+) {
+	return new APICallError({
+		message,
+		url: "https://bedrock-runtime.us-east-1.amazonaws.com/model/m/converse-stream",
+		requestBodyValues: {},
+		statusCode,
+		responseHeaders: {
+			"x-amzn-errortype": `${errorType}${ARN_SUFFIX}`,
+			...extraHeaders,
+		},
+		responseBody: JSON.stringify({ message }),
+		isRetryable: statusCode === 429 || statusCode >= 500,
+	});
+}
+
+function retryError(last: Error, attempts: number) {
+	// A sustained outage fails every attempt the same way.
+	const earlier = Array.from({ length: attempts - 1 }, () => last);
+	return new RetryError({
+		message: `Failed after ${attempts} attempts. Last error: ${last.message}`,
+		reason: "maxRetriesExceeded",
+		errors: [...earlier, last],
+	});
+}
+
+describe("describeProviderError", () => {
+	describe("APICallError with a status code", () => {
+		it("reads the AWS exception name from x-amzn-errortype and counts the attempts of a RetryError", () => {
+			const last = bedrockHttpError(
+				503,
+				"ServiceUnavailableException",
+				"The service isn't currently available. Retry your request.",
+			);
+			const error = retryError(last, 6);
+			expect(describeProviderError(error)).toEqual({
+				errorName: "ServiceUnavailableException",
+				statusCode: 503,
+				isRetryable: true,
+				attempts: 6,
+			});
+			// The display message the ACP error already carried does not change.
+			expect(extractErrorMessage(error)).toBe(
+				"The service isn't currently available. Retry your request.",
+			);
+		});
+
+		it("keeps ModelNotReadyException apart from ThrottlingException on the same status", () => {
+			const notReady = bedrockHttpError(
+				429,
+				"ModelNotReadyException",
+				"The model is not ready to serve inference requests. Wait and try again.",
+			);
+			const throttled = bedrockHttpError(
+				429,
+				"ThrottlingException",
+				"Too many requests, please wait before trying again.",
+			);
+			expect(describeProviderError(notReady)).toMatchObject({
+				errorName: "ModelNotReadyException",
+				statusCode: 429,
+				isRetryable: true,
+			});
+			expect(describeProviderError(throttled)).toMatchObject({
+				errorName: "ThrottlingException",
+				statusCode: 429,
+				isRetryable: true,
+			});
+		});
+
+		it("reports retry-after as whole seconds from retry-after, retry-after-ms and an HTTP date", () => {
+			const secs = bedrockHttpError(429, "ThrottlingException", "slow down", {
+				"retry-after": "5",
+			});
+			expect(describeProviderError(secs).retryAfterS).toBe(5);
+			const ms = bedrockHttpError(429, "ThrottlingException", "slow down", {
+				"retry-after-ms": "1500",
+			});
+			expect(describeProviderError(ms).retryAfterS).toBe(2);
+			const soon = new Date(Date.now() + 30_000).toUTCString();
+			const dated = bedrockHttpError(429, "ThrottlingException", "slow down", {
+				"retry-after": soon,
+			});
+			const got = describeProviderError(dated).retryAfterS;
+			expect(got).toBeGreaterThanOrEqual(28);
+			expect(got).toBeLessThanOrEqual(31);
+			const none = bedrockHttpError(429, "ThrottlingException", "slow down");
+			expect(describeProviderError(none).retryAfterS).toBeUndefined();
+			const junk = bedrockHttpError(429, "ThrottlingException", "slow down", {
+				"retry-after": "soon",
+			});
+			expect(describeProviderError(junk).retryAfterS).toBeUndefined();
+		});
+
+		it("marks a 400 ValidationException and a 403 AccessDeniedException as not retryable", () => {
+			expect(
+				describeProviderError(
+					bedrockHttpError(
+						400,
+						"ValidationException",
+						"Input is too long for requested model.",
+					),
+				),
+			).toEqual({
+				errorName: "ValidationException",
+				statusCode: 400,
+				isRetryable: false,
+			});
+			expect(
+				describeProviderError(
+					bedrockHttpError(403, "AccessDeniedException", "not allowed"),
+				),
+			).toEqual({
+				errorName: "AccessDeniedException",
+				statusCode: 403,
+				isRetryable: false,
+			});
+		});
+
+		it("gives a status without a name when the response names no exception", () => {
+			const error = new APICallError({
+				message: "Service Unavailable",
+				url: "https://example.test/v1",
+				requestBodyValues: {},
+				statusCode: 503,
+				isRetryable: true,
+			});
+			expect(describeProviderError(error)).toEqual({
+				statusCode: 503,
+				isRetryable: true,
+			});
+		});
+
+		it("reads a name the body carries when the header is absent", () => {
+			const error = new APICallError({
+				message: "Too many requests",
+				url: "https://example.test/v1",
+				requestBodyValues: {},
+				statusCode: 429,
+				responseBody: JSON.stringify({
+					__type: "com.amazon.coral.availability#ThrottlingException",
+					message: "Too many requests",
+				}),
+				isRetryable: true,
+			});
+			expect(describeProviderError(error)).toMatchObject({
+				errorName: "ThrottlingException",
+				statusCode: 429,
+			});
+		});
+	});
+
+	describe("error objects from another copy of the AI SDK", () => {
+		it("reads a RetryError and an APICallError by their fields", () => {
+			const last = Object.assign(new Error("Too many requests"), {
+				name: "AI_APICallError",
+				statusCode: 429,
+				responseHeaders: { "x-amzn-ErrorType": "ThrottlingException" },
+				isRetryable: true,
+			});
+			const error = Object.assign(new Error("Failed after 6 attempts."), {
+				name: "AI_RetryError",
+				reason: "maxRetriesExceeded",
+				errors: [last, last, last, last, last, last],
+				lastError: last,
+			});
+			expect(describeProviderError(error)).toEqual({
+				errorName: "ThrottlingException",
+				statusCode: 429,
+				isRetryable: true,
+				attempts: 6,
+			});
+		});
+	});
+
+	describe("an AWS exception that carries its name", () => {
+		it("reads name, $metadata status and the retryable flag of an AWS SDK style error", () => {
+			const error = Object.assign(new Error("Rate exceeded"), {
+				name: "ThrottlingException",
+				$metadata: { httpStatusCode: 429 },
+				$retryable: { throttling: true },
+			});
+			expect(describeProviderError(error)).toEqual({
+				errorName: "ThrottlingException",
+				statusCode: 429,
+				isRetryable: true,
+			});
+		});
+
+		it("reads the name of an exception with a __type and no status", () => {
+			const error = Object.assign(new Error("model stream failed"), {
+				__type: "com.amazon.bedrock#ModelStreamErrorException",
+			});
+			expect(describeProviderError(error)).toEqual({
+				errorName: "ModelStreamErrorException",
+				isRetryable: true,
+			});
+		});
+
+		it("judges retryability by the exception name when the error has no status or flag", () => {
+			const named = (name: string) =>
+				describeProviderError(Object.assign(new Error("x"), { name }));
+			for (const transient of [
+				"ThrottlingException",
+				"ServiceUnavailableException",
+				"InternalServerException",
+				"ModelTimeoutException",
+				"ModelNotReadyException",
+				"ModelStreamErrorException",
+			]) {
+				expect(named(transient)).toEqual({
+					errorName: transient,
+					isRetryable: true,
+				});
+			}
+			for (const permanent of [
+				"ValidationException",
+				"AccessDeniedException",
+				"ResourceNotFoundException",
+			]) {
+				expect(named(permanent)).toEqual({
+					errorName: permanent,
+					isRetryable: false,
+				});
+			}
+		});
+	});
+
+	describe("a network error", () => {
+		it("reports the code of a connection failure the SDK wrapped as APICallError", () => {
+			const cause = Object.assign(new Error("read ECONNRESET"), {
+				code: "ECONNRESET",
+			});
+			const error = retryError(
+				new APICallError({
+					message: "Cannot connect to API: read ECONNRESET",
+					url: "https://bedrock-runtime.us-east-1.amazonaws.com/x",
+					requestBodyValues: {},
+					cause,
+					isRetryable: true,
+				}),
+				6,
+			);
+			expect(describeProviderError(error)).toEqual({
+				code: "ECONNRESET",
+				isRetryable: true,
+				attempts: 6,
+			});
+		});
+
+		it("reports the code of a bare fetch failure", () => {
+			const error = new TypeError("fetch failed", {
+				cause: Object.assign(new Error("connect ETIMEDOUT"), {
+					code: "ETIMEDOUT",
+				}),
+			});
+			expect(describeProviderError(error)).toEqual({
+				code: "ETIMEDOUT",
+				isRetryable: true,
+			});
+		});
+
+		it("reports Bun's ConnectionClosed code", () => {
+			const error = Object.assign(
+				new Error("The socket connection was closed unexpectedly."),
+				{ code: "ConnectionClosed" },
+			);
+			expect(describeProviderError(error)).toEqual({
+				code: "ConnectionClosed",
+				isRetryable: true,
+			});
+		});
+	});
+
+	describe("the timeout error", () => {
+		it("reports a TimeoutError as a transient failure", () => {
+			const error = new DOMException(
+				"The operation timed out.",
+				"TimeoutError",
+			);
+			expect(describeProviderError(error)).toEqual({
+				errorName: "TimeoutError",
+				isRetryable: true,
+			});
+		});
+	});
+
+	describe("anything else", () => {
+		it("describes a stream exception payload that lost its type as not retryable and nameless", () => {
+			expect(
+				describeProviderError({ message: "stream failed before any content" }),
+			).toEqual({ isRetryable: false });
+		});
+
+		it("survives null, strings and self-referential errors", () => {
+			expect(describeProviderError(undefined)).toEqual({ isRetryable: false });
+			expect(describeProviderError("boom")).toEqual({ isRetryable: false });
+			const loop: Record<string, unknown> = { message: "x" };
+			loop.cause = loop;
+			expect(describeProviderError(loop)).toEqual({ isRetryable: false });
+		});
+
+		it("does not invent an attempts count for a plain error", () => {
+			expect(describeProviderError(new Error("nope")).attempts).toBeUndefined();
+		});
+	});
+});
+
+describe("describeProviderError: retry decisions without an SDK flag", () => {
+	it("treats every 5xx status as retryable, also one the named list does not carry", () => {
+		for (const statusCode of [501, 507, 599]) {
+			expect(describeProviderError({ statusCode }), String(statusCode)).toEqual({
+				statusCode,
+				isRetryable: true,
+			});
+		}
+	});
+
+	it("treats a 4xx status outside the named list as not retryable", () => {
+		for (const statusCode of [400, 401, 403, 404, 413, 422]) {
+			expect(
+				describeProviderError({ statusCode }).isRetryable,
+				String(statusCode),
+			).toBe(false);
+		}
+	});
+
+	it("keeps the code of a network failure and ignores any other code", () => {
+		expect(
+			describeProviderError(
+				Object.assign(new Error("read ECONNRESET"), { code: "ECONNRESET" }),
+			),
+		).toEqual({ code: "ECONNRESET", isRetryable: true });
+		for (const code of ["ENOENT", "EACCES", "ERR_INVALID_ARG_TYPE", "E_OTHER"]) {
+			expect(
+				describeProviderError(Object.assign(new Error(code), { code })),
+				code,
+			).toEqual({ isRetryable: false });
+		}
+	});
+});
