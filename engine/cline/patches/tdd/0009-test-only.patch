+import type { AgentRuntimeStateSnapshot } from "@cline/shared";
+import { describe, expect, it } from "vitest";
+import { RuntimeEventAdapter } from "./runtime-event-adapter";
+
+// Harness patch 0011: the structure of the provider failure that failed a run reaches the public
+// `error` event, where the ACP agent turns it into the JSON-RPC error data.
+
+const SNAPSHOT: AgentRuntimeStateSnapshot = {
+	agentId: "agent_test",
+	runId: "run_test",
+	status: "failed",
+	iteration: 2,
+	messages: [],
+	pendingToolCalls: [],
+	usage: {
+		inputTokens: 0,
+		outputTokens: 0,
+		cacheReadTokens: 0,
+		cacheWriteTokens: 0,
+		totalCost: 0,
+	},
+};
+
+describe("RuntimeEventAdapter run-failed error details", () => {
+	it("copies errorDetails onto the error event", () => {
+		const error = new Error("Too many requests, please wait before trying again.");
+		const errorDetails = {
+			errorName: "ThrottlingException",
+			statusCode: 429,
+			isRetryable: true,
+			retryAfterS: 5,
+			attempts: 6,
+		};
+		const out = new RuntimeEventAdapter().translate({
+			type: "run-failed",
+			snapshot: SNAPSHOT,
+			error,
+			errorClass: "unknown",
+			errorDetails,
+		});
+		expect(out).toEqual([
+			{
+				type: "error",
+				error,
+				errorClass: "unknown",
+				errorDetails,
+				recoverable: false,
+				iteration: 2,
+			},
+		]);
+	});
+});
diff --git a/sdk/packages/llms/src/providers/ai-sdk.error-details.test.ts b/sdk/packages/llms/src/providers/ai-sdk.error-details.test.ts
