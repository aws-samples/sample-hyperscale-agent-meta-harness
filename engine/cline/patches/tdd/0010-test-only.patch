+import { mkdirSync, mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { AgentSideConnection } from "@agentclientprotocol/sdk";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+const mocks = vi.hoisted(() => ({
+	core: undefined as unknown,
+	listener: undefined as ((event: unknown) => void) | undefined,
+	models: {} as Record<string, unknown>,
+	started: [] as Array<{ config: Record<string, unknown> }>,
+	script: undefined as ((emit: (event: unknown) => void) => void) | undefined,
+}));
+
+vi.mock("../session/session", () => ({
+	createCliCore: vi.fn(async () => mocks.core),
+}));
+vi.mock("../runtime/session-events", () => ({
+	subscribeToAgentEvents: (
+		_core: unknown,
+		listener: (event: unknown) => void,
+	) => {
+		mocks.listener = listener;
+		return () => {};
+	},
+}));
+vi.mock("../runtime/prompt", () => ({
+	resolveSystemPrompt: vi.fn(async () => "PROMPT"),
+}));
+vi.mock("@cline/core", async (importOriginal) => {
+	const actual = await importOriginal<typeof import("@cline/core")>();
+	return {
+		...actual,
+		Llms: {
+			...actual.Llms,
+			getModelsForProvider: vi.fn(async () => mocks.models),
+			getProvider: vi.fn(async (id: string) => ({
+				id,
+				name: id,
+				defaultModelId: "us.anthropic.claude-sonnet-5",
+			})),
+		},
+	};
+});
+
+import { AcpAgent } from "./acpAgent";
+import { resolveAcpCompaction } from "./compaction";
+
+// Harness patch 0012: compaction runs under ACP. The session config takes it from providers.json
+// settings.compaction (enabled, strategy, thresholdRatio); it is on when the model's window is
+// known (a configured contextWindow or a catalog window) and off when the window is a guess, so a
+// model with an unknown 1,000,000-token window is never summarised at the 128,000 fallback. The
+// session/prompt result reports the compactions of the turn in _meta.harness.
+
+const SONNET = "us.anthropic.claude-sonnet-5";
+const UNKNOWN = "global.anthropic.claude-sonnet-5-5";
+const conn = {
+	sessionUpdate: vi.fn(async () => {}),
+} as unknown as AgentSideConnection;
+
+function fakeCore() {
+	return {
+		start: vi.fn(async (input: { config: Record<string, unknown> }) => {
+			mocks.started.push(input);
+			return { sessionId: "core-session" };
+		}),
+		readMessages: vi.fn(async () => []),
+		dispose: vi.fn(async () => {}),
+		abort: vi.fn(async () => {}),
+		getAccumulatedUsage: vi.fn(async () => undefined),
+		send: vi.fn(async () => {
+			mocks.script?.((event) => mocks.listener?.(event));
+			return {
+				text: "done",
+				usage: { inputTokens: 1, outputTokens: 1 },
+				messages: [],
+				toolCalls: [],
+				iterations: 1,
+				finishReason: "completed",
+				model: { id: SONNET, provider: "bedrock" },
+				startedAt: new Date(0),
+				endedAt: new Date(0),
+				durationMs: 0,
+			};
+		}),
+	};
+}
+
+let dataDir = "";
+
+function writeSettings(settings: Record<string, unknown>) {
+	mkdirSync(join(dataDir, "settings"), { recursive: true });
+	writeFileSync(
+		join(dataDir, "settings", "providers.json"),
+		JSON.stringify({
+			version: 1,
+			lastUsedProvider: "bedrock",
+			providers: {
+				bedrock: {
+					settings: { provider: "bedrock", model: SONNET, ...settings },
+					updatedAt: "2026-09-30T00:00:00Z",
+					tokenSource: "manual",
+				},
+			},
+		}),
+	);
+}
+
+async function prompt(modelId = SONNET, turns = 1) {
+	mocks.core = fakeCore();
+	const agent = new AcpAgent(conn);
+	const created = await agent.newSession({
+		cwd: process.cwd(),
+		mcpServers: [],
+	});
+	if (modelId !== SONNET) {
+		await agent.setSessionConfigOption({
+			sessionId: created.sessionId,
+			configId: "model",
+			value: modelId,
+		});
+	}
+	const responses = [];
+	for (let i = 0; i < turns; i++) {
+		responses.push(
+			await agent.prompt({
+				sessionId: created.sessionId,
+				prompt: [{ type: "text", text: `turn ${i + 1}` }],
+			}),
+		);
+	}
+	const started = mocks.started.at(-1)?.config as {
+		compaction?: Record<string, unknown>;
+	};
+	return { responses, compaction: started?.compaction };
+}
+
+describe("ACP compaction config", () => {
+	const saved = { ...process.env };
+
+	beforeEach(() => {
+		const dir = mkdtempSync(join(tmpdir(), "acp-compaction-"));
+		dataDir = join(dir, "data");
+		process.env = { ...saved };
+		process.env.HOME = join(dir, "home");
+		process.env.CLINE_DATA_DIR = dataDir;
+		process.env.CLINE_PROVIDER = "bedrock";
+		process.env.CLINE_MODEL = SONNET;
+		process.env.CLINE_API_KEY = "unused";
+		mocks.started.length = 0;
+		mocks.listener = undefined;
+		mocks.script = undefined;
+		mocks.models = { [SONNET]: { name: "Claude Sonnet 5" } };
+	});
+
+	afterEach(() => {
+		process.env = { ...saved };
+	});
+
+	it("turns compaction on with the agentic strategy when providers.json gives the window", async () => {
+		writeSettings({ contextWindow: 1_000_000 });
+		const { compaction } = await prompt();
+		expect(compaction).toEqual({
+			enabled: true,
+			strategy: "agentic",
+			failOnProviderFault: true,
+		});
+	});
+
+	it("turns compaction on for a model whose window the catalog knows", async () => {
+		mocks.models = {
+			[SONNET]: { name: "Claude Sonnet 5", contextWindow: 1_000_000 },
+		};
+		writeSettings({});
+		const { compaction } = await prompt();
+		expect(compaction?.enabled).toBe(true);
+	});
+
+	it("leaves compaction off for a model with no known window, and on when providers.json asks", async () => {
+		mocks.models = { [SONNET]: { name: "Claude Sonnet 5" } };
+		writeSettings({});
+		expect((await prompt(UNKNOWN)).compaction?.enabled).toBe(false);
+
+		mocks.started.length = 0;
+		writeSettings({ compaction: { enabled: true } });
+		expect((await prompt(UNKNOWN)).compaction?.enabled).toBe(true);
+	});
+
+	it("honours enabled false even when the window is known", async () => {
+		writeSettings({ contextWindow: 1_000_000, compaction: { enabled: false } });
+		expect((await prompt()).compaction?.enabled).toBe(false);
+	});
+
+	it("passes the strategy and the threshold ratio from providers.json", async () => {
+		writeSettings({
+			contextWindow: 200_000,
+			compaction: { strategy: "basic", thresholdRatio: 0.8 },
+		});
+		expect((await prompt()).compaction).toEqual({
+			enabled: true,
+			strategy: "basic",
+			thresholdRatio: 0.8,
+			failOnProviderFault: true,
+		});
+	});
+
+	it("ignores a strategy or ratio it cannot use", async () => {
+		writeSettings({
+			contextWindow: 200_000,
+			compaction: { strategy: "someday", thresholdRatio: 7 },
+		});
+		expect((await prompt()).compaction).toEqual({
+			enabled: true,
+			strategy: "agentic",
+			failOnProviderFault: true,
+		});
+	});
+});
+
+describe("ACP compaction report", () => {
+	const saved = { ...process.env };
+
+	beforeEach(() => {
+		const dir = mkdtempSync(join(tmpdir(), "acp-compaction-report-"));
+		dataDir = join(dir, "data");
+		process.env = { ...saved };
+		process.env.HOME = join(dir, "home");
+		process.env.CLINE_DATA_DIR = dataDir;
+		process.env.CLINE_PROVIDER = "bedrock";
+		process.env.CLINE_MODEL = SONNET;
+		process.env.CLINE_API_KEY = "unused";
+		mocks.started.length = 0;
+		mocks.models = { [SONNET]: { name: "Claude Sonnet 5" } };
+		writeSettings({ contextWindow: 100_000 });
+	});
+
+	afterEach(() => {
+		process.env = { ...saved };
+	});
+
+	const notice = (
+		reason: string,
+		phase: string,
+		extra: Record<string, unknown> = {},
+	) => ({
+		type: "notice",
+		noticeType: "status",
+		message: `${phase} ${reason}`,
+		metadata: { kind: reason, reason, phase, iteration: 2, ...extra },
+	});
+
+	it("lists the compactions a turn performed and the compaction settings it ran with", async () => {
+		mocks.script = (emit) => {
+			emit(notice("auto_compaction", "started", { triggerTokens: 90_000 }));
+			emit(
+				notice("auto_compaction", "completed", {
+					tokensBefore: 91_000,
+					tokensAfter: 30_000,
+					messagesBefore: 7,
+					messagesAfter: 3,
+					maxInputTokens: 100_000,
+				}),
+			);
+			emit(notice("auto_compaction", "skipped"));
+		};
+		const { responses } = await prompt();
+		expect(responses[0]?._meta).toEqual({
+			harness: {
+				compactions: [
+					{
+						mode: "auto",
+						tokensBefore: 91_000,
+						tokensAfter: 30_000,
+						messagesBefore: 7,
+						messagesAfter: 3,
+					},
+				],
+				compaction: {
+					enabled: true,
+					strategy: "agentic",
+					thresholdRatio: 0.9,
+					windowTokens: 100_000,
+				},
+			},
+		});
+	});
+
+	it("names an overflow-recovery compaction and starts each prompt with an empty list", async () => {
+		let first = true;
+		mocks.script = (emit) => {
+			if (first) {
+				first = false;
+				emit(
+					notice("overflow_recovery_compaction", "completed", {
+						tokensBefore: 120_000,
+						tokensAfter: 50_000,
+						messagesBefore: 9,
+						messagesAfter: 2,
+					}),
+				);
+			}
+		};
+		const { responses } = await prompt(SONNET, 2);
+		expect(
+			(responses[0]?._meta as { harness: { compactions: unknown[] } }).harness
+				.compactions,
+		).toEqual([
+			{
+				mode: "overflow_recovery",
+				tokensBefore: 120_000,
+				tokensAfter: 50_000,
+				messagesBefore: 9,
+				messagesAfter: 2,
+			},
+		]);
+		expect(
+			(responses[1]?._meta as { harness: { compactions: unknown[] } }).harness
+				.compactions,
+		).toEqual([]);
+	});
+
+	it("reports compaction off with its reason when the window is unknown", async () => {
+		writeSettings({});
+		const { responses } = await prompt(UNKNOWN);
+		expect(
+			(responses[0]?._meta as { harness: { compaction: unknown } }).harness
+				.compaction,
+		).toEqual({
+			enabled: false,
+			strategy: "agentic",
+			thresholdRatio: 0.9,
+			windowTokens: null,
+		});
+	});
+});
+
+describe("resolveAcpCompaction threshold ratio bounds", () => {
+	const ratioOf = (thresholdRatio: unknown) =>
+		resolveAcpCompaction({
+			settings: { thresholdRatio } as Parameters<
+				typeof resolveAcpCompaction
+			>[0]["settings"],
+			catalogWindow: 200_000,
+		}).config.thresholdRatio;
+
+	it("accepts the two ends of the range, 0.1 and 0.99", () => {
+		expect(ratioOf(0.1)).toBe(0.1);
+		expect(ratioOf(0.99)).toBe(0.99);
+	});
+
+	it("refuses a ratio just outside the range and a value that is not a number", () => {
+		for (const ratio of [0.09, 0.0999, 0.995, 1, 0, -0.5, 7, "0.5", null]) {
+			expect(ratioOf(ratio), String(ratio)).toBeUndefined();
+		}
+		expect(ratioOf(Number.NaN)).toBeUndefined();
+		expect(ratioOf(Number.POSITIVE_INFINITY)).toBeUndefined();
+	});
+});
