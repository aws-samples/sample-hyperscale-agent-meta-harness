+++ b/sdk/packages/core/src/services/llms/handler-factory.model-info.test.ts
@@ -0,0 +1,96 @@
+import type { AgentConfig, ModelInfo } from "@cline/shared";
+import { describe, expect, it, vi } from "vitest";
+import { resolveModelInfoFromConfig } from "./handler-factory";
+
+vi.mock("@cline/llms", () => ({
+	createGateway: vi.fn(),
+	createHandlerAsync: vi.fn(),
+	hasRegisteredHandler: vi.fn(() => false),
+	MODEL_COLLECTIONS_BY_PROVIDER_ID: {},
+	normalizeProviderId: (id: string) => id,
+	toGatewayModelCapabilities: vi.fn(),
+}));
+
+// Harness patch 0012: providers.json settings.contextWindow (ProviderConfig.maxInputTokens) is the
+// window the harness proved for the model, so it must reach the compaction budget for a model that
+// is in the bundled catalog too. Before the patch a catalog id ignored it (measured: model info
+// stayed 1,000,000 with contextWindow 100,000).
+
+const SONNET = "us.anthropic.claude-sonnet-5";
+const catalogRow: ModelInfo = {
+	id: SONNET,
+	name: "Claude Sonnet 5",
+	contextWindow: 1_000_000,
+	maxTokens: 64_000,
+};
+
+function config(overrides: Partial<AgentConfig> & { maxInputTokens?: number }) {
+	const { maxInputTokens, ...rest } = overrides;
+	return {
+		providerId: "bedrock",
+		modelId: SONNET,
+		apiKey: "",
+		systemPrompt: "",
+		knownModels: { [SONNET]: catalogRow },
+		providerConfig: {
+			providerId: "bedrock",
+			modelId: SONNET,
+			...(maxInputTokens !== undefined ? { maxInputTokens } : {}),
+		},
+		...rest,
+	} as unknown as AgentConfig;
+}
+
+describe("resolveModelInfoFromConfig", () => {
+	it("applies a configured window to a model that is in the catalog", () => {
+		const info = resolveModelInfoFromConfig(
+			config({ maxInputTokens: 100_000 }),
+		);
+		expect(info).toMatchObject({
+			id: SONNET,
+			contextWindow: 100_000,
+			maxInputTokens: 100_000,
+			// The rest of the catalog row is kept.
+			maxTokens: 64_000,
+			name: "Claude Sonnet 5",
+		});
+	});
+
+	it("returns the catalog row itself when no window is configured", () => {
+		expect(resolveModelInfoFromConfig(config({}))).toBe(catalogRow);
+	});
+
+	it("gives a model outside the catalog the configured window", () => {
+		const info = resolveModelInfoFromConfig(
+			config({
+				modelId: "global.anthropic.claude-sonnet-5-5",
+				knownModels: {},
+				maxInputTokens: 1_000_000,
+			}),
+		);
+		expect(info).toMatchObject({
+			id: "global.anthropic.claude-sonnet-5-5",
+			contextWindow: 1_000_000,
+			maxInputTokens: 1_000_000,
+		});
+	});
+
+	it("knows nothing about a model outside the catalog with no configured window", () => {
+		expect(
+			resolveModelInfoFromConfig(
+				config({
+					modelId: "global.anthropic.claude-sonnet-5-5",
+					knownModels: {},
+				}),
+			),
+		).toBeUndefined();
+	});
+
+	it("ignores a configured window that is not a positive number", () => {
+		for (const bad of [0, -5, Number.NaN]) {
+			expect(resolveModelInfoFromConfig(config({ maxInputTokens: bad }))).toBe(
+				catalogRow,
+			);
+		}
+	});
+});
