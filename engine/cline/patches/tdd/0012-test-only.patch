+// Corrections the fork applies on top of the generated catalog, so a catalog
+// regeneration (models.dev) does not undo them. Each one is live-verified.
+import { describe, expect, it } from "vitest";
+import { GENERATED_PROVIDER_MODELS } from "./catalog.generated";
+import { getGeneratedModelsForProvider } from "./catalog.generated-access";
+
+const GLM_53_EFFORTS = ["low", "medium", "high", "xhigh", "max"];
+
+describe("fork catalog overrides", () => {
+	it.each([
+		"us.zai.glm-5.3",
+		"global.zai.glm-5.3",
+	])("lists the efforts Bedrock accepts for %s and no off switch", (modelId) => {
+		const model = getGeneratedModelsForProvider("bedrock")[modelId];
+		expect(model?.reasoningOptions).toEqual([
+			{ type: "effort", values: GLM_53_EFFORTS },
+		]);
+	});
+
+	it("changes nothing else about those entries", () => {
+		for (const modelId of ["us.zai.glm-5.3", "global.zai.glm-5.3"]) {
+			const raw = GENERATED_PROVIDER_MODELS.providers.bedrock?.[modelId];
+			const model = getGeneratedModelsForProvider("bedrock")[modelId];
+			expect(model).toMatchObject({
+				id: modelId,
+				contextWindow: raw?.contextWindow,
+				maxTokens: raw?.maxTokens,
+				capabilities: raw?.capabilities,
+				pricing: raw?.pricing,
+				family: "glm",
+			});
+		}
+	});
+
+	it("leaves other Bedrock models on their generated reasoning options", () => {
+		const models = getGeneratedModelsForProvider("bedrock");
+		for (const [modelId, raw] of Object.entries(
+			GENERATED_PROVIDER_MODELS.providers.bedrock ?? {},
+		)) {
+			if (modelId === "us.zai.glm-5.3" || modelId === "global.zai.glm-5.3") {
+				continue;
+			}
+			expect(models[modelId]?.reasoningOptions).toEqual(raw.reasoningOptions);
+		}
+	});
+});
diff --git a/sdk/packages/llms/src/providers/routing/bedrock-glm-effort.test.ts b/sdk/packages/llms/src/providers/routing/bedrock-glm-effort.test.ts
new file mode 100644
