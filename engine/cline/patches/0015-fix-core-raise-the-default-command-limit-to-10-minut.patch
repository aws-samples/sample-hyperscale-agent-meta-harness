+import { describe, expect, it, vi } from "vitest";
+import {
+	DEFAULT_SHELL_TIMEOUT_MS,
+	MAX_SHELL_TIMEOUT_MS,
+	MIN_SHELL_TIMEOUT_MS,
+	reportShellTimeoutWarning,
+	resolveShellTimeout,
+	SHELL_TIMEOUT_ENV,
+} from "./shell-timeout";
+
+const fromDefault = { timeoutMs: 600_000, source: "default_setting" };
+
+describe("shell timeout limits", () => {
+	it("pins the default at 10 minutes, the floor at 1 second, the ceiling at 30 minutes and the variable name", () => {
+		expect(DEFAULT_SHELL_TIMEOUT_MS).toBe(600_000);
+		expect(MIN_SHELL_TIMEOUT_MS).toBe(1_000);
+		expect(MAX_SHELL_TIMEOUT_MS).toBe(1_800_000);
+		expect(SHELL_TIMEOUT_ENV).toBe("CLINE_RUN_COMMANDS_TIMEOUT_MS");
+	});
+});
+
+describe("resolveShellTimeout", () => {
+	it("uses the default, without a warning, when the variable is unset or blank", () => {
+		for (const env of [
+			{},
+			{ [SHELL_TIMEOUT_ENV]: "" },
+			{ [SHELL_TIMEOUT_ENV]: "   " },
+		]) {
+			expect(resolveShellTimeout(env)).toEqual(fromDefault);
+		}
+	});
+
+	it("reads a whole number of milliseconds from the floor to the ceiling", () => {
+		expect(resolveShellTimeout({ [SHELL_TIMEOUT_ENV]: "45000" })).toEqual({
+			timeoutMs: 45_000,
+			source: "configured_setting",
+		});
+		expect(resolveShellTimeout({ [SHELL_TIMEOUT_ENV]: " 90000 " })).toEqual({
+			timeoutMs: 90_000,
+			source: "configured_setting",
+		});
+		expect(resolveShellTimeout({ [SHELL_TIMEOUT_ENV]: "1000" }).timeoutMs).toBe(
+			1_000,
+		);
+		expect(resolveShellTimeout({ [SHELL_TIMEOUT_ENV]: "1800000" })).toEqual({
+			timeoutMs: 1_800_000,
+			source: "configured_setting",
+		});
+		expect(
+			resolveShellTimeout({ [SHELL_TIMEOUT_ENV]: "0000600000" }).timeoutMs,
+		).toBe(600_000);
+	});
+
+	it("caps a value above the ceiling and says so", () => {
+		for (const raw of [
+			"1800001",
+			"99999999999",
+			"9007199254740993",
+			"9".repeat(400),
+		]) {
+			const out = resolveShellTimeout({ [SHELL_TIMEOUT_ENV]: raw });
+			expect(out.timeoutMs, raw.slice(0, 20)).toBe(1_800_000);
+			expect(out.source).toBe("configured_setting");
+			expect(out.warning, raw.slice(0, 20)).toContain(SHELL_TIMEOUT_ENV);
+			expect(out.warning).toContain("ceiling");
+			expect(out.warning).toContain("1800000");
+		}
+	});
+
+	it("falls back to the default, and says so, for a value that is not a whole number of milliseconds from the floor up", () => {
+		for (const bad of [
+			"0",
+			"00",
+			"1",
+			"999",
+			"-1",
+			"-600000",
+			"+5000",
+			"1.5",
+			"1e6",
+			"0x10",
+			"600000ms",
+			"10 minutes",
+			"20m",
+			"abc",
+			"NaN",
+			"Infinity",
+			"-Infinity",
+			"null",
+			"undefined",
+		]) {
+			const out = resolveShellTimeout({ [SHELL_TIMEOUT_ENV]: bad });
+			expect(out, `value ${JSON.stringify(bad)}`).toMatchObject(fromDefault);
+			expect(out.warning, bad).toContain(SHELL_TIMEOUT_ENV);
+			expect(out.warning).toContain("1000");
+			expect(out.warning).toContain("600000");
+		}
+	});
+
+	it("shows at most a short piece of an odd value in the warning", () => {
+		const out = resolveShellTimeout({
+			[SHELL_TIMEOUT_ENV]: `x${"y".repeat(5000)}`,
+		});
+		expect(out.warning?.length).toBeLessThan(400);
+	});
+
+	it("never returns a value outside the floor and the ceiling", () => {
+		for (const raw of [
+			"1",
+			"999",
+			"1000",
+			"599999",
+			"600000",
+			"1799999",
+			"1800000",
+			"5000000",
+			"abc",
+			"",
+		]) {
+			const { timeoutMs } = resolveShellTimeout({ [SHELL_TIMEOUT_ENV]: raw });
+			expect(timeoutMs).toBeGreaterThanOrEqual(1_000);
+			expect(timeoutMs).toBeLessThanOrEqual(1_800_000);
+		}
+	});
+
+	it("reads process.env when no environment is passed", () => {
+		const before = process.env[SHELL_TIMEOUT_ENV];
+		try {
+			process.env[SHELL_TIMEOUT_ENV] = "12345";
+			expect(resolveShellTimeout().timeoutMs).toBe(12_345);
+			delete process.env[SHELL_TIMEOUT_ENV];
+			expect(resolveShellTimeout().timeoutMs).toBe(600_000);
+		} finally {
+			if (before === undefined) delete process.env[SHELL_TIMEOUT_ENV];
+			else process.env[SHELL_TIMEOUT_ENV] = before;
+		}
+	});
+});
+
+describe("reportShellTimeoutWarning", () => {
+	it("writes nothing for no warning", () => {
+		const write = vi.fn();
+		reportShellTimeoutWarning(undefined, write);
+		expect(write).not.toHaveBeenCalled();
+	});
+
+	it("writes one line, once per distinct warning", () => {
+		const write = vi.fn();
+		reportShellTimeoutWarning("report-test warning A", write);
+		reportShellTimeoutWarning("report-test warning A", write);
+		reportShellTimeoutWarning("report-test warning B", write);
+		expect(write.mock.calls).toEqual([
+			["report-test warning A\n"],
+			["report-test warning B\n"],
+		]);
+	});
+
+	it("writes to stderr, never stdout, by default (stdout carries the ACP protocol)", () => {
+		const err = vi
+			.spyOn(process.stderr, "write")
+			.mockImplementation(() => true);
+		const out = vi
+			.spyOn(process.stdout, "write")
+			.mockImplementation(() => true);
+		try {
+			reportShellTimeoutWarning("report-test default sink");
+			expect(err).toHaveBeenCalledWith("report-test default sink\n");
+			expect(out).not.toHaveBeenCalled();
+		} finally {
+			err.mockRestore();
+			out.mockRestore();
+		}
+	});
+});
