@@ -50,12 +50,15 @@ export function withTimeout<T>(
 	ms: number,
 	message: string,
 ): Promise<T> {
-	return Promise.race([
-		promise,
-		new Promise<never>((_, reject) => {
-			setTimeout(() => reject(new TimeoutError(message, ms)), ms);
