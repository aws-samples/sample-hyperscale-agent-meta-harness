--- /dev/null
+++ b/sdk/packages/core/src/extensions/tools/shell-timeout.ts
@@ -0,0 +1,96 @@
+/**
+ * Time limit of one run_commands command in the built-in tools.
+ *
+ * The SDK used to end every command at 30 seconds, which cut off the builds,
+ * installs and test suites of a test-driven loop. `createBuiltinTools` now
+ * resolves the limit once, here, and gives the same value to the tool (its
+ * limit, its call limit and its description) and to the shell executor (which
+ * kills the command's process group), so the two cannot disagree. The default
+ * is 10 minutes. A host sets CLINE_RUN_COMMANDS_TIMEOUT_MS, a whole number of
+ * milliseconds from 1 second to 30 minutes, to change it. A value above the
+ * ceiling is capped. A value that is not usable (empty is "unset"; anything
+ * that is not plain digits, or below the floor, which is probably a number of
+ * seconds) is ignored and the default applies, so no setting removes the
+ * limit. Both cases carry a warning line for the caller to report.
+ *
+ * A `bashTimeoutMs` or executor `timeoutMs` option that a host passes in code
+ * wins and is used as given. The stand-alone defaults of `createShellTool`
+ * and `createShellExecutor` stay 30 seconds for other callers.
+ */
+
+/** Environment variable that sets the command limit, in milliseconds. */
+export const SHELL_TIMEOUT_ENV = "CLINE_RUN_COMMANDS_TIMEOUT_MS";
+
+/** Limit of one command when nothing sets another: 10 minutes. */
+export const DEFAULT_SHELL_TIMEOUT_MS = 600_000;
+
+/** Lowest limit the variable can set: 1 second. A smaller number is most likely seconds, not milliseconds. */
+export const MIN_SHELL_TIMEOUT_MS = 1_000;
+
+/** Highest limit the variable can set: 30 minutes. */
+export const MAX_SHELL_TIMEOUT_MS = 1_800_000;
+
+export type ShellTimeoutSource = "default_setting" | "configured_setting";
+
+export interface ShellTimeout {
+	timeoutMs: number;
+	source: ShellTimeoutSource;
+	/** One line for stderr when the variable was unusable or capped; absent otherwise. */
+	warning?: string;
+}
+
+/** The part of a value a warning shows: long values are cut. */
+function shown(raw: string): string {
+	return raw.length > 40 ? `${raw.slice(0, 40)}...` : raw;
+}
+
+/**
+ * Resolve the command limit from the environment: the variable's value when
+ * it is a whole number of milliseconds from {@link MIN_SHELL_TIMEOUT_MS} up
+ * (capped at {@link MAX_SHELL_TIMEOUT_MS}), the default otherwise.
+ */
+export function resolveShellTimeout(
+	env: Readonly<Record<string, string | undefined>> = process.env,
+): ShellTimeout {
+	const raw = env[SHELL_TIMEOUT_ENV]?.trim();
+	if (raw === undefined || raw === "") {
+		return { timeoutMs: DEFAULT_SHELL_TIMEOUT_MS, source: "default_setting" };
+	}
+	// A digit string too long for a number parses as Infinity and is capped.
+	const requested = /^[0-9]+$/.test(raw) ? Number(raw) : Number.NaN;
+	if (!(requested >= MIN_SHELL_TIMEOUT_MS)) {
+		return {
+			timeoutMs: DEFAULT_SHELL_TIMEOUT_MS,
+			source: "default_setting",
+			warning: `${SHELL_TIMEOUT_ENV}="${shown(raw)}" is not a whole number of milliseconds from ${MIN_SHELL_TIMEOUT_MS} to ${MAX_SHELL_TIMEOUT_MS}; using the default ${DEFAULT_SHELL_TIMEOUT_MS}.`,
+		};
+	}
+	if (requested > MAX_SHELL_TIMEOUT_MS) {
+		return {
+			timeoutMs: MAX_SHELL_TIMEOUT_MS,
+			source: "configured_setting",
+			warning: `${SHELL_TIMEOUT_ENV}="${shown(raw)}" is above the ceiling; using ${MAX_SHELL_TIMEOUT_MS}.`,
+		};
+	}
+	return { timeoutMs: requested, source: "configured_setting" };
+}
+
+const reported = new Set<string>();
+
+/**
+ * Write a warning from {@link resolveShellTimeout} as one line, once per
+ * distinct text in this process. The default sink is stderr: stdout carries
+ * the ACP protocol.
+ */
+export function reportShellTimeoutWarning(
+	warning: string | undefined,
+	write: (line: string) => void = (line) => {
+		process.stderr.write(line);
+	},
+): void {
+	if (warning === undefined || reported.has(warning)) {
+		return;
+	}
+	reported.add(warning);
+	write(`${warning}\n`);
+}
