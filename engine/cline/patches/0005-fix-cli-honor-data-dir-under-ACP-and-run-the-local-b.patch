 import { Readable, Writable } from "node:stream";
 import { registerClineClientIdentity } from "../utils/cline-client-identity";
+import { configureSandboxEnvironment } from "../utils/helpers";
 import { writeDiagnostic } from "../utils/output";
 import type { ResolvedCliReasoning } from "../utils/reasoning";
 
 export interface AcpModeOptions {
 	autoApproveTools?: boolean;
 	reasoning?: ResolvedCliReasoning;
+	/** Run the in-process local backend (no hub daemon); set for sandboxed ACP. */
+	localBackend?: boolean;
+}
+
+/**
+ * Apply the CLI sandbox rules to ACP mode. `--data-dir`, or `CLINE_SANDBOX=1`
+ * with `CLINE_SANDBOX_DATA_DIR`, points every Cline state path (settings,
+ * sessions, db, logs) into the data dir, exactly as in `--json` mode, and a
+ * sandboxed ACP session runs the local backend so no process outlives it.
+ */
+export function resolveAcpSandbox(options: { dataDir?: string; cwd: string }): {
+	localBackend: boolean;
+	dataDir: string | undefined;
+} {
+	const enabled =
+		!!options.dataDir || process.env.CLINE_SANDBOX?.trim() === "1";
+	const dataDir = configureSandboxEnvironment({
+		enabled,
+		cwd: options.cwd,
+		explicitDir: options.dataDir,
+	});
+	return { localBackend: enabled, dataDir };
 }
 
 export async function runAcpMode(options?: AcpModeOptions): Promise<void> {
@@ -27,6 +50,7 @@ export async function runAcpMode(options?: AcpModeOptions): Promise<void> {
 		return new AcpAgent(conn, {
 			autoApproveTools: options?.autoApproveTools,
 			reasoning: options?.reasoning,
+			localBackend: options?.localBackend,
 		});
 	}, stream);
 
