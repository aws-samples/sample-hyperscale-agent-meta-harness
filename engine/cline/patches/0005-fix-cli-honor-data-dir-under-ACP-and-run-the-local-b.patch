+import { mkdtempSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { resolveAcpSandbox } from "./index";
+
+// Fork patch 0006: --acp honors --data-dir and CLINE_SANDBOX=1 the way --json does.
+describe("resolveAcpSandbox", () => {
+	const saved = { ...process.env };
+	let base: string;
+
+	beforeEach(() => {
+		base = mkdtempSync(join(tmpdir(), "acp-sandbox-"));
+		for (const key of [
+			"CLINE_SANDBOX",
+			"CLINE_SANDBOX_DATA_DIR",
+			"CLINE_DATA_DIR",
+			"CLINE_PROVIDER_SETTINGS_PATH",
+			"CLINE_SESSION_DATA_DIR",
+		]) {
+			delete process.env[key];
+		}
+	});
+
+	afterEach(() => {
+		process.env = { ...saved };
+	});
+
+	it("puts ACP state under --data-dir and selects the local backend", () => {
+		const dataDir = join(base, "data");
+		const result = resolveAcpSandbox({ dataDir, cwd: base });
+		expect(result).toEqual({ localBackend: true, dataDir });
+		expect(process.env.CLINE_DATA_DIR).toBe(dataDir);
+		expect(process.env.CLINE_PROVIDER_SETTINGS_PATH).toBe(
+			join(dataDir, "settings", "providers.json"),
+		);
+		expect(process.env.CLINE_SESSION_DATA_DIR).toBe(join(dataDir, "sessions"));
+	});
+
+	it("honors CLINE_SANDBOX=1 with CLINE_SANDBOX_DATA_DIR", () => {
+		const dataDir = join(base, "sandbox");
+		process.env.CLINE_SANDBOX = "1";
+		process.env.CLINE_SANDBOX_DATA_DIR = dataDir;
+		const result = resolveAcpSandbox({ cwd: base });
+		expect(result.localBackend).toBe(true);
+		expect(process.env.CLINE_PROVIDER_SETTINGS_PATH).toBe(
+			join(dataDir, "settings", "providers.json"),
+		);
+	});
+
+	it("leaves the environment alone without a data dir or sandbox flag", () => {
+		const result = resolveAcpSandbox({ cwd: base });
+		expect(result).toEqual({ localBackend: false, dataDir: undefined });
+		expect(process.env.CLINE_PROVIDER_SETTINGS_PATH).toBeUndefined();
+		expect(process.env.CLINE_DATA_DIR).toBeUndefined();
+	});
+});
