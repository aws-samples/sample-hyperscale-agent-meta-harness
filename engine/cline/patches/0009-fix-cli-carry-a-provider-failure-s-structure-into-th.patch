--- /dev/null
+++ b/sdk/packages/llms/src/providers/bedrock-exception-frames.test.ts
@@ -0,0 +1,136 @@
+import { crc32 } from "node:zlib";
+import { createAmazonBedrock } from "@ai-sdk/amazon-bedrock";
+import { describe, expect, it } from "vitest";
+import { describeProviderError } from "./error-classification";
+
+// Harness patch 0011: a ConverseStream exception frame (an exception inside an HTTP 200) must reach
+// describeProviderError with its exception type. @ai-sdk/amazon-bedrock 5.0.62 dropped it, so the
+// series carried a bun patch of that package that kept it as `__type`. From 5.0.98 (cli-v3.0.71) the
+// provider's own error part carries `type` (lower camel: "throttlingException"), `statusCode` and
+// `isRetryable`, so the bun patch is gone and describeProviderError reads `type` and names the
+// exception in the AWS form ("ThrottlingException"). This test fails if a provider upgrade drops either.
+
+function frame(headers: Record<string, string>, payload: string): Uint8Array {
+	const enc = new TextEncoder();
+	const headerBytes: number[] = [];
+	for (const [name, value] of Object.entries(headers)) {
+		const n = enc.encode(name);
+		const v = enc.encode(value);
+		headerBytes.push(n.length, ...n, 7, v.length >> 8, v.length & 255, ...v);
+	}
+	const body = enc.encode(payload);
+	const total = 12 + headerBytes.length + body.length + 4;
+	const out = new Uint8Array(total);
+	const view = new DataView(out.buffer);
+	view.setUint32(0, total);
+	view.setUint32(4, headerBytes.length);
+	view.setUint32(8, crc32(out.subarray(0, 8)));
+	out.set(headerBytes, 12);
+	out.set(body, 12 + headerBytes.length);
+	view.setUint32(total - 4, crc32(out.subarray(0, total - 4)));
+	return out;
+}
+
+function exceptionFrame(type: string, message: string): Uint8Array {
+	return frame(
+		{
+			":message-type": "exception",
+			":exception-type": type,
+			":content-type": "application/json",
+		},
+		JSON.stringify({ message }),
+	);
+}
+
+async function firstErrorPart(type: string, message: string): Promise<unknown> {
+	const body = exceptionFrame(type, message);
+	const fetchStub = (async () =>
+		new Response(
+			new ReadableStream({
+				start(controller) {
+					controller.enqueue(body);
+					controller.close();
+				},
+			}),
+			{
+				status: 200,
+				headers: { "content-type": "application/vnd.amazon.eventstream" },
+			},
+		)) as unknown as typeof fetch;
+	const provider = createAmazonBedrock({
+		region: "us-east-1",
+		apiKey: "unused",
+		fetch: fetchStub,
+	});
+	const model = provider.languageModel("us.anthropic.claude-sonnet-5");
+	const { stream } = await model.doStream({
+		prompt: [{ role: "user", content: [{ type: "text", text: "hi" }] }],
+	});
+	const reader = stream.getReader();
+	for (;;) {
+		const { done, value } = await reader.read();
+		if (done) {
+			throw new Error("the stream ended without an error part");
+		}
+		if ((value as { type: string }).type === "error") {
+			return (value as { error: unknown }).error;
+		}
+	}
+}
+
+describe("Bedrock stream exception frames keep their exception type", () => {
+	const cases: Array<[string, string, number, boolean]> = [
+		["throttlingException", "ThrottlingException", 429, true],
+		["serviceUnavailableException", "ServiceUnavailableException", 503, true],
+		["internalServerException", "InternalServerException", 500, true],
+		["modelStreamErrorException", "ModelStreamErrorException", 424, true],
+		["validationException", "ValidationException", 400, false],
+	];
+	for (const [frameType, name, status, retryable] of cases) {
+		it(`names a ${frameType} frame ${name}`, async () => {
+			const error = await firstErrorPart(frameType, "stream failed");
+			expect(error).toMatchObject({
+				message: "stream failed",
+				type: frameType,
+				statusCode: status,
+				isRetryable: retryable,
+			});
+			// The status is the provider's mapping of the exception type (the frame sits in an HTTP 200).
+			expect(describeProviderError(error)).toEqual({
+				errorName: name,
+				statusCode: status,
+				isRetryable: retryable,
+			});
+		});
+	}
+});
+
+describe("describeProviderError on a bare stream error part", () => {
+	it("names a lower camel exception type and judges it transient without a status", () => {
+		expect(
+			describeProviderError({
+				message: "slow down",
+				type: "throttlingException",
+			}),
+		).toEqual({ errorName: "ThrottlingException", isRetryable: true });
+	});
+
+	it("keeps an unknown Exception type's name and does not call it transient", () => {
+		expect(
+			describeProviderError({ message: "no", type: "accessDeniedException" }),
+		).toEqual({ errorName: "AccessDeniedException", isRetryable: false });
+	});
+
+	it("does not take a type that is not an AWS exception name for one", () => {
+		for (const type of [
+			"error",
+			"invalid_request_error",
+			"overloaded_error",
+			7,
+		]) {
+			expect(describeProviderError({ message: "x", type })).toEqual({
+				isRetryable: false,
+			});
+		}
+	});
+});
