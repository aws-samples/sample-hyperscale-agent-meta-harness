+import { mkdtempSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { AgentSideConnection } from "@agentclientprotocol/sdk";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+const mocks = vi.hoisted(() => ({
+	core: undefined as unknown,
+	listener: undefined as ((event: unknown) => void) | undefined,
+}));
+
+vi.mock("../session/session", () => ({
+	createCliCore: vi.fn(async () => mocks.core),
+}));
+vi.mock("../runtime/session-events", () => ({
+	subscribeToAgentEvents: (_core: unknown, listener: (event: unknown) => void) => {
+		mocks.listener = listener;
+		return () => {};
+	},
+}));
+vi.mock("../runtime/prompt", () => ({
+	resolveSystemPrompt: vi.fn(async () => "PROMPT"),
+}));
+vi.mock("@cline/core", async (importOriginal) => {
+	const actual = await importOriginal<typeof import("@cline/core")>();
+	return {
+		...actual,
+		Llms: {
+			...actual.Llms,
+			getModelsForProvider: vi.fn(async () => ({
+				"us.anthropic.claude-sonnet-5": { name: "Claude Sonnet 5" },
+			})),
+			getProvider: vi.fn(async (id: string) => ({
+				id,
+				name: id,
+				defaultModelId: "us.anthropic.claude-sonnet-5",
+			})),
+		},
+	};
+});
+
+import { AcpAgent } from "./acpAgent";
+
+// Harness patch 0011: a failed turn ends session/prompt with the JSON-RPC error whose `data` carries
+// the structure of the provider failure (AWS exception name, HTTP status, retryability, retry-after,
+// attempts) next to the unchanged `message`. Before the patch `data` was `{message}` only, so the
+// cline-agentcore-harness failover classifier had nothing to read (evidence
+// 2026-09-30-engine-fault-probe.md, "ACP error shape").
+
+const conn = {
+	sessionUpdate: vi.fn(async () => {}),
+} as unknown as AgentSideConnection;
+
+/** A core whose send() reports `event` as the run's terminal error and resolves with an error finish. */
+function coreFailingWith(event: Record<string, unknown>) {
+	return {
+		start: vi.fn(async () => ({ sessionId: "core-session" })),
+		readMessages: vi.fn(async () => []),
+		dispose: vi.fn(async () => {}),
+		abort: vi.fn(async () => {}),
+		getAccumulatedUsage: vi.fn(async () => undefined),
+		send: vi.fn(async () => {
+			mocks.listener?.({ recoverable: false, iteration: 1, ...event });
+			return {
+				text: "",
+				usage: { inputTokens: 0, outputTokens: 0 },
+				messages: [],
+				toolCalls: [],
+				iterations: 1,
+				finishReason: "error",
+				model: { id: "us.anthropic.claude-sonnet-5", provider: "bedrock" },
+				startedAt: new Date(0),
+				endedAt: new Date(0),
+				durationMs: 0,
+			};
+		}),
+	};
+}
+
+async function promptError(event: Record<string, unknown>) {
+	mocks.core = coreFailingWith(event);
+	const agent = new AcpAgent(conn);
+	const created = await agent.newSession({ cwd: process.cwd(), mcpServers: [] });
+	try {
+		await agent.prompt({
+			sessionId: created.sessionId,
+			prompt: [{ type: "text", text: "go" }],
+		});
+	} catch (error) {
+		return error as { code: number; message: string; data: unknown };
+	}
+	throw new Error("prompt did not fail");
+}
+
+describe("ACP prompt error data", () => {
+	const saved = { ...process.env };
+
+	beforeEach(() => {
+		const dir = mkdtempSync(join(tmpdir(), "acp-error-data-"));
+		process.env = { ...saved };
+		process.env.HOME = join(dir, "home");
+		process.env.CLINE_DATA_DIR = join(dir, "data");
+		process.env.CLINE_PROVIDER = "bedrock";
+		process.env.CLINE_MODEL = "us.anthropic.claude-sonnet-5";
+		process.env.CLINE_API_KEY = "unused";
+		mocks.listener = undefined;
+	});
+
+	afterEach(() => {
+		process.env = { ...saved };
+	});
+
+	it("carries the AWS exception name, status, retryability and attempts of an exhausted 503", async () => {
+		const text = "The service isn't currently available. Retry your request.";
+		const error = await promptError({
+			type: "error",
+			error: new Error(text),
+			errorClass: "unknown",
+			errorDetails: {
+				errorName: "ServiceUnavailableException",
+				statusCode: 503,
+				isRetryable: true,
+				attempts: 6,
+			},
+		});
+		expect(error.code).toBe(-32603);
+		expect(error.message).toBe(`Internal error: ${text}`);
+		expect(error.data).toEqual({
+			message: text,
+			errorName: "ServiceUnavailableException",
+			statusCode: 503,
+			isRetryable: true,
+			attempts: 6,
+		});
+	});
+
+	it("carries retry-after seconds and the network code of a connection failure", async () => {
+		const throttled = await promptError({
+			type: "error",
+			error: new Error("Too many requests, please wait before trying again."),
+			errorDetails: {
+				errorName: "ThrottlingException",
+				statusCode: 429,
+				isRetryable: true,
+				retryAfterS: 5,
+				attempts: 6,
+			},
+		});
+		expect(throttled.data).toMatchObject({
+			errorName: "ThrottlingException",
+			statusCode: 429,
+			retryAfterS: 5,
+		});
+		const reset = await promptError({
+			type: "error",
+			error: new Error("Cannot connect to API: read ECONNRESET"),
+			errorDetails: { code: "ECONNRESET", isRetryable: true, attempts: 6 },
+		});
+		expect(reset.data).toEqual({
+			message: "Cannot connect to API: read ECONNRESET",
+			code: "ECONNRESET",
+			isRetryable: true,
+			attempts: 6,
+		});
+	});
+
+	it("names a context-window stop reason and its class", async () => {
+		const error = await promptError({
+			type: "error",
+			error: new Error(
+				"The conversation still exceeds the model's context window after compacting it.",
+			),
+			errorClass: "context_window_exceeded",
+			errorDetails: {
+				errorName: "ModelContextWindowExceeded",
+				stopReason: "model_context_window_exceeded",
+				isRetryable: false,
+			},
+		});
+		expect(error.code).toBe(-32603);
+		expect(error.data).toEqual({
+			message:
+				"The conversation still exceeds the model's context window after compacting it.",
+			errorName: "ModelContextWindowExceeded",
+			stopReason: "model_context_window_exceeded",
+			isRetryable: false,
+			errorClass: "context_window_exceeded",
+		});
+	});
+
+	it("keeps data to the message when the failure has no structure", async () => {
+		const error = await promptError({
+			type: "error",
+			error: new Error("upstream failed"),
+			errorClass: "unknown",
+		});
+		expect(error.code).toBe(-32603);
+		expect(error.data).toEqual({ message: "upstream failed" });
+	});
+
+	it("puts the status of an authentication failure in the auth-required error too", async () => {
+		const error = await promptError({
+			type: "error",
+			error: new Error("Invalid API key (401 Unauthorized)"),
+			errorClass: "auth",
+			errorDetails: {
+				errorName: "AccessDeniedException",
+				statusCode: 403,
+				isRetryable: false,
+			},
+		});
+		expect(error.code).toBe(-32000);
+		expect(error.data).toMatchObject({
+			errorName: "AccessDeniedException",
+			statusCode: 403,
+			isRetryable: false,
+			errorClass: "auth",
+		});
+	});
+});
