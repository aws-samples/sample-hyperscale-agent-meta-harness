+import { APICallError, RetryError } from "ai";
+import { describe, expect, it } from "vitest";
+import { describeProviderError } from "./error-classification";
+import { extractErrorMessage } from "./format";
+
+// Harness patch 0011: the structure of a provider failure (AWS exception name, HTTP status,
+// retryability, retry-after, attempts) survives to the ACP error data, so the cline-agentcore-harness
+// failover classifier reads fields instead of guessing from message text. Shapes are the ones the
+// pinned fork raised against a local fake Bedrock (evidence 2026-09-30-engine-fault-probe.md).
+
+const ARN_SUFFIX = ":http://internal.amazon.com/coral/com.amazon.bedrock/";
+
+function bedrockHttpError(
+	statusCode: number,
+	errorType: string,
+	message: string,
+	extraHeaders: Record<string, string> = {},
+) {
+	return new APICallError({
+		message,
+		url: "https://bedrock-runtime.us-east-1.amazonaws.com/model/m/converse-stream",
+		requestBodyValues: {},
+		statusCode,
+		responseHeaders: {
+			"x-amzn-errortype": `${errorType}${ARN_SUFFIX}`,
+			...extraHeaders,
+		},
+		responseBody: JSON.stringify({ message }),
+		isRetryable: statusCode === 429 || statusCode >= 500,
+	});
+}
+
+function retryError(last: Error, attempts: number) {
+	// A sustained outage fails every attempt the same way.
+	const earlier = Array.from({ length: attempts - 1 }, () => last);
+	return new RetryError({
+		message: `Failed after ${attempts} attempts. Last error: ${last.message}`,
+		reason: "maxRetriesExceeded",
+		errors: [...earlier, last],
+	});
+}
+
+describe("describeProviderError", () => {
+	describe("APICallError with a status code", () => {
+		it("reads the AWS exception name from x-amzn-errortype and counts the attempts of a RetryError", () => {
+			const last = bedrockHttpError(
+				503,
+				"ServiceUnavailableException",
+				"The service isn't currently available. Retry your request.",
+			);
+			const error = retryError(last, 6);
+			expect(describeProviderError(error)).toEqual({
+				errorName: "ServiceUnavailableException",
+				statusCode: 503,
+				isRetryable: true,
+				attempts: 6,
+			});
+			// The display message the ACP error already carried does not change.
+			expect(extractErrorMessage(error)).toBe(
+				"The service isn't currently available. Retry your request.",
+			);
+		});
+
+		it("keeps ModelNotReadyException apart from ThrottlingException on the same status", () => {
+			const notReady = bedrockHttpError(
+				429,
+				"ModelNotReadyException",
+				"The model is not ready to serve inference requests. Wait and try again.",
+			);
+			const throttled = bedrockHttpError(
+				429,
