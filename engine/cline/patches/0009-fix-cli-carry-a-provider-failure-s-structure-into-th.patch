diff --git a/sdk/packages/llms/src/providers/ai-sdk.error-details.test.ts b/sdk/packages/llms/src/providers/ai-sdk.error-details.test.ts
new file mode 100644
index 0000000..f530d16
--- /dev/null
+++ b/sdk/packages/llms/src/providers/ai-sdk.error-details.test.ts
@@ -0,0 +1,176 @@
+import type { AgentMessage, AgentModelEvent } from "@cline/shared";
+import { APICallError, RetryError } from "ai";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { createGateway } from "./gateway";
+
+// Harness patch 0011: the model boundary keeps the structure of a provider failure on the `finish`
+// event (`errorDetails`) and reports Bedrock's stopReason model_context_window_exceeded as an error
+// instead of a clean stop. Shapes are the ones the pinned fork saw against a local fake Bedrock.
+
+const streamTextSpy = vi.fn();
+
+vi.mock("ai", async (importOriginal) => {
+	const actual = await importOriginal<typeof import("ai")>();
+	return {
+		...actual,
+		streamText: (input: unknown) => streamTextSpy(input),
+	};
+});
+
+vi.mock("@ai-sdk/openai", () => ({
+	createOpenAI: () => ({
+		responses: (modelId: string) => ({ modelId, family: "openai" }),
+	}),
+}));
+
+async function* parts(items: unknown[]) {
+	for (const item of items) {
+		yield item;
+	}
+}
+
+async function collect(
+	iterable: AsyncIterable<AgentModelEvent>,
+): Promise<AgentModelEvent[]> {
+	const events: AgentModelEvent[] = [];
+	for await (const event of iterable) {
+		events.push(event);
+	}
+	return events;
+}
+
+const messages: AgentMessage[] = [
+	{
+		id: "user_1",
+		role: "user",
+		content: [{ type: "text", text: "Hello" }],
+		createdAt: Date.now(),
+	},
+];
+
+async function run(streamParts: unknown[]): Promise<AgentModelEvent[]> {
+	streamTextSpy.mockReturnValue({ fullStream: parts(streamParts) });
+	const gateway = createGateway({
+		providerConfigs: [{ providerId: "openai-native", apiKey: "test" }],
+	});
+	return await collect(
+		await gateway.stream({
+			providerId: "openai-native",
+			modelId: "gpt-5-mini",
+			messages,
+		}),
+	);
+}
+
+beforeEach(() => {
+	streamTextSpy.mockReset();
+});
+
+describe("finish event error details", () => {
+	it("carries the AWS exception name, status and attempts of an exhausted request-start retry", async () => {
+		const last = new APICallError({
+			message: "The service isn't currently available. Retry your request.",
+			url: "https://bedrock-runtime.us-east-1.amazonaws.com/model/m/converse-stream",
+			requestBodyValues: {},
+			statusCode: 503,
+			responseHeaders: {
+				"x-amzn-errortype":
+					"ServiceUnavailableException:http://internal.amazon.com/coral/com.amazon.bedrock/",
+			},
+			isRetryable: true,
+		});
+		const error = new RetryError({
+			message: `Failed after 6 attempts. Last error: ${last.message}`,
+			reason: "maxRetriesExceeded",
+			errors: [1, 2, 3, 4, 5].map(() => last).concat(last),
+		});
+		const events = await run([{ type: "error", error }]);
+		expect(events.at(-1)).toMatchObject({
+			type: "finish",
+			reason: "error",
+			error: "The service isn't currently available. Retry your request.",
+			// The turn-level retry stays off: the SDK already spent its retries.
+			errorRetryable: false,
+			errorDetails: {
+				errorName: "ServiceUnavailableException",
+				statusCode: 503,
+				isRetryable: true,
+				attempts: 6,
+				phase: "request",
+			},
+		});
+	});
+
+	it("marks a failure after visible output as a stream failure", async () => {
+		const error = Object.assign(
+			new Error("stream failed after the first chunk"),
+			{
+				statusCode: 503,
+				isRetryable: true,
+			},
+		);
+		const events = await run([
+			{ type: "text-delta", text: "partial answer" },
+			{ type: "error", error },
+		]);
+		expect(events.at(-1)).toMatchObject({
+			type: "finish",
+			reason: "error",
+			errorDetails: { statusCode: 503, phase: "stream" },
+		});
+	});
+
+	it("carries no details for a failure with no structure", async () => {
+		const events = await run([
+			{ type: "error", error: new Error("Invalid API key") },
+		]);
+		const finish = events.at(-1) as Record<string, unknown>;
+		expect(finish).toMatchObject({ reason: "error", error: "Invalid API key" });
+		expect(finish.errorDetails).toBeUndefined();
+	});
+});
+
+describe("stopReason model_context_window_exceeded", () => {
+	it("ends the turn as a context-window error instead of a clean stop", async () => {
+		const events = await run([
+			{ type: "text-delta", text: "partial answer" },
+			{
+				type: "finish",
+				finishReason: "other",
+				rawFinishReason: "model_context_window_exceeded",
+				usage: { inputTokens: 1_000_000, outputTokens: 4 },
+			},
+		]);
+		expect(events.at(-1)).toEqual({
+			type: "finish",
+			reason: "error",
+			error:
+				"Model reached the context window limit before completing the turn",
+			errorClass: "context_window_exceeded",
+			errorRetryable: false,
+			errorDetails: {
+				errorName: "ModelContextWindowExceeded",
+				stopReason: "model_context_window_exceeded",
+				isRetryable: false,
+				phase: "stop",
+			},
+		});
+	});
+
+	it("leaves an ordinary end_turn finish alone", async () => {
+		const events = await run([
+			{ type: "text-delta", text: "done" },
+			{
+				type: "finish",
+				finishReason: "stop",
+				rawFinishReason: "end_turn",
+				usage: { inputTokens: 10, outputTokens: 1 },
+			},
+		]);
+		const finish = events.at(-1) as Record<string, unknown>;
+		expect(finish.type).toBe("finish");
+		expect(finish.reason).toBe("stop");
+		expect(finish.error).toBeUndefined();
+		expect(finish.errorDetails).toBeUndefined();
+	});
+});
