  * as it forwards them across the event boundary, so `instanceof` alone fails on
  * the object ACP actually receives.
  */
-function toAcpPromptError(error: Error): RequestError {
+function toAcpPromptError(
+	error: Error,
+	info?: {
+		errorClass?: ProviderErrorClass;
+		details?: ProviderErrorDetails;
+	},
+): RequestError {
 	if (isClineOrgIndividualInferenceSubscriptionErrorMessage(error)) {
 		const message = getAcpOrgSubscriptionMessage();
 		return RequestError.internalError({ message }, message);
 	}
 
 	const message = describeAgentError(error);
+	const data = providerErrorData(message, info);
 	const isAuthProblem = isLikelyAuthError(error);
 	return isAuthProblem
-		? RequestError.authRequired({ message }, message)
-		: RequestError.internalError({ message }, message);
+		? RequestError.authRequired(data, message)
+		: RequestError.internalError(data, message);
+}
+
+/**
+ * The JSON-RPC error `data` of a failed prompt: the unchanged `message`, then the
+ * structure of the provider failure (harness patch 0011) so a client reads the AWS
+ * exception name, HTTP status, retry-after and attempts instead of matching text:
+ * `errorName`, `statusCode`, `isRetryable`, `retryAfterS`, `attempts`, `code`,
+ * `stopReason`, `phase`, and `errorClass` when it is not `unknown`. A failure
+ * with no structure keeps `{ message }`.
+ */
+function providerErrorData(
+	message: string,
+	info?: { errorClass?: ProviderErrorClass; details?: ProviderErrorDetails },
+): Record<string, unknown> {
+	const data: Record<string, unknown> = { message };
+	const details = info?.details;
+	if (details) {
+		for (const key of [
+			"errorName",
+			"statusCode",
+			"isRetryable",
+			"retryAfterS",
+			"attempts",
+			"code",
+			"stopReason",
+			"phase",
+		] as const) {
+			if (details[key] !== undefined) {
+				data[key] = details[key];
+			}
+		}
+	}
+	if (info?.errorClass && info.errorClass !== "unknown") {
+		data.errorClass = info.errorClass;
+	}
+	return data;
 }
 
 async function buildProviderConfigOption(
