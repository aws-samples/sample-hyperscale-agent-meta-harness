@@ -0,0 +1,246 @@
+import type {
+	AgentModel,
+	AgentModelEvent,
+	AgentModelRequest,
+	AgentRuntimeEvent,
+} from "@cline/shared";
+import { describe, expect, it, vi } from "vitest";
+import { AgentRuntime } from "./index";
+
+// Harness patch 0011: the run-failed event carries the structure of the provider failure that ended
+// the run (AWS exception name, HTTP status, retryability, attempts), whether the failure came in on
+// the model's finish event or was thrown from the prepareTurn pipeline (the compaction summary call).
+
+class ScriptedModel implements AgentModel {
+	public readonly requests: AgentModelRequest[] = [];
+
+	constructor(
+		private readonly steps: Array<
+			(request: AgentModelRequest) => Iterable<AgentModelEvent>
+		>,
+	) {}
+
+	async stream(
+		request: AgentModelRequest,
+	): Promise<AsyncIterable<AgentModelEvent>> {
+		this.requests.push(request);
+		const step = this.steps.shift();
+		if (!step) {
+			throw new Error("No scripted model step available");
+		}
+		const events = step(request);
+		return (async function* () {
+			for (const event of events) {
+				yield event;
+			}
+		})();
+	}
+}
+
+type RunFailed = Extract<AgentRuntimeEvent, { type: "run-failed" }>;
+
+async function runFailed(
+	runtime: AgentRuntime,
+	prompt = "Hi",
+): Promise<RunFailed> {
+	const seen: RunFailed[] = [];
+	runtime.subscribe((event) => {
+		if (event.type === "run-failed") {
+			seen.push(event);
+		}
+	});
+	const result = await runtime.run(prompt);
+	expect(result.status).toBe("failed");
+	expect(seen).toHaveLength(1);
+	return seen[0] as RunFailed;
+}
+
+const SERVICE_DOWN = {
+	errorName: "ServiceUnavailableException",
+	statusCode: 503,
+	isRetryable: true,
+	attempts: 6,
+};
+
+describe("run-failed error details", () => {
+	it("carries the details of the finish event that ended the run", async () => {
+		const model = new ScriptedModel([
+			() => [
+				{
+					type: "finish",
+					reason: "error",
+					error: "The service isn't currently available. Retry your request.",
+					errorClass: "unknown",
+					errorRetryable: false,
+					errorDetails: SERVICE_DOWN,
+				},
+			],
+		]);
+		const event = await runFailed(new AgentRuntime({ model }));
+		expect(event.error.message).toBe(
+			"The service isn't currently available. Retry your request.",
+		);
+		expect(event.errorDetails).toEqual(SERVICE_DOWN);
+	});
+
+	it("describes an error thrown from prepareTurn, the compaction summary call, by its own structure", async () => {
+		// The AI SDK's error shapes by their fields: the agents package does not depend on `ai`.
+		const last = Object.assign(
+			new Error("The service isn't currently available. Retry your request."),
+			{
+				name: "AI_APICallError",
+				statusCode: 503,
+				responseHeaders: {
+					"x-amzn-errortype": "ServiceUnavailableException:http://x/",
+				},
+				isRetryable: true,
+			},
+		);
+		const thrown = Object.assign(
+			new Error(`Failed after 3 attempts. Last error: ${last.message}`),
+			{
+				name: "AI_RetryError",
+				reason: "maxRetriesExceeded",
+				errors: [last, last, last],
+				lastError: last,
+			},
+		);
+		const model = new ScriptedModel([
+			() => [
+				{ type: "text-delta", text: "never reached" },
+				{ type: "finish", reason: "stop" },
+			],
+		]);
+		const prepareTurn = vi.fn(async () => {
+			throw thrown;
+		});
+		const event = await runFailed(new AgentRuntime({ model, prepareTurn }));
+		expect(model.requests).toHaveLength(0);
+		expect(event.errorDetails).toEqual({
+			errorName: "ServiceUnavailableException",
+			statusCode: 503,
+			isRetryable: true,
+			attempts: 3,
+			phase: "compaction",
+		});
+	});
+
+	it("ends the turn at a context-window stop reason without replaying it", async () => {
+		const details = {
+			errorName: "ModelContextWindowExceeded",
+			stopReason: "model_context_window_exceeded",
+			isRetryable: false,
+			phase: "stop" as const,
+		};
+		const model = new ScriptedModel([
+			() => [
+				{ type: "text-delta", text: "partial answer" },
+				{
+					type: "finish",
+					reason: "error",
+					error:
+						"Model reached the context window limit before completing the turn",
+					errorClass: "context_window_exceeded",
+					errorRetryable: false,
+					errorDetails: details,
+				},
+			],
+		]);
+		const prepareTurn = vi.fn(async () => undefined);
+		const event = await runFailed(new AgentRuntime({ model, prepareTurn }));
+		// One request, one ordinary prepareTurn: no forced compaction, no retry.
+		expect(model.requests).toHaveLength(1);
+		expect(prepareTurn).toHaveBeenCalledTimes(1);
+		expect(event.errorClass).toBe("context_window_exceeded");
+		expect(event.errorDetails).toEqual(details);
+	});
+
+	it("describes a summary-call failure by the details it carries, as a compaction failure", async () => {
+		// The compaction summary call goes through the legacy stream API, which flattens the failure to a
+		// message; the summariser rethrows it as an Error that carries the details of the finish event.
+		const thrown = Object.assign(
+			new Error("The service isn't currently available. Retry your request."),
+			{
+				errorDetails: {
+					errorName: "ServiceUnavailableException",
+					statusCode: 503,
+					isRetryable: true,
+					attempts: 6,
+					phase: "request" as const,
+				},
+			},
+		);
+		const model = new ScriptedModel([
+			() => [{ type: "finish", reason: "stop" }],
+		]);
+		const prepareTurn = vi.fn(async () => {
+			throw thrown;
+		});
+		const event = await runFailed(new AgentRuntime({ model, prepareTurn }));
+		expect(model.requests).toHaveLength(0);
+		expect(event.errorDetails).toEqual({
+			errorName: "ServiceUnavailableException",
+			statusCode: 503,
+			isRetryable: true,
+			attempts: 6,
+			phase: "compaction",
+		});
+	});
+
+	it("keeps the rejection's details when a window overflow cannot be compacted", async () => {
+		const details = {
+			errorName: "ValidationException",
+			statusCode: 400,
+			isRetryable: false,
+			phase: "request" as const,
+		};
+		const model = new ScriptedModel([
+			() => [
+				{
+					type: "finish",
+					reason: "error",
+					error: "Input is too long for requested model.",
+					errorClass: "context_window_exceeded",
+					errorRetryable: false,
+					errorDetails: details,
+				},
+			],
+		]);
+		// prepareTurn never shrinks the transcript: nothing to compact.
