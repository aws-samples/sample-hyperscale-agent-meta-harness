@@ -0,0 +1,265 @@
+// Wire-contract tests for the Bedrock vendor's Mantle route, exercised through
+// the *real* `@ai-sdk/amazon-bedrock/mantle` package rather than a mocked
+// constructor. Each test drives `doStream` through the vendor module with a
+// stubbed fetch and asserts on the actual HTTP request, so a regression in
+// routing, signing, endpoint selection or parameter filtering is caught here:
+//
+//   1. an `aws-mantle/` model id reaches `bedrock-mantle.<region>.api.aws`
+//      with the prefix removed from the request body;
+//   2. the request is signed with SigV4 for service `bedrock-mantle` using
+//      the role credentials, and an ambient `AWS_BEARER_TOKEN_BEDROCK` is not
+//      sent under IAM auth;
+//   3. OpenAI reasoning models on Mantle get no `temperature` and use
+//      `max_completion_tokens`, while models that declare temperature keep it;
+//   4. `mantleApi: "responses"` selects the Responses endpoint.
+import type {
+	LanguageModelV4,
+	LanguageModelV4CallOptions,
+	LanguageModelV4StreamPart,
+} from "@ai-sdk/provider";
+import type { GatewayResolvedProviderConfig } from "@cline/shared";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { createBedrockProviderModule } from "./bedrock";
+
+interface CapturedRequest {
+	url: string;
+	headers: Headers;
+	body: Record<string, unknown>;
+}
+
+const ROLE_CREDENTIALS = {
+	accessKeyId: "ASIAEXAMPLEROLEKEY",
+	secretAccessKey: "role-secret-access-key",
+	sessionToken: "role-session-token",
+};
+
+const CHAT_STREAM = [
+	{
+		id: "chatcmpl-1",
+		object: "chat.completion.chunk",
+		created: 1,
+		model: "wire-model",
+		choices: [
+			{
+				index: 0,
+				delta: { role: "assistant", content: "ok" },
+				finish_reason: null,
+			},
+		],
+	},
+	{
+		id: "chatcmpl-1",
+		object: "chat.completion.chunk",
+		created: 1,
+		model: "wire-model",
+		choices: [{ index: 0, delta: {}, finish_reason: "stop" }],
+		usage: { prompt_tokens: 11, completion_tokens: 1, total_tokens: 12 },
+	},
+];
+
+function sseBody(events: readonly unknown[]): string {
+	return `${events.map((event) => `data: ${JSON.stringify(event)}\n\n`).join("")}data: [DONE]\n\n`;
+}
+
+async function streamThroughVendor(input: {
+	modelId: string;
+	options: Record<string, unknown>;
+	call?: Partial<LanguageModelV4CallOptions>;
+	/** Canned response per request URL; defaults to a two-chunk chat stream. */
+	respond?: (url: string) => Response;
+}): Promise<{
+	requests: CapturedRequest[];
+	parts: LanguageModelV4StreamPart[];
+}> {
+	const requests: CapturedRequest[] = [];
+	const fetchStub = (async (resource, init) => {
+		const url =
+			typeof resource === "string"
+				? resource
+				: resource instanceof URL
+					? resource.href
+					: resource.url;
+		requests.push({
+			url,
+			headers: new Headers(init?.headers),
+			body: JSON.parse(String(init?.body)),
+		});
+		return (
+			input.respond?.(url) ??
+			new Response(sseBody(CHAT_STREAM), {
+				status: 200,
+				headers: { "content-type": "text/event-stream" },
+			})
+		);
+	}) as typeof fetch;
+
+	const module = await createBedrockProviderModule(
+		config({ options: input.options, fetch: fetchStub }),
+	);
+	const model = module.operations.language(input.modelId) as LanguageModelV4;
+	const { stream } = await model.doStream({
+		prompt: [{ role: "user", content: [{ type: "text", text: "hi" }] }],
+		...input.call,
+	});
+	const parts: LanguageModelV4StreamPart[] = [];
+	const reader = stream.getReader();
+	for (;;) {
+		const { done, value } = await reader.read();
+		if (done) break;
+		parts.push(value);
+	}
+	return { requests, parts };
+}
+
+const ORIGINAL_ENV = { ...process.env };
+
+describe("Bedrock Mantle wire contract", () => {
+	beforeEach(() => {
+		process.env = { ...ORIGINAL_ENV };
+		delete process.env.AWS_REGION;
+		delete process.env.AWS_DEFAULT_REGION;
+		delete process.env.AWS_ACCESS_KEY_ID;
+		delete process.env.AWS_SECRET_ACCESS_KEY;
+		delete process.env.AWS_SESSION_TOKEN;
+	});
+
+	afterEach(() => {
+		process.env = { ...ORIGINAL_ENV };
+	});
+
+	it("signs chat requests to bedrock-mantle.<region>.api.aws with SigV4 role credentials, never the ambient bearer token", async () => {
+		process.env.AWS_BEARER_TOKEN_BEDROCK = "ambient-bearer-token";
+
+		const { requests, parts } = await streamThroughVendor({
+			modelId: "aws-mantle/qwen.qwen3-coder-next",
+			options: {
+				authentication: "iam",
+				region: "us-west-2",
+				credentialProvider: async () => ROLE_CREDENTIALS,
+			},
+		});
+
+		expect(requests).toHaveLength(1);
+		const [request] = requests;
+		expect(request?.url).toBe(
+			"https://bedrock-mantle.us-west-2.api.aws/v1/chat/completions",
+		);
+		expect(request?.body.model).toBe("qwen.qwen3-coder-next");
+		const authorization = request?.headers.get("authorization") ?? "";
+		expect(authorization).toMatch(
+			/^AWS4-HMAC-SHA256 Credential=ASIAEXAMPLEROLEKEY\/\d{8}\/us-west-2\/bedrock-mantle\/aws4_request, SignedHeaders=/,
+		);
+		expect(authorization).not.toContain("ambient-bearer-token");
+		expect(request?.headers.get("x-amz-security-token")).toBe(
+			"role-session-token",
+		);
+		expect(
+			parts.some((part) => part.type === "text-delta" && part.delta === "ok"),
+		).toBe(true);
+	});
+
+	it("drops temperature and sends max_completion_tokens for OpenAI reasoning models", async () => {
+		const { requests } = await streamThroughVendor({
+			modelId: "aws-mantle/openai.gpt-5.5",
+			options: {
+				authentication: "iam",
+				region: "us-east-2",
+				credentialProvider: async () => ROLE_CREDENTIALS,
+			},
+			call: { temperature: 0.2, maxOutputTokens: 256 },
+		});
+
+		const body = requests[0]?.body ?? {};
+		expect(requests[0]?.url).toBe(
+			"https://bedrock-mantle.us-east-2.api.aws/openai/v1/chat/completions",
+		);
+		expect(body.model).toBe("openai.gpt-5.5");
+		expect(body).not.toHaveProperty("temperature");
+		expect(body).not.toHaveProperty("max_tokens");
+		expect(body.max_completion_tokens).toBe(256);
+	});
+
+	it("keeps temperature for Mantle models whose catalog entry declares it", async () => {
+		const { requests } = await streamThroughVendor({
+			modelId: "aws-mantle/qwen.qwen3-coder-next",
+			options: {
+				authentication: "iam",
+				region: "us-west-2",
+				credentialProvider: async () => ROLE_CREDENTIALS,
+			},
+			call: { temperature: 0.2, maxOutputTokens: 256 },
+		});
+
+		const body = requests[0]?.body ?? {};
+		expect(body.temperature).toBe(0.2);
+		expect(body.max_tokens).toBe(256);
+	});
+
+	it("re-signs and retries on /openai/v1 when Mantle rejects the /v1 route", async () => {
+		const routeError = JSON.stringify({
+			error: {
+				code: "validation_error",
+				message: "model `acme.future-1` isn't supported on this route",
+				param: null,
+				type: "invalid_request_error",
+			},
+		});
+		const { requests, parts } = await streamThroughVendor({
+			modelId: "aws-mantle/acme.future-1",
+			options: {
+				authentication: "iam",
+				region: "us-west-2",
+				credentialProvider: async () => ROLE_CREDENTIALS,
+			},
+			respond: (url) =>
+				url.includes("/openai/v1/")
+					? new Response(sseBody(CHAT_STREAM), {
+							status: 200,
+							headers: { "content-type": "text/event-stream" },
+						})
+					: new Response(routeError, {
+							status: 400,
+							headers: { "content-type": "application/json" },
+						}),
+		});
+
+		expect(requests.map((request) => request.url)).toEqual([
+			"https://bedrock-mantle.us-west-2.api.aws/v1/chat/completions",
+			"https://bedrock-mantle.us-west-2.api.aws/openai/v1/chat/completions",
+		]);
+		for (const request of requests) {
+			expect(request.headers.get("authorization")).toMatch(
+				/^AWS4-HMAC-SHA256 Credential=ASIAEXAMPLEROLEKEY\/\d{8}\/us-west-2\/bedrock-mantle\/aws4_request/,
+			);
+		}
+		expect(
+			parts.some((part) => part.type === "text-delta" && part.delta === "ok"),
+		).toBe(true);
+	});
+
+	it("selects the Mantle Responses endpoint when mantleApi is responses", async () => {
+		const { requests } = await streamThroughVendor({
+			modelId: "aws-mantle/openai.gpt-5.5",
+			options: {
+				authentication: "iam",
+				region: "us-east-2",
+				mantleApi: "responses",
+				credentialProvider: async () => ROLE_CREDENTIALS,
+			},
+		});
+
+		expect(requests[0]?.url).toBe(
+			"https://bedrock-mantle.us-east-2.api.aws/openai/v1/responses",
+		);
+		expect(requests[0]?.body.model).toBe("openai.gpt-5.5");
+	});
+});
+
+function config(
+	overrides: Partial<GatewayResolvedProviderConfig>,
+): GatewayResolvedProviderConfig {
+	return {
+		providerId: "bedrock",
+		...overrides,
+	};
+}
