+		id,
+		name: id,
+		contextWindow: 128_000,
+		maxTokens: 8_192,
+		capabilities,
+		...(metadata ? { metadata } : {}),
+	};
+}
+
+async function callMantleModel(
+	model: unknown,
+	options: Partial<LanguageModelV4CallOptions>,
+): Promise<LanguageModelV4CallOptions> {
+	const wrapped = model as LanguageModelV4;
+	await wrapped.doGenerate({
+		prompt: [{ role: "user", content: [{ type: "text", text: "hi" }] }],
+		...options,
+	});
+	const inner = mantleLastModel();
+	const received = inner?.calls.at(-1);
+	if (!received) {
+		throw new Error("Mantle model was not called");
+	}
+	return received;
+}
