@@ -0,0 +1,76 @@
+import type { GatewayStreamRequest } from "@cline/shared";
+
+/**
+ * Tool call ids for one model response.
+ *
+ * Some models number their calls from zero in every response (GLM 5.3 on
+ * Bedrock sends call_0, call_1, ... each turn), so the id of an early call
+ * repeats across turns. ACP asks for a toolCallId that is unique in the
+ * session and clients key tool calls by it, so the adapter keeps the id the
+ * model chose until an earlier call of the conversation already owns it, then
+ * adds the smallest numeric suffix that is free (call_0-2, call_0-3, ...). The
+ * suffix uses only characters Bedrock accepts in a toolUseId ([a-zA-Z0-9_-],
+ * 64 characters at most; a longer raw id is cut to make room for the suffix),
+ * and the new id is what the conversation history carries from then on, so a
+ * toolUse and its toolResult still match. One raw id maps to one result within
+ * a response.
+ *
+ * "Owns" means the id appears in the request's message history or was handed
+ * out earlier in the same session (`metadata.sessionId`): compaction can drop
+ * an earlier call from the history while an ACP client still shows it, and a
+ * retried request must not reuse the ids of the attempt before it. The session
+ * table holds the most recent sessions only.
+ */
+const MAX_TOOL_CALL_ID_LENGTH = 64;
+const MAX_TRACKED_SESSIONS = 128;
+const sessionToolCallIds = new Map<string, Set<string>>();
+
+function sessionIds(sessionId: string): Set<string> {
+	const known = sessionToolCallIds.get(sessionId) ?? new Set<string>();
+	sessionToolCallIds.delete(sessionId);
+	sessionToolCallIds.set(sessionId, known);
+	while (sessionToolCallIds.size > MAX_TRACKED_SESSIONS) {
+		const oldest = sessionToolCallIds.keys().next().value;
+		if (oldest === undefined) {
+			break;
+		}
+		sessionToolCallIds.delete(oldest);
+	}
+	return known;
+}
+
+export function createToolCallIdAllocator(
+	messages: GatewayStreamRequest["messages"],
+	sessionId?: string,
+): (rawId: string) => string {
+	const used =
+		sessionId !== undefined ? sessionIds(sessionId) : new Set<string>();
+	for (const message of messages) {
+		if (!Array.isArray(message.content)) {
+			continue;
+		}
+		for (const part of message.content) {
+			if (
+				(part.type === "tool-call" || part.type === "tool-result") &&
+				typeof part.toolCallId === "string"
+			) {
+				used.add(part.toolCallId);
+			}
+		}
+	}
+	const assigned = new Map<string, string>();
+	return (rawId) => {
+		const known = assigned.get(rawId);
+		if (known !== undefined) {
+			return known;
+		}
+		let id = rawId;
+		for (let n = 2; used.has(id); n++) {
+			const suffix = `-${n}`;
+			id = `${rawId.slice(0, Math.max(1, MAX_TOOL_CALL_ID_LENGTH - suffix.length))}${suffix}`;
+		}
+		used.add(id);
+		assigned.set(rawId, id);
+		return id;
+	};
+}
