@@ -0,0 +1,250 @@
+// Provider-option rule for GLM 5.3 on Bedrock Converse (`us.zai.glm-5.3`,
+// `global.zai.glm-5.3`). The model cannot turn reasoning off and takes its
+// effort as `additionalModelRequestFields.reasoning_effort` (low, medium, high,
+// xhigh, max; live Bedrock rejects none and minimal). Before this rule the
+// only GLM rule wrote a top-level `reasoning: {exclude: true}` that Bedrock
+// ignores, so the model ran at its default (about max) effort and the portable
+// level was dropped by the AI SDK with a warning.
+import type {
+	GatewayProviderContext,
+	GatewayStreamRequest,
+	ModelReasoningOption,
+} from "@cline/shared";
+import { describe, expect, it } from "vitest";
+import { BEDROCK_ROUTING_METADATA } from "./bedrock-cache-point";
+import {
+	hasNativeReasoningControls,
+	reconcilePortableReasoning,
+	resolvePortableReasoning,
+} from "./portable-reasoning";
+import { composeAiSdkProviderOptions } from "./provider-options";
+
+// The ladder live Bedrock accepts for GLM 5.3 (audit 2026-10-13).
+const LADDER: readonly ModelReasoningOption[] = [
+	{ type: "effort", values: ["low", "medium", "high", "xhigh", "max"] },
+];
+// What the upstream generated catalog advertised before the override.
+const UPSTREAM_LADDER: readonly ModelReasoningOption[] = [
+	{ type: "effort", values: ["none", "low", "high", "max"] },
+];
+
+function context(
+	modelId: string,
+	reasoningOptions: readonly ModelReasoningOption[] | undefined = LADDER,
+): GatewayProviderContext {
+	return {
+		provider: {
+			id: "bedrock",
+			name: "bedrock",
+			defaultModelId: modelId,
+			models: [
+				{ id: modelId, name: modelId, providerId: "bedrock", capabilities: [] },
+			],
+			metadata: BEDROCK_ROUTING_METADATA,
+		},
+		model: {
+			id: modelId,
+			name: modelId,
+			providerId: "bedrock",
+			capabilities: ["tools", "reasoning"],
+			reasoningOptions,
+			metadata: { family: "glm" },
+		},
+		config: { providerId: "bedrock" },
+	};
+}
+
+function request(
+	modelId: string,
+	reasoning: GatewayStreamRequest["reasoning"],
+): GatewayStreamRequest {
+	return {
+		providerId: "bedrock",
+		modelId,
+		reasoning,
+		messages: [
+			{
+				id: "m1",
+				role: "user",
+				content: [{ type: "text", text: "hi" }],
+				createdAt: 0,
+			},
+		],
+	};
+}
+
+function bedrockOptions(
+	modelId: string,
+	reasoning: GatewayStreamRequest["reasoning"],
+	options?: readonly ModelReasoningOption[],
+): Record<string, unknown> {
+	const composed = composeAiSdkProviderOptions(
+		request(modelId, reasoning),
+		context(modelId, options),
+		"bedrock",
+	);
+	return (composed.bedrock ?? {}) as Record<string, unknown>;
+}
+
+const IDS = ["us.zai.glm-5.3", "global.zai.glm-5.3"] as const;
+
+describe("GLM 5.3 on Bedrock Converse reasoning effort", () => {
+	for (const modelId of IDS) {
+		for (const effort of ["low", "medium", "high", "xhigh", "max"] as const) {
+			it(`sends reasoning_effort ${effort} for ${modelId}`, () => {
+				const bedrock = bedrockOptions(modelId, { enabled: true, effort });
+				expect(bedrock.additionalModelRequestFields).toEqual({
+					reasoning_effort: effort,
+				});
+			});
+		}
+
+		it(`never writes the no-op top-level reasoning key for ${modelId}`, () => {
+			// With the upstream ladder (a "none" level) the generic GLM rule wrote
+			// reasoning: {exclude: true} or {enabled: true} into the bedrock bucket.
+			for (const ladder of [LADDER, UPSTREAM_LADDER]) {
+				for (const reasoning of [
+					undefined,
+					{ enabled: false },
+					{ enabled: true },
+					{ enabled: true, effort: "high" as const },
+				]) {
+					const composed = composeAiSdkProviderOptions(
+						request(modelId, reasoning),
+						context(modelId, ladder),
+						"bedrock",
+					);
+					expect(composed.bedrock).not.toHaveProperty("reasoning");
+					expect(composed.openaiCompatible ?? {}).not.toHaveProperty(
+						"reasoning",
+					);
+				}
+			}
+		});
+
+		it(`maps a disable request to the lowest effort for ${modelId} (the model cannot turn reasoning off)`, () => {
+			// With the corrected ladder a disable is normalized away, with the
+			// upstream ladder it arrives as enabled:false; both give low.
+			expect(
+				bedrockOptions(modelId, { enabled: false })
+					.additionalModelRequestFields,
+			).toEqual({ reasoning_effort: "low" });
+			expect(
+				bedrockOptions(modelId, { enabled: false }, UPSTREAM_LADDER)
+					.additionalModelRequestFields,
+			).toEqual({ reasoning_effort: "low" });
+		});
+
+		it(`sends the default effort low when no reasoning is requested for ${modelId}`, () => {
+			expect(
+				bedrockOptions(modelId, undefined).additionalModelRequestFields,
+			).toEqual({ reasoning_effort: "low" });
+		});
+
+		it(`sends medium when reasoning is enabled without a level for ${modelId}`, () => {
+			expect(
+				bedrockOptions(modelId, { enabled: true }).additionalModelRequestFields,
+			).toEqual({ reasoning_effort: "medium" });
+		});
+
+		it(`drops the portable level so the AI SDK does not warn for ${modelId}`, () => {
+			const req = request(modelId, { enabled: true, effort: "high" });
+			const ctx = context(modelId);
+			const composed = composeAiSdkProviderOptions(req, ctx, "bedrock");
+			const portable = resolvePortableReasoning(req, {
+				adapter: "bedrock",
+				context: ctx,
+			});
+			expect(portable).toBe("high");
+			expect(reconcilePortableReasoning(portable, composed)).toBeUndefined();
+		});
+	}
+
+	it("maps minimal to low, with the corrected and the upstream ladder", () => {
+		for (const ladder of [LADDER, UPSTREAM_LADDER, undefined]) {
+			expect(
+				bedrockOptions(
+					"us.zai.glm-5.3",
+					{ enabled: true, effort: "minimal" },
+					ladder,
+				).additionalModelRequestFields,
+			).toEqual({ reasoning_effort: "low" });
+		}
+	});
+
+	it("matches exactly the bare, us. and global. ids", () => {
+		// Other geo prefixes and padded ids are not GLM 5.3 profiles; they keep
+		// the generic shape and gain no reasoning_effort.
+		for (const modelId of [
+			"eu.zai.glm-5.3",
+			"apac.zai.glm-5.3",
+			"us-gov.zai.glm-5.3",
+			" us.zai.glm-5.3",
+			"us.zai.glm-5.3 ",
+			"us.zai.glm-5.30",
+		]) {
+			const composed = composeAiSdkProviderOptions(
+				request(modelId, { enabled: true, effort: "high" }),
+				context(modelId),
+				"bedrock",
+			);
+			expect(composed.bedrock ?? {}).not.toHaveProperty(
+				"additionalModelRequestFields",
+			);
+		}
+	});
+
+	it("counts only a nested reasoning_effort as a native reasoning control", () => {
+		expect(
+			hasNativeReasoningControls({
+				bedrock: { additionalModelRequestFields: { reasoning_effort: "low" } },
+			}),
+		).toBe(true);
+		expect(
+			hasNativeReasoningControls({
+				bedrock: { additionalModelRequestFields: { top_k: 5 } },
+			}),
+		).toBe(false);
+		expect(
+			hasNativeReasoningControls({
+				bedrock: { additionalModelRequestFields: {} },
+			}),
+		).toBe(false);
+	});
+
+	it("applies to the bare profile-only id too", () => {
+		expect(
+			bedrockOptions("zai.glm-5.3", { enabled: true, effort: "xhigh" })
+				.additionalModelRequestFields,
+		).toEqual({ reasoning_effort: "xhigh" });
+	});
+
+	it("leaves every other GLM route on its existing shape", () => {
+		// Mantle-routed GLM, other GLM versions and other providers keep the
+		// generic routed shape (or nothing) and never gain reasoning_effort.
+		for (const [providerId, modelId] of [
+			["bedrock", "aws-mantle/zai.glm-5"],
+			["bedrock", "us.zai.glm-5.2"],
+			["openrouter", "z-ai/glm-5.3"],
+			["openai-compatible", "glm-5.3"],
+		] as const) {
+			const req: GatewayStreamRequest = {
+				...request(modelId, { enabled: false }),
+				providerId,
+			};
+			const ctx = {
+				...context(modelId, undefined),
+				provider: { ...context(modelId).provider, id: providerId },
+				config: { providerId },
+			};
+			const composed = composeAiSdkProviderOptions(
+				req,
+				ctx,
+				providerId === "bedrock" ? "bedrock" : "openai-compatible",
+			);
+			for (const bucket of Object.values(composed)) {
+				expect(bucket).not.toHaveProperty("additionalModelRequestFields");
+			}
+		}
+	});
+});
