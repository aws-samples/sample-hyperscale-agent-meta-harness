@@ -0,0 +1,89 @@
+// Wire contract for GLM 5.3 on Bedrock Converse, through the real
+// `@ai-sdk/amazon-bedrock` adapter and the generated model catalog (no model
+// override): the Converse body carries `additionalModelRequestFields
+// .reasoning_effort` with a level Bedrock accepts and no top-level `reasoning`
+// key. Live Bedrock (acct-a01, 2026-10-13) accepts low, medium, high, xhigh and
+// max, rejects none and minimal, and defaults to about max when nothing is sent.
+import type { GatewayStreamRequest } from "@cline/shared";
+import { describe, expect, it } from "vitest";
+import { createGateway } from "../gateway";
+
+interface WireBody {
+	path: string | undefined;
+	body: Record<string, unknown>;
+}
+
+async function wire(
+	modelId: string,
+	reasoning: GatewayStreamRequest["reasoning"],
+): Promise<WireBody> {
+	let path: string | undefined;
+	let body: Record<string, unknown> = {};
+	const fetchStub = (async (input, init) => {
+		path = decodeURIComponent(new URL(String(input)).pathname);
+		body = JSON.parse((init?.body as string) ?? "{}");
+		return new Response(JSON.stringify({ message: "stub" }), {
+			status: 400,
+			headers: { "content-type": "application/json" },
+		});
+	}) as typeof fetch;
+	const gateway = createGateway({
+		providerConfigs: [
+			{
+				providerId: "bedrock",
+				apiKey: "test-bearer-key",
+				fetch: fetchStub,
+				options: { region: "us-east-1", authentication: "apikey" },
+			},
+		],
+	});
+	for await (const _event of await gateway.stream({
+		providerId: "bedrock",
+		modelId,
+		reasoning,
+		maxTokens: 64,
+		messages: [
+			{
+				id: "m1",
+				role: "user",
+				content: [{ type: "text", text: "hi" }],
+				createdAt: 0,
+			},
+		],
+	})) {
+		// drain
+	}
+	return { path, body };
+}
+
+describe("GLM 5.3 Bedrock Converse wire contract", () => {
+	it.each([
+		"us.zai.glm-5.3",
+		"global.zai.glm-5.3",
+	])("sends each level Bedrock accepts unchanged for %s", async (modelId) => {
+		for (const effort of ["low", "medium", "high", "xhigh", "max"] as const) {
+			const { path, body } = await wire(modelId, { enabled: true, effort });
+			expect(path).toBe(`/model/${modelId}/converse-stream`);
+			expect(body.additionalModelRequestFields).toEqual({
+				reasoning_effort: effort,
+			});
+			expect(body).not.toHaveProperty("reasoning");
+		}
+	});
+
+	it("sends low when the caller asks for reasoning off, never none", async () => {
+		const { body } = await wire("us.zai.glm-5.3", { enabled: false });
+		expect(body.additionalModelRequestFields).toEqual({
+			reasoning_effort: "low",
+		});
+		expect(body).not.toHaveProperty("reasoning");
+	});
+
+	it("sends the low default when the caller says nothing about reasoning", async () => {
+		const { body } = await wire("us.zai.glm-5.3", undefined);
+		expect(body.additionalModelRequestFields).toEqual({
+			reasoning_effort: "low",
+		});
+		expect(body).not.toHaveProperty("reasoning");
+	});
+});
