+import { BEDROCK_GLM_53_REASONING_OPTIONS } from "../providers/routing/bedrock-glm-effort";
+import type { ModelInfo } from "./types";
+
+/**
+ * Corrections the fork applies on top of the generated catalog
+ * (`catalog.generated.ts`, written by the model generation scripts from
+ * models.dev), so a regeneration does not undo them. Only fields that live
+ * checks showed to be wrong belong here; every entry names its evidence.
+ */
+const FORK_CATALOG_OVERRIDES: Readonly<
+	Record<string, Readonly<Record<string, Partial<ModelInfo>>>>
+> = {
+	bedrock: {
+		// models.dev lists efforts none, low, high, max; Bedrock accepts low,
+		// medium, high, xhigh and max and rejects none (live ConverseStream,
+		// acct-a01 us-east-1, 2026-10-13).
+		"us.zai.glm-5.3": { reasoningOptions: BEDROCK_GLM_53_REASONING_OPTIONS },
+		"global.zai.glm-5.3": {
+			reasoningOptions: BEDROCK_GLM_53_REASONING_OPTIONS,
+		},
+	},
+};
+
+export function applyForkCatalogOverrides(
+	providerId: string,
+	modelId: string,
+	model: ModelInfo,
+): ModelInfo {
+	const override = FORK_CATALOG_OVERRIDES[providerId]?.[modelId];
+	return override ? { ...model, ...override } : model;
+}
