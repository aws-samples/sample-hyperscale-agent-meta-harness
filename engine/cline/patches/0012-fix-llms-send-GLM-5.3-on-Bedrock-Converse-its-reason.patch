+/**
+ * Bedrock Converse carries model-specific reasoning in
+ * `additionalModelRequestFields.reasoning_effort` (GLM 5.3). The container
+ * holds unrelated fields too, so only the nested key counts.
+ */
+function hasBedrockReasoningEffortField(bucket: object): boolean {
+	const fields = (bucket as Record<string, unknown>)
+		.additionalModelRequestFields;
+	return !!fields && typeof fields === "object" && "reasoning_effort" in fields;
+}
+
