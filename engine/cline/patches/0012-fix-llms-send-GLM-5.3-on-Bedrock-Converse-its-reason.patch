@@ -0,0 +1,70 @@
+import type {
+	GatewayStreamRequest,
+	ModelReasoningOption,
+	ReasoningEffort,
+} from "@cline/shared";
+
+/**
+ * GLM 5.3 on Bedrock Converse (`zai.glm-5.3` behind the `us.` or `global.`
+ * inference profile; the model is profile-only and is not served by Mantle).
+ *
+ * Live Bedrock (acct-a01, 2026-10-13) takes the reasoning level as
+ * `additionalModelRequestFields.reasoning_effort` and accepts low, medium,
+ * high, xhigh and max. It rejects `none`, `minimal` and a disabled thinking
+ * block with HTTP 400 ("This model requires reasoning and cannot turn thinking
+ * off; use reasoning effort 'low' for the least reasoning"), and with no level
+ * it reasons at about max effort (856 output tokens against 159 at low on one
+ * prompt). The generic GLM rule writes a top-level `reasoning` field that
+ * Bedrock ignores, so this rule owns the model instead.
+ */
+const BEDROCK_GLM_53_MODEL_ID = /^(?:(?:us|global)\.)?zai\.glm-5\.3$/;
+
+export const BEDROCK_GLM_53_EFFORTS = [
+	"low",
+	"medium",
+	"high",
+	"xhigh",
+	"max",
+] as const satisfies readonly ReasoningEffort[];
+
+/** What the model gets when nobody asks for a level, and for a disable. */
+export const BEDROCK_GLM_53_DEFAULT_EFFORT = "low" as const;
+
+/**
+ * The catalog reasoning options of the model. The upstream generated catalog
+ * lists `none, low, high, max`; Bedrock rejects `none` and accepts the
+ * levels in between.
+ */
+export const BEDROCK_GLM_53_REASONING_OPTIONS: ModelReasoningOption[] = [
+	{ type: "effort", values: [...BEDROCK_GLM_53_EFFORTS] },
+];
+
+export function isBedrockGlm53ConverseModel(
+	request: Pick<GatewayStreamRequest, "providerId" | "modelId">,
+): boolean {
+	return (
+		request.providerId === "bedrock" &&
+		BEDROCK_GLM_53_MODEL_ID.test(request.modelId)
+	);
+}
+
+/**
+ * The level to send. A disable cannot be honored, so it becomes the lowest
+ * level; an unset request gets the default; reasoning enabled without a
+ * level gets medium, as for every other model.
+ */
+export function resolveBedrockGlm53Effort(
+	reasoning: GatewayStreamRequest["reasoning"],
+): (typeof BEDROCK_GLM_53_EFFORTS)[number] {
+	if (!reasoning || reasoning.enabled === false) {
+		return BEDROCK_GLM_53_DEFAULT_EFFORT;
+	}
+	const effort = reasoning.effort;
+	if (effort === "minimal") {
+		return "low";
+	}
+	if (effort && BEDROCK_GLM_53_EFFORTS.includes(effort as never)) {
+		return effort as (typeof BEDROCK_GLM_53_EFFORTS)[number];
+	}
+	return reasoning.enabled === true ? "medium" : BEDROCK_GLM_53_DEFAULT_EFFORT;
+}
