+import type { Usage } from "@agentclientprotocol/sdk";
+import type { ClineCore } from "@cline/core";
+
+/** Core usage totals; `inputTokens` includes cache reads and writes. */
+export interface CoreUsageTotals {
+	inputTokens: number;
+	outputTokens: number;
+	cacheReadTokens?: number;
+	cacheWriteTokens?: number;
+}
+
+function count(value: number | undefined): number {
+	return typeof value === "number" && Number.isFinite(value) && value > 0
+		? value
+		: 0;
+}
+
+/**
+ * The session's usage so far, primary agent plus spawned agents, or undefined
+ * when the core keeps no usage summary.
+ */
+export async function readSessionUsage(
+	core: Pick<ClineCore, "getAccumulatedUsage">,
+	sessionId: string,
+): Promise<CoreUsageTotals | undefined> {
+	try {
+		const summary = await core.getAccumulatedUsage(sessionId);
+		return summary?.aggregateUsage ?? summary?.usage;
+	} catch {
+		return undefined;
+	}
+}
+
+/** The tokens spent between two session usage readings. */
+export function usageSpent(
+	after: CoreUsageTotals,
+	before: CoreUsageTotals | undefined,
+): CoreUsageTotals {
+	const spent = (a: number | undefined, b: number | undefined) =>
+		Math.max(0, count(a) - count(b));
+	return {
+		inputTokens: spent(after.inputTokens, before?.inputTokens),
+		outputTokens: spent(after.outputTokens, before?.outputTokens),
+		cacheReadTokens: spent(after.cacheReadTokens, before?.cacheReadTokens),
+		cacheWriteTokens: spent(after.cacheWriteTokens, before?.cacheWriteTokens),
+	};
+}
+
+/**
+ * Core usage in the ACP `Usage` shape. ACP reports cache reads and writes
+ * apart from input, so `inputTokens` is the uncached remainder and
+ * `totalTokens` sums the four counts.
+ */
+export function toAcpUsage(totals: CoreUsageTotals): Usage {
+	const cachedReadTokens = count(totals.cacheReadTokens);
+	const cachedWriteTokens = count(totals.cacheWriteTokens);
+	const outputTokens = count(totals.outputTokens);
+	const inputTokens = Math.max(
+		0,
+		count(totals.inputTokens) - cachedReadTokens - cachedWriteTokens,
+	);
+	return {
+		inputTokens,
+		outputTokens,
+		cachedReadTokens,
+		cachedWriteTokens,
+		totalTokens:
+			inputTokens + outputTokens + cachedReadTokens + cachedWriteTokens,
+	};
+}
