+import { describe, expect, it } from "vitest";
+import {
+	isBedrockBlankKey,
+	stripBedrockBlankKeys,
+} from "./bedrock-tool-use-input";
+
+describe("isBedrockBlankKey", () => {
+	it("is true for the empty key and for keys made only of Java whitespace", () => {
+		for (const key of [
+			"",
+			" ",
+			"\t\n\r\u000b\f",
+			"\u001c\u001d\u001e\u001f",
+			"\u1680",
+			"\u2000\u2001\u2002\u2003\u2004\u2005\u2006",
+			"\u2008\u2009\u200a",
+			"\u2028\u2029",
+			"\u205f",
+			"\u3000",
+			" \u3000 ",
+		]) {
+			expect(isBedrockBlankKey(key), JSON.stringify(key)).toBe(true);
+		}
+	});
+
+	it("is false for a key with any other character, including no-break and zero-width spaces", () => {
+		for (const key of [
+			"a",
+			" a",
+			"a ",
+			"a b",
+			"\u00a0",
+			"\u2007",
+			"\u202f",
+			"\u200b",
+			"\ufeff",
+			"\u0085",
+			"\u0000",
+			"\u180e",
+			" \u00a0",
+		]) {
+			expect(isBedrockBlankKey(key), JSON.stringify(key)).toBe(false);
+		}
+	});
+});
+
+describe("stripBedrockBlankKeys", () => {
+	it("returns a clean object itself", () => {
+		const input = { commands: ["ls"], nested: { a: [1, { b: 2 }] } };
+		expect(stripBedrockBlankKeys(input)).toBe(input);
+	});
+
+	it("returns a copy without blank keys and leaves the original alone", () => {
+		const input = { commands: ["ls"], " ": "", deep: { "": 1, ok: 2 } };
+		const out = stripBedrockBlankKeys(input);
+		expect(out).toEqual({ commands: ["ls"], deep: { ok: 2 } });
+		expect(out).not.toBe(input);
+		expect(input).toEqual({
+			commands: ["ls"],
+			" ": "",
+			deep: { "": 1, ok: 2 },
+		});
+	});
+
+	it("reaches objects inside arrays at any depth", () => {
+		expect(
+			stripBedrockBlankKeys({ list: [{ "\t": 1, keep: 2 }, [{ "": 3 }], "x"] }),
+		).toEqual({ list: [{ keep: 2 }, [{}], "x"] });
+		expect(stripBedrockBlankKeys([{ " ": 1 }])).toEqual([{}]);
+	});
+
+	it("returns a clean array itself", () => {
+		const input = [{ a: 1 }, ["b"]];
+		expect(stripBedrockBlankKeys(input)).toBe(input);
+	});
+
+	it("keeps an own __proto__ key as data", () => {
+		const input = JSON.parse('{"__proto__": {"x": 1}, " ": ""}');
+		const out = stripBedrockBlankKeys(input) as Record<string, unknown>;
+		expect(Object.keys(out)).toEqual(["__proto__"]);
+		expect(Object.getPrototypeOf(out)).toBe(Object.prototype);
+	});
+
+	it("copies a null-prototype object without its blank keys", () => {
+		const input = Object.assign(Object.create(null), { keep: 1, " ": 2 });
+		const out = stripBedrockBlankKeys(input) as Record<string, unknown>;
+		expect(out).toEqual({ keep: 1 });
+		expect(Object.keys(out)).toEqual(["keep"]);
+	});
+
+	it("keeps the holes of a sparse array and returns it itself when nothing changes", () => {
+		const input: unknown[] = [];
+		input[0] = 1;
+		input[2] = 3;
+		expect(stripBedrockBlankKeys(input)).toBe(input);
+		const dirty: unknown[] = [];
+		dirty[0] = { " ": 1 };
+		dirty[2] = 3;
+		const out = stripBedrockBlankKeys(dirty) as unknown[];
+		expect(out).toHaveLength(3);
+		expect(1 in out).toBe(false);
+		expect(out[0]).toEqual({});
+	});
+
+	it("does not copy a value that holds NaN", () => {
+		const input = { n: Number.NaN, nested: [Number.NaN] };
+		expect(stripBedrockBlankKeys(input)).toBe(input);
+	});
+
+	it("keeps a key that mixes whitespace with a no-break space", () => {
+		const input = { " \u00a0": 1 };
+		expect(stripBedrockBlankKeys(input)).toBe(input);
+	});
+
+	it("returns anything that is not an object or array as it is", () => {
+		for (const input of ["text", 1, true, null, undefined]) {
+			expect(stripBedrockBlankKeys(input)).toBe(input);
+		}
+	});
+});
