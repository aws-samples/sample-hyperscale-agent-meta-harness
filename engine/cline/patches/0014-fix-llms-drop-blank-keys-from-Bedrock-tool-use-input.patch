+++ b/sdk/packages/llms/src/providers/bedrock-tool-use-input.ts
@@ -0,0 +1,93 @@
+/**
+ * Tool-use inputs for Bedrock Converse.
+ *
+ * Converse takes the input of a replayed `toolUse` block as a JSON object, and
+ * refuses any object that has a blank key, at any depth, with ValidationException
+ * "The format of the value at messages.N.content.M.toolUse.input is invalid.
+ * Provide a json object for the field and try again." It accepts the same object
+ * when a model returns it, so a model that adds a stray key (GPT-6 Astra returned
+ * {"commands": [...], " ": ""} on its fourth call in two live runs, 2026-10-15)
+ * ends the session on the next request, and a retry or a resume replays the same
+ * history.
+ *
+ * Measured against live Converse (2026-10-15) on GPT-6 Astra, GPT-6.1 Sol, Claude
+ * Opus 5.5, Claude Sonnet 5.5 and GLM 5.3: a key is blank when it is empty or made
+ * only of the code points below, which are the ones of Java's
+ * `Character.isWhitespace` on every code point tested: space, tab, line breaks,
+ * U+000B, U+000C, U+001C..U+001F, U+1680, U+2000..U+2006, U+2008..U+200A, U+2028,
+ * U+2029, U+205F and U+3000. Keys such as " a", "a b",
+ * U+00A0, U+2007, U+202F, U+200B, U+FEFF and U+0085 are accepted.
+ *
+ * `@ai-sdk/amazon-bedrock` wraps an input that is not an object as
+ * {rawInvalidInput: input}, which Bedrock accepts, and passes an object through
+ * unchanged. The adapter therefore removes blank keys from the input it hands to
+ * the SDK. The conversation history keeps what the model said; only the copy sent
+ * to Bedrock changes, and the tool already ran with the model's own input.
+ *
+ * The input is a JSON tree (it came from `JSON.parse`): no cycles, no getters, no
+ * `toJSON`. The walk is recursive and does not guard against anything else.
+ */
+/** Java `Character.isWhitespace` for one code point. */
+function isWhitespaceCodePoint(codePoint: number): boolean {
+	return (
+		(codePoint >= 0x09 && codePoint <= 0x0d) ||
+		(codePoint >= 0x1c && codePoint <= 0x20) ||
+		codePoint === 0x1680 ||
+		(codePoint >= 0x2000 && codePoint <= 0x2006) ||
+		(codePoint >= 0x2008 && codePoint <= 0x200a) ||
+		codePoint === 0x2028 ||
+		codePoint === 0x2029 ||
+		codePoint === 0x205f ||
+		codePoint === 0x3000
+	);
+}
+
+/** True for the empty key and for a key made only of whitespace Bedrock counts as blank. */
+export function isBedrockBlankKey(key: string): boolean {
+	for (const char of key) {
+		if (!isWhitespaceCodePoint(char.codePointAt(0) ?? 0)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+	if (value === null || typeof value !== "object" || Array.isArray(value)) {
+		return false;
+	}
+	const prototype = Object.getPrototypeOf(value);
+	return prototype === Object.prototype || prototype === null;
+}
+
+/**
+ * `value` without the object keys that Bedrock refuses, at any depth. Returns the
+ * same value when it has none, and never changes its argument.
+ */
+export function stripBedrockBlankKeys(value: unknown): unknown {
+	if (Array.isArray(value)) {
+		let changed = false;
+		const items = value.map((item) => {
+			const stripped = stripBedrockBlankKeys(item);
+			changed ||= !Object.is(stripped, item);
+			return stripped;
+		});
+		return changed ? items : value;
+	}
+	if (!isPlainObject(value)) {
+		return value;
+	}
+	let changed = false;
+	const entries: Array<[string, unknown]> = [];
+	for (const [key, item] of Object.entries(value)) {
+		if (isBedrockBlankKey(key)) {
+			changed = true;
+			continue;
+		}
+		const stripped = stripBedrockBlankKeys(item);
+		changed ||= !Object.is(stripped, item);
+		entries.push([key, stripped]);
+	}
+	// fromEntries defines own properties, so a "__proto__" key stays data.
+	return changed ? Object.fromEntries(entries) : value;
+}
