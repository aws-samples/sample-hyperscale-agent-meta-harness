+// Wire contract for the tool-use inputs that the Bedrock Converse adapter replays.
+//
+// Live record (us-east-1, 2026-10-15, GPT-6 Astra, two runs of a model-choice
+// check): on its fourth call the model returned `run_commands` with the input {"commands": [...], " ": ""}.
+// Bedrock accepted that response. The next request replayed the call verbatim
+// and Bedrock refused it with ValidationException "The format of the value at
+// messages.7.content.0.toolUse.input is invalid. Provide a json object for the
+// field and try again."; the run ended with stopped_provider_error.
+//
+// Measured against live Converse on all five supported models (Astra, GPT-6.1
+// Sol, Opus 5.5, Sonnet 5.5, GLM 5.3), with the same refusal on each:
+//   - an object key that is empty or made only of the Java whitespace code points (space, tab,
+//     line breaks, U+001C..U+001F, U+1680, U+2000..U+2006, U+2008..U+200A,
+//     U+2028, U+2029, U+205F, U+3000) is refused, at any depth;
+//   - keys such as " a", "a ", "a b", U+00A0, U+2007, U+202F, U+200B, U+FEFF and
+//     U+0085 are accepted;
+//   - an input that is not an object (array, string, number, boolean) is refused;
+//     `{}` is accepted.
+// `@ai-sdk/amazon-bedrock` 5.0.98 (`toBedrockToolInput`, dist/index.js) already
+// wraps a non-object input as {rawInvalidInput: <input>}, an object Bedrock
+// accepts; it passes an object through as it is, blank keys included. So the
+// adapter must hand it an input without blank keys at any depth, while the
+// conversation history keeps what the model said.
+import type { AgentMessage } from "@cline/shared";
+import { describe, expect, it } from "vitest";
+import { createGateway } from "../gateway";
+
+const ASTRA = "us.openai.gpt-6-astra";
+
+const RUN_COMMANDS = {
+	name: "run_commands",
+	description: "Run shell commands",
+	inputSchema: {
+		type: "object",
+		additionalProperties: false,
+		properties: { commands: { type: "array", items: { type: "string" } } },
+		required: ["commands"],
+	},
+};
+
+/** A user task, then one assistant tool call and its result per input. */
+function history(inputs: readonly unknown[]): AgentMessage[] {
+	const messages: AgentMessage[] = [
+		{
+			id: "u0",
+			role: "user",
+			content: [{ type: "text", text: "create hello.py" }],
+			createdAt: 0,
+		},
+	];
+	inputs.forEach((input, index) => {
+		const toolCallId = `call_${index}`;
+		messages.push(
+			{
+				id: `a${index}`,
+				role: "assistant",
+				content: [
+					{
+						type: "tool-call",
+						toolCallId,
+						toolName: "run_commands",
+						input,
+					},
+				],
+				createdAt: 2 * index + 1,
+			},
+			{
+				id: `t${index}`,
+				role: "tool",
+				content: [
+					{
+						type: "tool-result",
+						toolCallId,
+						toolName: "run_commands",
+						output: "ok",
+					},
+				],
+				createdAt: 2 * index + 2,
+			},
+		);
+	});
+	return messages;
+}
+
+interface ConverseBlock {
+	toolUse?: { toolUseId: string; name: string; input: unknown };
+}
+interface ConverseMessage {
+	role: string;
+	content: ConverseBlock[];
+}
+
+/** Stream one turn and return the Converse messages that reached the stubbed fetch. */
+async function converseMessages(
+	messages: AgentMessage[],
+): Promise<ConverseMessage[]> {
+	let body: { messages?: ConverseMessage[] } = {};
+	const fetchStub = (async (_input, init) => {
+		body = JSON.parse((init?.body as string) ?? "{}");
+		return new Response(JSON.stringify({ message: "stub" }), {
+			status: 400,
+			headers: { "content-type": "application/json" },
+		});
+	}) as typeof fetch;
+	const gateway = createGateway({
+		providerConfigs: [
+			{
+				providerId: "bedrock",
+				apiKey: "test-bearer-key",
+				fetch: fetchStub,
+				options: { region: "us-east-1", authentication: "apikey" },
+			},
+		],
+	});
+	try {
+		for await (const _event of await gateway.stream({
+			providerId: "bedrock",
+			modelId: ASTRA,
+			maxTokens: 64,
+			messages,
+			tools: [RUN_COMMANDS],
+		})) {
+			// drain
+		}
+	} catch {
+		// The stub answers 400; only the request is under test.
+	}
+	return body.messages ?? [];
+}
+
+/** Every toolUse input in the request, in order. */
+function toolUseInputs(messages: ConverseMessage[]): unknown[] {
+	return messages.flatMap((message) =>
+		message.content.flatMap((block) =>
+			block.toolUse ? [block.toolUse.input] : [],
+		),
+	);
+}
+
+const COMMAND =
+	"timeout 10 python3 hello.py; printf 'Run exit code: %s\\n' \"$?\"; git diff --check";
+
+describe("Bedrock Converse replays tool-use inputs as objects without blank keys", () => {
+	it("drops the blank key GPT-6 Astra sent on its fourth call (A15 live record)", async () => {
+		// Four calls, as in the live run: the Converse message index of the fourth
+		// call is 7, the index named in Bedrock's error.
+		const messages = await converseMessages(
+			history([
+				{ commands: ["pwd"] },
+				{ commands: ["python3 -c 'print(1)'"] },
+				{ commands: ["ls"] },
+				{ commands: [COMMAND], " ": "" },
+			]),
+		);
+		expect(messages).toHaveLength(9);
+		expect(messages[7]?.role).toBe("assistant");
+		expect(messages[7]?.content[0]?.toolUse?.input).toEqual({
+			commands: [COMMAND],
+		});
+		expect(toolUseInputs(messages)).toEqual([
+			{ commands: ["pwd"] },
+			{ commands: ["python3 -c 'print(1)'"] },
+			{ commands: ["ls"] },
+			{ commands: [COMMAND] },
+		]);
+	});
+
+	it.each([
+		["empty", ""],
+		["space", " "],
+		["two spaces", "  "],
+		["tab", "\t"],
+		["newline", "\n"],
+		["carriage return", "\r"],
+		["vertical tab", "\u000b"],
+		["unit separator", "\u001f"],
+		["ogham space", "\u1680"],
+		["em space", "\u2003"],
+		["line separator", "\u2028"],
+		["ideographic space", "\u3000"],
+	])("drops a %s key, which Bedrock refuses", async (_name, key) => {
+		const messages = await converseMessages(
+			history([{ commands: ["ls"], [key]: "x" }]),
+		);
+		expect(toolUseInputs(messages)).toEqual([{ commands: ["ls"] }]);
+	});
+
+	it.each([
+		["leading space", " a"],
+		["trailing space", "a "],
+		["inner space", "a b"],
+		["no-break space", "\u00a0"],
+		["figure space", "\u2007"],
+		["narrow no-break space", "\u202f"],
+		["zero-width space", "\u200b"],
+		["byte order mark", "\ufeff"],
+		["next line", "\u0085"],
+		["space and no-break space", " \u00a0"],
+	])("keeps a %s key, which Bedrock accepts", async (_name, key) => {
+		const messages = await converseMessages(
+			history([{ commands: ["ls"], [key]: "x" }]),
+		);
+		expect(toolUseInputs(messages)).toEqual([{ commands: ["ls"], [key]: "x" }]);
+	});
+
+	it("drops blank keys at any depth", async () => {
+		const messages = await converseMessages(
+			history([
+				{
+					commands: ["ls"],
+					options: { " ": 1, keep: 2 },
+					list: [{ "\t": 3, keep: 4 }, "text", [{ "": 5 }]],
+				},
+			]),
+		);
+		expect(toolUseInputs(messages)).toEqual([
+			{
+				commands: ["ls"],
+				options: { keep: 2 },
+				list: [{ keep: 4 }, "text", [{}]],
+			},
+		]);
+	});
+
+	it.each([
+		["an array", ["ls", "-la"]],
+		["a string", "ls -la"],
+		["a number", 5],
+		["a boolean", true],
+		["null", null],
+		["a string that holds JSON", '{"commands":["ls"]," ":""}'],
+	])("keeps the adapter's {rawInvalidInput} wrapper where the call's input is %s", async (_name, input) => {
