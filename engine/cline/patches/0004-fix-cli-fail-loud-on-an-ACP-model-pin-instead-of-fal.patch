+/**
+ * Resolve a model id the client pinned. A catalog id is kept. Bedrock routes
+ * ids outside its catalog (inference-profile ARNs, application inference
+ * profiles, `aws-mantle/<id>`), so any id the Bedrock vendor can route is kept
+ * too. Anything else fails with an error that names the id, so a session never
+ * runs on a model the client did not choose.
+ */
+function resolvePinnedModelId(
+	providerId: string,
+	requested: unknown,
+	providerModels: Record<string, unknown>,
+): string {
+	if (typeof requested !== "string" || !requested.trim()) {
+		throw RequestError.invalidParams(
+			undefined,
+			`Model "${String(requested)}" is not a model id`,
+		);
+	}
+	const modelId = requested.trim();
+	if (Object.hasOwn(providerModels, modelId)) {
+		return modelId;
+	}
+	if (providerId === "bedrock") {
+		try {
+			Llms.resolveBedrockMantleRoute(modelId);
+		} catch (error) {
+			throw RequestError.invalidParams(
+				undefined,
+				`Model "${requested}" cannot be routed by provider bedrock: ${describeAgentError(error)}`,
+			);
+		}
+		return modelId;
+	}
+	throw RequestError.invalidParams(
+		undefined,
+		`Model "${requested}" is not available for provider ${providerId}`,
+	);
+}
+
 async function resolveDefaultModelId(
 	providerId: string,
 	preferredModelId: string | undefined,
@@ -890,11 +955,17 @@ function buildModelConfigOption(
 		name: "Model",
 		category: "model",
 		currentValue: currentModelId,
-		options: Object.entries(providerModels).map(([modelId, info]) => ({
-			value: modelId,
-			name: info.name ?? modelId,
-			description: info.description,
-		})),
+		options: [
+			...Object.entries(providerModels).map(([modelId, info]) => ({
+				value: modelId,
+				name: info.name ?? modelId,
+				description: info.description,
+			})),
+			// A pinned id outside the catalog stays selectable and visible.
+			...(currentModelId && !Object.hasOwn(providerModels, currentModelId)
+				? [{ value: currentModelId, name: currentModelId }]
+				: []),
+		],
 	};
 }
 
