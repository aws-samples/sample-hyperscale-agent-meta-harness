+// Fork patch 0013. Wire-contract tests for the reasoning "off" request on the Bedrock Mantle route.
+//
+// The ACP session config always says `thinking: false`, so every request reaches the vendor with the
+// portable `reasoning: "none"`, and @ai-sdk/openai writes it as `reasoning_effort: "none"` (Chat
+// Completions) or `reasoning: { effort: "none" }` (Responses). Mantle serves the gpt-oss family through
+// Harmony, which has no off switch and answers HTTP 400 "Harmony does not support
+// reasoning_effort='none'" (measured 2026-10-03 against bedrock-mantle.us-east-1.api.aws: the four
+// gpt-oss models return 200 with the field omitted or "low" and 400 with "none"; 42 other Mantle chat
+// models return 200 with "none"). The models.dev catalog says the same thing: the effort list of
+// `openai.gpt-oss-*` is low, medium and high, with no "none" and no toggle.
+//
+// The contract: the vendor resolves the model's reasoning controls from the catalog by its base model
+// id (the `aws-mantle/` prefix and any geo-profile namespace removed), and sends "none" as the lowest
+// effort the model advertises when the model has effort levels but no off switch. Every other request
+// stays as it was: models with a toggle, with no effort list, with an empty list, or missing from the
+// catalog keep "none", and an explicit effort is never touched.
+import type {
+	LanguageModelV4,
+	LanguageModelV4CallOptions,
+} from "@ai-sdk/provider";
+import type { GatewayResolvedProviderConfig, ModelInfo } from "@cline/shared";
+import { describe, expect, it } from "vitest";
+import {
+	createBedrockProviderModule,
+	resolveMantleReasoningFloor,
+} from "./bedrock";
+
+const ROLE_CREDENTIALS = {
+	accessKeyId: "ASIA-test-0013",
+	secretAccessKey: "role-secret-0013",
+	sessionToken: "role-session-token-0013",
+};
+
+const CHAT_STREAM = [
+	{
+		id: "chatcmpl-1",
+		object: "chat.completion.chunk",
+		created: 1,
+		model: "wire-model",
+		choices: [
+			{
+				index: 0,
+				delta: { role: "assistant", content: "ok" },
+				finish_reason: null,
+			},
+		],
+	},
+	{
+		id: "chatcmpl-1",
+		object: "chat.completion.chunk",
+		created: 1,
+		model: "wire-model",
+		choices: [{ index: 0, delta: {}, finish_reason: "stop" }],
+		usage: { prompt_tokens: 11, completion_tokens: 1, total_tokens: 12 },
+	},
+];
+
+function sseBody(events: readonly unknown[]): string {
+	return `${events.map((event) => `data: ${JSON.stringify(event)}\n\n`).join("")}data: [DONE]\n\n`;
+}
+
+/** The JSON body the Mantle route sends for one call, with the stubbed fetch answering a two-chunk stream. */
+async function mantleBody(input: {
+	modelId: string;
+	reasoning?: LanguageModelV4CallOptions["reasoning"];
+	mantleApi?: "chat" | "responses";
+	providerOptions?: LanguageModelV4CallOptions["providerOptions"];
+}): Promise<{ url: string; body: Record<string, unknown> }> {
+	const seen: { url: string; body: Record<string, unknown> }[] = [];
+	const fetchStub = (async (resource, init) => {
+		seen.push({
+			url:
+				typeof resource === "string"
+					? resource
+					: resource instanceof URL
+						? resource.href
+						: resource.url,
+			body: JSON.parse(String(init?.body)),
+		});
+		return new Response(sseBody(CHAT_STREAM), {
+			status: 200,
+			headers: { "content-type": "text/event-stream" },
+		});
+	}) as typeof fetch;
+	const module = await createBedrockProviderModule({
+		providerId: "bedrock",
+		fetch: fetchStub,
+		options: {
+			authentication: "iam",
+			region: "us-east-1",
+			...(input.mantleApi ? { mantleApi: input.mantleApi } : {}),
+			credentialProvider: async () => ROLE_CREDENTIALS,
+		},
+	} as GatewayResolvedProviderConfig);
+	const model = module.operations.language(input.modelId) as LanguageModelV4;
+	const { stream } = await model.doStream({
+		prompt: [{ role: "user", content: [{ type: "text", text: "hi" }] }],
+		...(input.reasoning ? { reasoning: input.reasoning } : {}),
+		...(input.providerOptions
+			? { providerOptions: input.providerOptions }
+			: {}),
+	});
+	const reader = stream.getReader();
+	for (;;) {
+		const { done } = await reader.read();
+		if (done) break;
+	}
+	const first = seen[0];
+	if (!first) {
+		throw new Error("no Mantle request was sent");
+	}
+	return first;
+}
+
+const GPT_OSS_MANTLE_IDS = [
+	"aws-mantle/openai.gpt-oss-safeguard-120b",
+	"aws-mantle/openai.gpt-oss-safeguard-20b",
+	"aws-mantle/openai.gpt-oss-120b",
+	"aws-mantle/openai.gpt-oss-20b",
+];
+
+describe("Mantle reasoning off on a model with no off switch (patch 0013)", () => {
+	it.each(
+		GPT_OSS_MANTLE_IDS,
+	)("sends the lowest advertised effort instead of none on %s", async (modelId) => {
+		const { url, body } = await mantleBody({ modelId, reasoning: "none" });
+		expect(url).toBe(
+			"https://bedrock-mantle.us-east-1.api.aws/v1/chat/completions",
+		);
+		expect(body.model).toBe(modelId.slice("aws-mantle/".length));
+		expect(body.reasoning_effort).toBe("low");
+	});
+
+	it("sends no none on the Responses API either", async () => {
+		// @ai-sdk/openai writes a Responses `reasoning` object only for a reasoning model; the gpt-oss
+		// ids are not one, so the field is absent and stays absent.
+		const { body } = await mantleBody({
+			modelId: "aws-mantle/openai.gpt-oss-120b",
+			reasoning: "none",
+			mantleApi: "responses",
+		});
+		expect(
+			(body.reasoning as { effort?: string } | undefined)?.effort,
+		).not.toBe("none");
+	});
+
+	it.each([
+		"low",
+		"medium",
+		"high",
+	] as const)("leaves the advertised effort %s alone", async (reasoning) => {
+		const { body } = await mantleBody({
+			modelId: "aws-mantle/openai.gpt-oss-safeguard-120b",
+			reasoning,
+		});
+		expect(body.reasoning_effort).toBe(reasoning);
+	});
+
+	it("sends no reasoning field when the caller asked for none", async () => {
+		const { body } = await mantleBody({
+			modelId: "aws-mantle/openai.gpt-oss-safeguard-120b",
+		});
+		expect(body).not.toHaveProperty("reasoning_effort");
+	});
+});
+
+describe("Mantle provider-option effort on a model with no off switch (patch 0013)", () => {
+	// @ai-sdk/openai lets providerOptions.openai.reasoningEffort win over the portable reasoning.
+	it("lowers an explicit none in the provider options too", async () => {
+		const { body } = await mantleBody({
+			modelId: "aws-mantle/openai.gpt-oss-safeguard-120b",
+			reasoning: "none",
+			providerOptions: { openai: { reasoningEffort: "none" } },
+		});
+		expect(body.reasoning_effort).toBe("low");
+	});
+
+	it("lowers a provider-option none when the portable reasoning is absent", async () => {
+		const { body } = await mantleBody({
+			modelId: "aws-mantle/openai.gpt-oss-20b",
+			providerOptions: { openai: { reasoningEffort: "none" } },
+		});
+		expect(body.reasoning_effort).toBe("low");
+	});
+
+	it("leaves an explicit provider-option effort alone", async () => {
+		const { body } = await mantleBody({
+			modelId: "aws-mantle/openai.gpt-oss-safeguard-120b",
+			reasoning: "none",
+			providerOptions: { openai: { reasoningEffort: "high" } },
+		});
+		expect(body.reasoning_effort).toBe("high");
+	});
+
+	it("keeps a provider-option none on a model with a toggle", async () => {
+		const { body } = await mantleBody({
+			modelId: "aws-mantle/zai.glm-4.7-flash",
+			providerOptions: { openai: { reasoningEffort: "none" } },
+		});
+		expect(body.reasoning_effort).toBe("none");
+	});
+});
+
+describe("Mantle reasoning off on every other model stays as it was (patch 0013)", () => {
+	it.each([
+		[
+			"a model the catalog lists with no reasoning options",
+			"aws-mantle/qwen.qwen3-coder-next",
+		],
+		["a model with a reasoning toggle", "aws-mantle/zai.glm-4.7-flash"],
+		[
+			"a model with an empty reasoning list",
+			"aws-mantle/nvidia.nemotron-super-3-120b",
+		],
+		["a model the catalog does not list", "aws-mantle/acme.future-1"],
+	])("still sends none to %s", async (_label, modelId) => {
+		const { body } = await mantleBody({ modelId, reasoning: "none" });
+		expect(body.reasoning_effort).toBe("none");
+	});
+
+	it("still sends an explicit effort to a model with a toggle", async () => {
+		const { body } = await mantleBody({
+			modelId: "aws-mantle/zai.glm-4.7-flash",
+			reasoning: "high",
+		});
+		expect(body.reasoning_effort).toBe("high");
+	});
+});
+
+describe("resolveMantleReasoningFloor", () => {
+	it.each([
+		["openai.gpt-oss-safeguard-120b", "low"],
+		["openai.gpt-oss-safeguard-20b", "low"],
+		["openai.gpt-oss-120b", "low"],
