+import { mkdirSync, mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { AgentSideConnection } from "@agentclientprotocol/sdk";
+import type { AgentConfig } from "@cline/shared";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+// The runtime's own model factory and model-options builder, so the wire test covers
+// providers.json -> ACP config -> agent model options -> gateway -> Bedrock vendor -> HTTP request.
+// @cline/core exports no entrypoint for them, so this test imports the source files directly.
+// biome-ignore lint/style/noRestrictedImports: wire test drives the runtime model factory
+import { buildModelOptions } from "../../../../sdk/packages/core/src/runtime/config/agent-runtime-config-builder";
+// biome-ignore lint/style/noRestrictedImports: wire test drives the runtime model factory
+import { createAgentModelFromConfig } from "../../../../sdk/packages/core/src/services/llms/handler-factory";
+import type { Config } from "../utils/types";
+
+vi.mock("../runtime/prompt", () => ({
+	resolveSystemPrompt: vi.fn(async () => "PROMPT"),
+}));
+vi.mock("@cline/core", async (importOriginal) => {
+	const actual = await importOriginal<typeof import("@cline/core")>();
+	return {
+		...actual,
+		Llms: {
+			...actual.Llms,
+			getModelsForProvider: vi.fn(async () => ({
+				"us.anthropic.claude-sonnet-5": { name: "Claude Sonnet 5" },
+			})),
+			getProvider: vi.fn(async (id: string) => ({
+				id,
+				name: id,
+				defaultModelId: "us.anthropic.claude-sonnet-5",
+			})),
+		},
+	};
+});
+
+import { AcpAgent } from "./acpAgent";
+
+type Internals = {
+	sessions: Map<string, unknown>;
+	buildConfig(session: unknown): Promise<Config>;
+};
+
+interface Captured {
+	url: string;
+	body: Record<string, unknown>;
+}
+
+const conn = {
+	sessionUpdate: vi.fn(async () => {}),
+} as unknown as AgentSideConnection;
+
+function writeProviders(dir: string, model: string): string {
+	const settingsDir = join(dir, "settings");
+	mkdirSync(settingsDir, { recursive: true });
+	const path = join(settingsDir, "providers.json");
+	writeFileSync(
+		path,
+		JSON.stringify({
+			version: 1,
+			lastUsedProvider: "bedrock",
+			modes: {},
+			providers: {
+				bedrock: {
+					settings: {
+						provider: "bedrock",
+						model,
+						aws: { region: "us-east-1", authentication: "iam" },
+					},
+					updatedAt: "2026-10-03T00:00:00.000Z",
+					tokenSource: "manual",
+				},
+			},
+		}),
+	);
+	return path;
+}
+
+function bodyText(body: unknown): string {
+	if (typeof body === "string") return body;
+	if (body instanceof Uint8Array) return new TextDecoder().decode(body);
+	if (body instanceof ArrayBuffer) return new TextDecoder().decode(body);
+	return "{}";
+}
+
+/** The first model request an ACP session built from providers.json sends, with the session's own model options. */
+async function firstModelRequest(
+	agentOptions?: ConstructorParameters<typeof AcpAgent>[1],
+): Promise<Captured> {
+	const seen: Captured[] = [];
+	vi.stubGlobal(
+		"fetch",
+		vi.fn(async (input: unknown, init?: RequestInit) => {
+			const url =
+				typeof input === "string"
+					? input
+					: input instanceof URL
+						? input.href
+						: (input as Request).url;
+			seen.push({ url, body: JSON.parse(bodyText(init?.body)) });
+			return new Response(JSON.stringify({ message: "captured" }), {
+				status: 400,
+				headers: { "content-type": "application/json" },
+			});
+		}),
+	);
+	const agent = new AcpAgent(conn, agentOptions);
+	const created = await agent.newSession({
+		cwd: process.cwd(),
+		mcpServers: [],
+	});
+	const inner = agent as unknown as Internals;
+	const config = await inner.buildConfig(inner.sessions.get(created.sessionId));
+	const agentConfig = { ...config, tools: [] } as unknown as AgentConfig;
+	const model = createAgentModelFromConfig(agentConfig, undefined);
+	try {
+		const stream = await model.stream({
+			systemPrompt: "PROMPT",
+			messages: [
+				{
+					id: "u1",
+					role: "user",
+					content: [{ type: "text", text: "hi" }],
+					createdAt: 1,
+				},
+			],
+			tools: [],
+			// What the agent loop adds to every request: the session's model options.
+			options: buildModelOptions(agentConfig),
+		});
+		for await (const _event of stream) {
+			// Drain so the request is sent.
+		}
+	} catch {
+		// The stubbed 400 ends the stream after capture.
+	}
+	const first = seen[0];
+	if (!first) {
+		throw new Error("no model request was sent");
+	}
+	return first;
+}
+
+// Fork patch 0013: an ACP session always runs with reasoning off (`thinking: false`); a Mantle model
+// with no off switch (gpt-oss, Harmony) must get its lowest effort, not reasoning_effort "none".
+describe("ACP reasoning off on a Mantle route", () => {
+	const saved = { ...process.env };
+	let dir: string;
+
+	beforeEach(() => {
+		dir = mkdtempSync(join(tmpdir(), "acp-mantle-reasoning-"));
+		process.env = { ...saved };
+		process.env.HOME = join(dir, "home");
+		process.env.CLINE_DATA_DIR = join(dir, "data");
+		process.env.CLINE_PROVIDER = "bedrock";
+		process.env.CLINE_API_KEY = "unused";
+		process.env.AWS_ACCESS_KEY_ID = "ASIA-test-0013";
+		process.env.AWS_SECRET_ACCESS_KEY = "role-secret-0013";
+		process.env.AWS_SESSION_TOKEN = "role-session-token-0013";
+		process.env.AWS_REGION = "us-east-1";
+		process.env.AWS_CONFIG_FILE = join(dir, "no-aws-config");
+		process.env.AWS_SHARED_CREDENTIALS_FILE = join(dir, "no-aws-credentials");
+		process.env.AWS_EC2_METADATA_DISABLED = "true";
+		delete process.env.AWS_PROFILE;
+		delete process.env.AWS_BEARER_TOKEN_BEDROCK;
+	});
+
+	afterEach(() => {
+		process.env = { ...saved };
+		vi.unstubAllGlobals();
+	});
+
+	async function requestFor(
+		model: string,
+		agentOptions?: ConstructorParameters<typeof AcpAgent>[1],
+	): Promise<Captured> {
+		process.env.CLINE_MODEL = model;
+		process.env.CLINE_PROVIDER_SETTINGS_PATH = writeProviders(dir, model);
+		return firstModelRequest(agentOptions);
+	}
+
+	it("builds the session config with reasoning off", async () => {
+		process.env.CLINE_MODEL = "aws-mantle/qwen.qwen3-coder-next";
+		process.env.CLINE_PROVIDER_SETTINGS_PATH = writeProviders(
+			dir,
+			"aws-mantle/qwen.qwen3-coder-next",
+		);
+		const agent = new AcpAgent(conn);
+		const created = await agent.newSession({
+			cwd: process.cwd(),
+			mcpServers: [],
+		});
+		const inner = agent as unknown as Internals;
+		const config = await inner.buildConfig(
+			inner.sessions.get(created.sessionId),
+		);
+		expect(config.thinking).toBe(false);
+		expect(buildModelOptions(config as unknown as AgentConfig)).toMatchObject({
+			thinking: false,
+		});
+	});
+
+	it.each([
+		"aws-mantle/openai.gpt-oss-safeguard-120b",
+		"aws-mantle/openai.gpt-oss-safeguard-20b",
+		"aws-mantle/openai.gpt-oss-120b",
+		"aws-mantle/openai.gpt-oss-20b",
+	])("sends the lowest advertised effort to %s, not none", async (model) => {
+		const request = await requestFor(model);
+		expect(request.url).toContain("bedrock-mantle.us-east-1.api.aws");
+		expect(request.body.reasoning_effort).toBe("low");
+	});
+
+	it.each([
+		"aws-mantle/qwen.qwen3-coder-next",
+		"aws-mantle/deepseek.v3.2",
+	])("still sends none to %s", async (model) => {
+		const request = await requestFor(model);
+		expect(request.url).toContain("bedrock-mantle.us-east-1.api.aws");
+		expect(request.body.reasoning_effort).toBe("none");
+	});
+
+	// A model with an off toggle is never floored to an effort. From cli-v3.0.71 (upstream #14991) the portable
+	// disable of such a model is encoded by its native toggle rule instead of reasoning_effort "none", and the
+	// Mantle chat-completions body then carries no reasoning field at all (measured on 3.0.71: GLM-4.7-Flash).
+	it("never floors a model with an off toggle to an effort (aws-mantle/zai.glm-4.7-flash)", async () => {
+		const request = await requestFor("aws-mantle/zai.glm-4.7-flash");
+		expect(request.url).toContain("bedrock-mantle.us-east-1.api.aws");
+		expect(["none", undefined]).toContain(request.body.reasoning_effort);
+		expect(request.body.reasoning_effort).not.toBe("low");
+	});
+
+	it("leaves a Converse request without any reasoning field", async () => {
+		const request = await requestFor("openai.gpt-oss-safeguard-120b");
+		expect(request.url).toContain("bedrock-runtime.us-east-1.amazonaws.com");
+		expect(JSON.stringify(request.body)).not.toMatch(/reasoning/i);
+	});
+
+	// cli-v3.0.71 (#14894): `--thinking` applies under ACP. The reasoning the launch asked for must reach the wire,
+	// and an explicit effort is never floored or lowered by this patch.
+	it.each([
+		"aws-mantle/openai.gpt-oss-120b",
+		"aws-mantle/openai.gpt-oss-safeguard-20b",
+	])("sends the effort --thinking asked for to %s", async (model) => {
+		const request = await requestFor(model, {
+			reasoning: { thinking: true, reasoningEffort: "high" },
+		});
+		expect(request.url).toContain("bedrock-mantle.us-east-1.api.aws");
+		expect(request.body.reasoning_effort).toBe("high");
+	});
+
+	it("sends a thinking request on the Converse route when --thinking is given", async () => {
+		const off = await requestFor("us.anthropic.claude-sonnet-5");
+		const on = await requestFor("us.anthropic.claude-sonnet-5", {
+			reasoning: { thinking: true, reasoningEffort: "high" },
+		});
+		expect(on.url).toContain("bedrock-runtime.us-east-1.amazonaws.com");
+		expect(off.body.additionalModelRequestFields).toBeUndefined();
+		// Measured on cli-v3.0.71 (Claude Sonnet 5 through Converse, effort high).
+		expect(on.body.additionalModelRequestFields).toEqual({
+			thinking: { type: "adaptive" },
+			output_config: { effort: "high" },
+		});
+	});
+});
