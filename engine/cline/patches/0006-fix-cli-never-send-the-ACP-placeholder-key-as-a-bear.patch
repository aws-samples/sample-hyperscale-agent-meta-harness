+	/**
+	 * API key for the session provider. CLINE_API_KEY and the ACP
+	 * `authenticate` result are Cline account credentials: they go only to Cline
+	 * account providers, or to the provider they were issued for. Every other
+	 * provider gets its own stored key, so a Cline key never reaches another
+	 * provider's endpoint.
+	 */
+	private resolveProviderApiKey(providerId: string): string {
+		if (usesClineAccount(providerId)) {
+			return process.env.CLINE_API_KEY ?? this.authResult?.apiKey ?? "";
+		}
+		if (this.authResult?.providerId === providerId) {
+			return this.authResult.apiKey ?? "";
+		}
+		return (
+			this.providerSettingsManager.getProviderConfig(providerId)?.apiKey ?? ""
+		);
+	}
+
+	/**
+	 * Under ACP, Bedrock signs with IAM credentials (SigV4 through the AWS
+	 * default chain) unless providers.json explicitly selects api-key or profile
+	 * authentication. Without the pin, an empty or placeholder key made the
+	 * Bedrock vendor fall back to AWS_BEARER_TOKEN_BEDROCK or send the key as a
+	 * bearer token.
+	 */
+	private resolveBedrockIamProviderConfig(
+		providerId: string,
+		modelId: string,
+	): Config["providerConfig"] | undefined {
+		if (providerId !== "bedrock") {
+			return undefined;
+		}
+		const stored = this.providerSettingsManager.getProviderConfig(providerId);
+		const authentication: string | undefined = stored?.aws?.authentication;
+		if (
+			authentication === "api-key" ||
+			authentication === "apikey" ||
+			authentication === "profile"
+		) {
+			return undefined;
+		}
+		return {
+			...(stored ?? {}),
+			providerId,
+			modelId,
+			apiKey: undefined,
+			aws: { ...(stored?.aws ?? {}), authentication: "iam" },
+		} as Config["providerConfig"];
+	}
+
