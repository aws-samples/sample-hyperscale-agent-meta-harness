+import { mkdirSync, mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { AgentSideConnection } from "@agentclientprotocol/sdk";
+import type { AgentConfig } from "@cline/shared";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+// The runtime's own model factory, so the wire test covers ACP config -> core
+// provider config -> Bedrock vendor -> HTTP request. @cline/core exports no
+// entrypoint for it, so this test imports the source file directly.
+// biome-ignore lint/style/noRestrictedImports: wire test drives the runtime model factory
+import { createAgentModelFromConfig } from "../../../../sdk/packages/core/src/services/llms/handler-factory";
+import type { Config } from "../utils/types";
+
+vi.mock("../runtime/prompt", () => ({
+	resolveSystemPrompt: vi.fn(async () => "PROMPT"),
+}));
+vi.mock("@cline/core", async (importOriginal) => {
+	const actual = await importOriginal<typeof import("@cline/core")>();
+	return {
+		...actual,
+		Llms: {
+			...actual.Llms,
+			getModelsForProvider: vi.fn(async () => ({
+				"us.anthropic.claude-sonnet-5": { name: "Claude Sonnet 5" },
+			})),
+			getProvider: vi.fn(async (id: string) => ({
+				id,
+				name: id,
+				defaultModelId: "us.anthropic.claude-sonnet-5",
+			})),
+		},
+	};
+});
+
+import { AcpAgent } from "./acpAgent";
+
+const PLACEHOLDER = "placeholder-key-0007";
+const AMBIENT_BEARER = "ambient-bogus-bearer-0007";
+const ROLE_KEY_ID = "ASIAEXAMPLEACPKEY0007";
+
+type Internals = {
+	sessions: Map<string, unknown>;
+	buildConfig(session: unknown): Promise<Config>;
+};
+
+const conn = {
+	sessionUpdate: vi.fn(async () => {}),
+} as unknown as AgentSideConnection;
+
+function writeProviders(dir: string, bedrock: Record<string, unknown>): string {
+	const settingsDir = join(dir, "settings");
+	mkdirSync(settingsDir, { recursive: true });
+	const path = join(settingsDir, "providers.json");
+	writeFileSync(
+		path,
+		JSON.stringify({
+			version: 1,
+			lastUsedProvider: "bedrock",
+			modes: {},
+			providers: {
+				bedrock: {
+					settings: {
+						provider: "bedrock",
+						model: "us.anthropic.claude-sonnet-5",
+						...bedrock,
+					},
+					updatedAt: "2026-09-25T00:00:00.000Z",
+					tokenSource: "manual",
+				},
+			},
+		}),
+	);
+	return path;
+}
+
+async function configFor(agent: AcpAgent): Promise<Config> {
+	const created = await agent.newSession({
+		cwd: process.cwd(),
+		mcpServers: [],
+	});
+	const inner = agent as unknown as Internals;
+	return inner.buildConfig(inner.sessions.get(created.sessionId));
+}
+
+// Fork patch 0007: the ACP placeholder key is never sent as a bearer token,
+// and Bedrock authentication is pinned to IAM under ACP.
+describe("ACP credentials for non-Cline providers", () => {
+	const saved = { ...process.env };
+	let dir: string;
+
+	beforeEach(() => {
+		dir = mkdtempSync(join(tmpdir(), "acp-auth-"));
+		process.env = { ...saved };
+		process.env.HOME = join(dir, "home");
+		process.env.CLINE_DATA_DIR = join(dir, "data");
+		process.env.CLINE_PROVIDER_SETTINGS_PATH = writeProviders(dir, {
+			aws: { region: "us-west-2" },
+		});
+		process.env.CLINE_PROVIDER = "bedrock";
+		process.env.CLINE_MODEL = "us.anthropic.claude-sonnet-5";
+		process.env.CLINE_API_KEY = PLACEHOLDER;
+		process.env.AWS_BEARER_TOKEN_BEDROCK = AMBIENT_BEARER;
+		process.env.AWS_ACCESS_KEY_ID = ROLE_KEY_ID;
+		process.env.AWS_SECRET_ACCESS_KEY = "role-secret-0007";
+		process.env.AWS_SESSION_TOKEN = "role-session-token-0007";
+		process.env.AWS_REGION = "us-west-2";
+		process.env.AWS_CONFIG_FILE = join(dir, "no-aws-config");
+		process.env.AWS_SHARED_CREDENTIALS_FILE = join(dir, "no-aws-credentials");
+		process.env.AWS_EC2_METADATA_DISABLED = "true";
+		delete process.env.AWS_PROFILE;
+	});
+
+	afterEach(() => {
+		process.env = { ...saved };
+		vi.unstubAllGlobals();
+	});
+
+	it("opens a Bedrock session without a Cline credential", async () => {
+		delete process.env.CLINE_API_KEY;
+		const created = await new AcpAgent(conn).newSession({
+			cwd: process.cwd(),
+			mcpServers: [],
+		});
+		expect(created.sessionId).toBeTruthy();
+	});
+
+	it("still requires authentication for the Cline provider", async () => {
+		delete process.env.CLINE_API_KEY;
+		process.env.CLINE_PROVIDER = "cline";
+		await expect(
+			new AcpAgent(conn).newSession({ cwd: process.cwd(), mcpServers: [] }),
+		).rejects.toMatchObject({ code: -32000 });
+	});
+
+	it("does not forward CLINE_API_KEY to Bedrock and pins IAM authentication", async () => {
+		const config = await configFor(new AcpAgent(conn));
+		expect(config.apiKey).not.toBe(PLACEHOLDER);
+		const pc = config.providerConfig as
+			| { apiKey?: string; region?: string; aws?: { authentication?: string } }
+			| undefined;
+		expect(pc?.aws?.authentication).toBe("iam");
+		expect(pc?.apiKey).toBeUndefined();
+		expect(pc?.region).toBe("us-west-2");
+	});
+
+	it("keeps an explicit api-key choice from providers.json", async () => {
+		process.env.CLINE_PROVIDER_SETTINGS_PATH = writeProviders(dir, {
+			apiKey: "stored-bedrock-api-key",
+			aws: { region: "us-west-2", authentication: "api-key" },
+		});
+		const config = await configFor(new AcpAgent(conn));
+		const pc = config.providerConfig as
+			| { aws?: { authentication?: string } }
+			| undefined;
+		expect(pc?.aws?.authentication).not.toBe("iam");
+		expect(config.apiKey).not.toBe(PLACEHOLDER);
+	});
+
+	it("passes CLINE_API_KEY to the Cline provider", async () => {
+		process.env.CLINE_PROVIDER = "cline";
+		process.env.CLINE_API_KEY = "cline-account-key";
+		const config = await configFor(new AcpAgent(conn));
+		expect(config.apiKey).toBe("cline-account-key");
+	});
+
+	it("signs the Bedrock request with SigV4, never the placeholder or the ambient bearer", async () => {
+		const seen: Headers[] = [];
+		vi.stubGlobal(
+			"fetch",
+			vi.fn(async (_input: unknown, init?: RequestInit) => {
+				seen.push(new Headers(init?.headers));
+				return new Response(JSON.stringify({ message: "captured" }), {
+					status: 400,
+					headers: { "content-type": "application/json" },
+				});
+			}),
+		);
+		const config = await configFor(new AcpAgent(conn));
+		const model = createAgentModelFromConfig(
+			{ ...config, tools: [] } as unknown as AgentConfig,
+			undefined,
+		);
+		try {
+			const stream = await model.stream({
+				systemPrompt: "PROMPT",
+				messages: [
+					{
+						id: "u1",
+						role: "user",
+						content: [{ type: "text", text: "hi" }],
+						createdAt: 1,
+					},
+				],
+				tools: [],
+			});
+			for await (const _event of stream) {
+				// Drain so the request is sent.
+			}
+		} catch {
+			// The stubbed 400 ends the stream after capture.
+		}
+		expect(seen.length).toBeGreaterThan(0);
+		const authorization = seen[0]?.get("authorization") ?? "";
+		expect(authorization).toMatch(
+			new RegExp(
+				`^AWS4-HMAC-SHA256 Credential=${ROLE_KEY_ID}/\\d{8}/us-west-2/bedrock/aws4_request`,
+			),
+		);
+		const allHeaders = seen.flatMap((h) => [...h.values()]).join("\n");
+		expect(allHeaders).not.toContain(PLACEHOLDER);
+		expect(allHeaders).not.toContain(AMBIENT_BEARER);
+	});
+});
