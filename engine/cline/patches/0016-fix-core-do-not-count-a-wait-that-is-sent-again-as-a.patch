+
+/** Environment variable: the bound of one wait on a background job, in seconds, as the harness sets it. */
+export const WAIT_BOUND_ENV = "HAMH_WAIT_S";
+
+/** Environment variable: the most time the exempt repeats of one run of identical calls may take, in seconds. */
+export const WAIT_CAP_ENV = "HAMH_WAIT_CAP_S";
+
+/** The least time a call must have blocked for its identical repeat to be exempt: 5 seconds. */
+export const MIN_WAIT_BLOCK_MS = 5_000;
+
+/** The most a call must have blocked for its identical repeat to be exempt, however long the wait bound is: 50 seconds. */
+export const MAX_WAIT_THRESHOLD_MS = 50_000;
+
+/** The cap of the exempt time when the harness names none: two hours. */
+export const DEFAULT_WAIT_CAP_MS = 7_200_000;
+
+/** When the repeat of an identical call is a wait that is sent again, not a loop. */
+export interface WaitExemption {
+	/** The earlier identical call must have blocked at least this long, in ms. */
+	thresholdMs: number;
+	/** The most time the exempt repeats of one run of identical calls may take, in ms. */
+	capMs: number;
+}
+
+/** A whole number of seconds from 1 up, of at most six digits; anything else is unset. */
+function wholeSeconds(raw: string | undefined): number | undefined {
+	const text = raw?.trim();
+	if (text === undefined || !/^[0-9]{1,6}$/.test(text)) return undefined;
+	const seconds = Number(text);
+	return seconds >= 1 ? seconds : undefined;
+}
+
+/**
+ * Resolve the exemption from the environment: absent unless
+ * {@link WAIT_BOUND_ENV} is a whole number of seconds from 1 up. The threshold
+ * is half of that bound, at most {@link MAX_WAIT_THRESHOLD_MS} and at least
+ * {@link MIN_WAIT_BLOCK_MS}; the cap is {@link WAIT_CAP_ENV} in seconds, else
+ * {@link DEFAULT_WAIT_CAP_MS}.
+ */
+export function resolveWaitExemption(
+	env: Readonly<Record<string, string | undefined>> = process.env,
+): WaitExemption | undefined {
+	const bound = wholeSeconds(env[WAIT_BOUND_ENV]);
+	if (bound === undefined) return undefined;
+	const cap = wholeSeconds(env[WAIT_CAP_ENV]);
+	return {
+		thresholdMs: Math.max(
+			MIN_WAIT_BLOCK_MS,
+			Math.min((bound * 1000) / 2, MAX_WAIT_THRESHOLD_MS),
+		),
+		capMs: cap === undefined ? DEFAULT_WAIT_CAP_MS : cap * 1000,
+	};
