+import { describe, expect, it } from "vitest";
+import {
+	DEFAULT_WAIT_CAP_MS,
+	LoopDetectionTracker,
+	MAX_WAIT_THRESHOLD_MS,
+	MIN_WAIT_BLOCK_MS,
+	resolveWaitExemption,
+	WAIT_BOUND_ENV,
+	WAIT_CAP_ENV,
+	type WaitExemption,
+} from "./loop-detection";
+
+// One bounded wait on a background job, sent again unchanged while the job runs.
+const WAIT = {
+	name: "run_commands",
+	input: { commands: ["wait-for-the-job"] },
+};
+const OTHER = { name: "run_commands", input: { commands: ["echo next"] } };
+// What the harness's default bound of 240 seconds resolves to.
+const HARNESS: WaitExemption = { thresholdMs: 50_000, capMs: 7_200_000 };
+
+/** Inspect a call, let it block for `blockedMs`, and return the verdict of the inspection. */
+function call(
+	tracker: LoopDetectionTracker,
+	blockedMs: number,
+	what = WAIT,
+): string {
+	const verdict = tracker.inspect(what).kind;
+	tracker.finished(what, blockedMs);
+	return verdict;
+}
+
+describe("resolveWaitExemption", () => {
+	it("is absent when the harness sets no wait bound", () => {
+		expect(resolveWaitExemption({})).toBeUndefined();
+		expect(resolveWaitExemption({ [WAIT_CAP_ENV]: "600" })).toBeUndefined();
+	});
+
+	it("takes half of the wait bound, at most 50 seconds and at least 5 seconds, as the threshold", () => {
+		expect(resolveWaitExemption({ [WAIT_BOUND_ENV]: "240" })).toEqual({
+			thresholdMs: 50_000,
+			capMs: DEFAULT_WAIT_CAP_MS,
+		});
+		// The bound of a session whose command limit could not be placed, and a bound of 100 seconds.
+		expect(resolveWaitExemption({ [WAIT_BOUND_ENV]: "108" })?.thresholdMs).toBe(
+			50_000,
+		);
+		expect(resolveWaitExemption({ [WAIT_BOUND_ENV]: "100" })?.thresholdMs).toBe(
+			50_000,
+		);
+		// Under a bound of 100 seconds the threshold is half of the bound.
+		expect(resolveWaitExemption({ [WAIT_BOUND_ENV]: "54" })?.thresholdMs).toBe(
+			27_000,
+		);
+		expect(resolveWaitExemption({ [WAIT_BOUND_ENV]: "6" })?.thresholdMs).toBe(
+			MIN_WAIT_BLOCK_MS,
+		);
+		expect(resolveWaitExemption({ [WAIT_BOUND_ENV]: "1" })?.thresholdMs).toBe(
+			5_000,
+		);
+		expect(MIN_WAIT_BLOCK_MS).toBe(5_000);
+		expect(MAX_WAIT_THRESHOLD_MS).toBe(50_000);
+		expect(DEFAULT_WAIT_CAP_MS).toBe(7_200_000);
+	});
+
+	it("reads the cap of the exempt time in seconds and falls back to two hours", () => {
+		expect(
+			resolveWaitExemption({ [WAIT_BOUND_ENV]: "240", [WAIT_CAP_ENV]: "600" }),
+		).toEqual({ thresholdMs: 50_000, capMs: 600_000 });
+		for (const cap of ["", "0", "abc", "1.5", "-5", "12345678"]) {
+			expect(
+				resolveWaitExemption({ [WAIT_BOUND_ENV]: "240", [WAIT_CAP_ENV]: cap }),
+			).toEqual({ thresholdMs: 50_000, capMs: DEFAULT_WAIT_CAP_MS });
+		}
+	});
+
+	it("ignores a wait bound that is not a whole number of seconds from 1 up", () => {
+		for (const bound of ["", " ", "0", "abc", "2.5", "-240", "240s"]) {
+			expect(resolveWaitExemption({ [WAIT_BOUND_ENV]: bound })).toBeUndefined();
+		}
+		expect(resolveWaitExemption({ [WAIT_BOUND_ENV]: " 240 " })).toEqual({
+			thresholdMs: 50_000,
+			capMs: DEFAULT_WAIT_CAP_MS,
+		});
+	});
+});
+
+describe("LoopDetectionTracker and a wait that is sent again", () => {
+	it("counts identical calls that return quickly as before", () => {
+		const tracker = new LoopDetectionTracker(undefined, HARNESS);
+		expect([200, 200, 200, 200, 200].map((ms) => call(tracker, ms))).toEqual([
+			"ok",
+			"ok",
+			"soft",
+			"ok",
+			"hard",
+		]);
+	});
+
+	it("does not count a repeat of a call that blocked at least the threshold", () => {
+		const tracker = new LoopDetectionTracker(undefined, HARNESS);
+		const verdicts = Array.from({ length: 12 }, () => call(tracker, 240_000));
+		expect(verdicts).toEqual(Array(12).fill("ok"));
+		// The threshold itself is enough; one millisecond less is not.
+		const edge = new LoopDetectionTracker(undefined, HARNESS);
+		expect(
+			[50_000, 50_000, 50_000, 50_000, 50_000, 50_000].map((ms) =>
+				call(edge, ms),
+			),
+		).toEqual(Array(6).fill("ok"));
+		const under = new LoopDetectionTracker(undefined, HARNESS);
+		expect(
+			[49_999, 49_999, 49_999, 49_999, 49_999].map((ms) => call(under, ms)),
+		).toEqual(["ok", "ok", "soft", "ok", "hard"]);
+	});
+
+	it("does not count the waits that sessions send under the harness's bounds", () => {
+		// A wait of 100 seconds (the number rules files name), a model's own 110 seconds and a wait of the whole bound under
+		// the default bound of 240 seconds; 100 seconds under a bound of 108 seconds; a whole bound of 54 seconds.
+		for (const [bound, blockedMs] of [
+			["240", 100_000],
+			["240", 110_000],
+			["240", 240_000],
+			["108", 100_000],
+			["54", 54_000],
+		] as const) {
+			const tracker = new LoopDetectionTracker(
+				undefined,
+				resolveWaitExemption({ [WAIT_BOUND_ENV]: bound }),
+			);
+			expect(
+				Array.from({ length: 8 }, () => call(tracker, blockedMs)),
+				`${blockedMs} ms under a bound of ${bound} s`,
+			).toEqual(Array(8).fill("ok"));
+		}
+		// A call of 49 seconds under 240 seconds and one of 26 seconds under 54 seconds are under the threshold: a loop, as before.
+		for (const [bound, blockedMs] of [
+			["240", 49_000],
+			["54", 26_000],
+		] as const) {
+			const tracker = new LoopDetectionTracker(
+				undefined,
+				resolveWaitExemption({ [WAIT_BOUND_ENV]: bound }),
+			);
+			expect(
+				Array.from({ length: 5 }, () => call(tracker, blockedMs)),
+				`${blockedMs} ms under a bound of ${bound} s`,
+			).toEqual(["ok", "ok", "soft", "ok", "hard"]);
+		}
+	});
+
+	it("gives no warning for an exempt repeat while the count sits at the warning threshold", () => {
+		const tracker = new LoopDetectionTracker(undefined, HARNESS);
+		// Three quick identical calls: the third is the warning. It then blocks for a long time.
+		expect(call(tracker, 200)).toBe("ok");
+		expect(call(tracker, 200)).toBe("ok");
+		expect(call(tracker, 240_000)).toBe("soft");
+		// The repeats of the long wait are not counted and are not warned about again.
+		expect(call(tracker, 240_000)).toBe("ok");
+		expect(call(tracker, 200)).toBe("ok");
+		// Quick repeats count again, from where the count stood.
+		expect(call(tracker, 200)).toBe("ok");
+		expect(call(tracker, 200)).toBe("hard");
+	});
+
+	it("caps the time the exempt repeats of one run of identical calls may take", () => {
+		const tracker = new LoopDetectionTracker(undefined, {
+			thresholdMs: 120_000,
+			capMs: 600_000,
+		});
+		// 240 s and 240 s are exempt (480 s). A third would pass 600 s, so the repeats count from there.
+		expect(
+			[240_000, 240_000, 240_000, 240_000, 240_000, 240_000, 240_000].map(
+				(ms) => call(tracker, ms),
+			),
+		).toEqual(["ok", "ok", "ok", "ok", "soft", "ok", "hard"]);
+	});
+
+	it("starts a new run of identical calls, with its own cap, after another call", () => {
+		const tracker = new LoopDetectionTracker(undefined, {
+			thresholdMs: 120_000,
+			capMs: 600_000,
+		});
+		expect([240_000, 240_000, 240_000].map((ms) => call(tracker, ms))).toEqual([
+			"ok",
+			"ok",
+			"ok",
+		]);
+		expect(call(tracker, 100, OTHER)).toBe("ok");
+		expect(
+			[240_000, 240_000, 240_000, 240_000].map((ms) => call(tracker, ms)),
+		).toEqual(["ok", "ok", "ok", "ok"]);
+	});
+
+	it("exempts nothing when the harness sets no wait bound", () => {
+		const tracker = new LoopDetectionTracker(undefined, undefined);
+		expect(
+			[240_000, 240_000, 240_000, 240_000, 240_000].map((ms) =>
+				call(tracker, ms),
+			),
+		).toEqual(["ok", "ok", "soft", "ok", "hard"]);
+	});
+
+	it("does not exempt a repeat whose earlier call has not finished or was another call", () => {
+		const tracker = new LoopDetectionTracker(undefined, HARNESS);
+		// Two identical calls started side by side: the second is a repeat of a call that has not ended.
+		expect(tracker.inspect(WAIT).kind).toBe("ok");
+		expect(tracker.inspect(WAIT).kind).toBe("ok");
+		expect(tracker.inspect(WAIT).kind).toBe("soft");
+		// The end of another call says nothing about the wait.
+		tracker.finished(OTHER, 240_000);
+		expect(tracker.inspect(WAIT).kind).toBe("ok");
+		expect(tracker.inspect(WAIT).kind).toBe("hard");
+	});
+
+	it("forgets the wait on reset", () => {
+		const tracker = new LoopDetectionTracker(undefined, HARNESS);
+		call(tracker, 200);
+		call(tracker, 240_000);
+		tracker.reset();
+		expect([200, 200, 200, 200, 200].map((ms) => call(tracker, ms))).toEqual([
+			"ok",
+			"ok",
+			"soft",
+			"ok",
+			"hard",
+		]);
+	});
+});
