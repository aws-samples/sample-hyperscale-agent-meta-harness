+import { mkdirSync, mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { AgentSideConnection } from "@agentclientprotocol/sdk";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+const mocks = vi.hoisted(() => ({
+	core: undefined as unknown,
+	listener: undefined as ((event: unknown) => void) | undefined,
+	models: {} as Record<string, unknown>,
+	started: [] as Array<{ config: Record<string, unknown> }>,
+	script: undefined as ((emit: (event: unknown) => void) => void) | undefined,
+}));
+
+vi.mock("../session/session", () => ({
+	createCliCore: vi.fn(async () => mocks.core),
+}));
+vi.mock("../runtime/session-events", () => ({
+	subscribeToAgentEvents: (
+		_core: unknown,
+		listener: (event: unknown) => void,
+	) => {
+		mocks.listener = listener;
+		return () => {};
+	},
+}));
+vi.mock("../runtime/prompt", () => ({
+	resolveSystemPrompt: vi.fn(async () => "PROMPT"),
+}));
+vi.mock("@cline/core", async (importOriginal) => {
+	const actual = await importOriginal<typeof import("@cline/core")>();
+	return {
+		...actual,
+		Llms: {
+			...actual.Llms,
+			getModelsForProvider: vi.fn(async () => mocks.models),
+			getProvider: vi.fn(async (id: string) => ({
+				id,
+				name: id,
+				defaultModelId: "us.anthropic.claude-sonnet-5",
+			})),
+		},
+	};
+});
+
+import { AcpAgent } from "./acpAgent";
+import { resolveAcpCompaction } from "./compaction";
+
+// Harness patch 0012: compaction runs under ACP. The session config takes it from providers.json
+// settings.compaction (enabled, strategy, thresholdRatio); it is on when the model's window is
+// known (a configured contextWindow or a catalog window) and off when the window is a guess, so a
+// model with an unknown 1,000,000-token window is never summarised at the 128,000 fallback. The
+// session/prompt result reports the compactions of the turn in _meta.harness.
+
+const SONNET = "us.anthropic.claude-sonnet-5";
+const UNKNOWN = "global.anthropic.claude-sonnet-5-5";
+const conn = {
+	sessionUpdate: vi.fn(async () => {}),
+} as unknown as AgentSideConnection;
+
+function fakeCore() {
+	return {
+		start: vi.fn(async (input: { config: Record<string, unknown> }) => {
+			mocks.started.push(input);
+			return { sessionId: "core-session" };
+		}),
+		readMessages: vi.fn(async () => []),
+		dispose: vi.fn(async () => {}),
+		abort: vi.fn(async () => {}),
+		getAccumulatedUsage: vi.fn(async () => undefined),
+		send: vi.fn(async () => {
+			mocks.script?.((event) => mocks.listener?.(event));
+			return {
+				text: "done",
+				usage: { inputTokens: 1, outputTokens: 1 },
+				messages: [],
+				toolCalls: [],
+				iterations: 1,
+				finishReason: "completed",
+				model: { id: SONNET, provider: "bedrock" },
+				startedAt: new Date(0),
+				endedAt: new Date(0),
+				durationMs: 0,
+			};
+		}),
+	};
+}
+
+let dataDir = "";
+
+function writeSettings(settings: Record<string, unknown>) {
+	mkdirSync(join(dataDir, "settings"), { recursive: true });
+	writeFileSync(
+		join(dataDir, "settings", "providers.json"),
+		JSON.stringify({
+			version: 1,
+			lastUsedProvider: "bedrock",
+			providers: {
+				bedrock: {
+					settings: { provider: "bedrock", model: SONNET, ...settings },
+					updatedAt: "2026-09-30T00:00:00Z",
+					tokenSource: "manual",
+				},
