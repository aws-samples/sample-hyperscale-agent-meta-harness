+});
+
+describe("resolveAcpCompaction threshold ratio bounds", () => {
+	const ratioOf = (thresholdRatio: unknown) =>
+		resolveAcpCompaction({
+			settings: { thresholdRatio } as Parameters<
+				typeof resolveAcpCompaction
+			>[0]["settings"],
+			catalogWindow: 200_000,
+		}).config.thresholdRatio;
+
+	it("accepts the two ends of the range, 0.1 and 0.99", () => {
+		expect(ratioOf(0.1)).toBe(0.1);
+		expect(ratioOf(0.99)).toBe(0.99);
+	});
+
+	it("refuses a ratio just outside the range and a value that is not a number", () => {
+		for (const ratio of [0.09, 0.0999, 0.995, 1, 0, -0.5, 7, "0.5", null]) {
+			expect(ratioOf(ratio), String(ratio)).toBeUndefined();
+		}
+		expect(ratioOf(Number.NaN)).toBeUndefined();
+		expect(ratioOf(Number.POSITIVE_INFINITY)).toBeUndefined();
+	});
+});
