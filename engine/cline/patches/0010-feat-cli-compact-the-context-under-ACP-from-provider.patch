+import { describe, expect, it } from "vitest";
+import { _testing } from "./compat";
+
+// Harness patch 0012 (with 0011): a failed model stream keeps the structure of its failure on the
+// legacy ApiStream `done` chunk, so a caller that only sees the chunk (the compaction summary call)
+// can tell a provider fault from any other failure.
+
+describe("toApiStreamChunk finish -> done", () => {
+	const details = {
+		errorName: "ThrottlingException",
+		statusCode: 429,
+		isRetryable: true,
+		retryAfterS: 5,
+		attempts: 6,
+	};
+
+	it("carries errorDetails on a failed done chunk", () => {
+		expect(
+			_testing.toApiStreamChunk("gw_1", {
+				type: "finish",
+				reason: "error",
+				error: "Too many requests, please wait before trying again.",
+				errorDetails: details,
+			}),
+		).toEqual({
+			type: "done",
+			id: "gw_1",
+			success: false,
+			error: "Too many requests, please wait before trying again.",
+			incompleteReason: undefined,
+			errorDetails: details,
+		});
+	});
+
+	it("leaves a successful done chunk as it was", () => {
+		expect(
+			_testing.toApiStreamChunk("gw_1", { type: "finish", reason: "stop" }),
+		).toEqual({
+			type: "done",
+			id: "gw_1",
+			success: true,
+			error: undefined,
+			incompleteReason: undefined,
+		});
+	});
+});
