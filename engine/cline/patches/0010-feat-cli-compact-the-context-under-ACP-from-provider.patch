+/**
+ * The model info the runtime budgets against (context compaction, the result's
+ * `model.info`). A window configured for the session (providers.json
+ * `contextWindow`, `ProviderConfig.maxInputTokens`) is the window the caller
+ * proved for the model, so it applies to a model in the catalog too: without
+ * one the catalog row is used as it is.
+ */
+export function resolveModelInfoFromConfig(
+	config: AgentConfig,
+): ModelInfo | undefined {
+	const pc = config.providerConfig as ProviderConfig | undefined;
+	if (readPositiveInteger(pc?.maxInputTokens) === undefined) {
+		return (
+			config.knownModels?.[config.modelId] ??
+			resolveKnownModelsFromConfig(config)?.[config.modelId]
+		);
+	}
+	return resolveKnownModelsFromConfig(config)?.[config.modelId];
+}
