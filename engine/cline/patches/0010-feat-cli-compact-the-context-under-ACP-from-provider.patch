--- /dev/null
+++ b/apps/cli/src/acp/compaction.ts
@@ -0,0 +1,147 @@
+import type { AgentEvent } from "@cline/core";
+import type { Config } from "../utils/types";
+
+/**
+ * Context compaction under ACP (harness patch 0012).
+ *
+ * Upstream builds no `compaction` for an ACP session, so a long turn never
+ * compacts and providers.json `contextWindow` has no effect. The session config
+ * now comes from providers.json `settings.compaction`, which the harness writes
+ * per turn:
+ *
+ *   enabled         default: on when the model's window is known (a configured
+ *                   `contextWindow`, or a window in the model catalog), off when
+ *                   it is a guess, so a model of unknown size is never summarised
+ *                   at the 128,000-token fallback. `true` forces it on.
+ *   strategy        `agentic` (default: a summary call to the same model and
+ *                   route) or `basic` (truncation, no model call).
+ *   thresholdRatio  share of the input budget at which compaction starts
+ *                   (default 0.9; 0.1 to 0.99 accepted).
+ *
+ * A provider fault in the summary call ends the turn with the structured error
+ * of patch 0011 instead of falling back to truncation; the harness picks the
+ * degraded `basic` strategy itself.
+ */
+
+/** The trigger ratio compaction uses when the settings name none (core's COMPACTION_TRIGGER_RATIO). */
+export const ACP_DEFAULT_COMPACTION_THRESHOLD_RATIO = 0.9;
+
+const MIN_THRESHOLD_RATIO = 0.1;
+const MAX_THRESHOLD_RATIO = 0.99;
+
+/** What the session/prompt result reports about the compaction settings a turn ran with. */
+export interface AcpCompactionReport {
+	enabled: boolean;
+	strategy: "agentic" | "basic";
+	thresholdRatio: number;
+	/** The window the trigger is a share of, or null when it is unknown. */
+	windowTokens: number | null;
+}
+
+/** One compaction a turn performed. */
+export interface AcpCompactionRecord {
+	mode: "auto" | "overflow_recovery" | "manual";
+	tokensBefore?: number;
+	tokensAfter?: number;
+	messagesBefore?: number;
+	messagesAfter?: number;
+}
+
+interface RawCompactionSettings {
+	enabled?: unknown;
+	strategy?: unknown;
+	thresholdRatio?: unknown;
+}
+
+function positive(value: unknown): number | undefined {
+	return typeof value === "number" && Number.isFinite(value) && value > 0
+		? value
+		: undefined;
+}
+
+export function resolveAcpCompaction(input: {
+	/** providers.json `settings.compaction`. */
+	settings?: RawCompactionSettings;
+	/** providers.json `settings.contextWindow`. */
+	configuredWindow?: unknown;
+	/** The window the model catalog gives the model. */
+	catalogWindow?: unknown;
+}): {
+	config: NonNullable<Config["compaction"]>;
+	report: AcpCompactionReport;
+} {
+	const settings = input.settings;
+	const windowTokens =
+		positive(input.configuredWindow) ?? positive(input.catalogWindow);
+	const enabled =
+		typeof settings?.enabled === "boolean"
+			? settings.enabled
+			: windowTokens !== undefined;
+	const strategy = settings?.strategy === "basic" ? "basic" : "agentic";
+	const ratio = settings?.thresholdRatio;
+	const thresholdRatio =
+		typeof ratio === "number" &&
+		Number.isFinite(ratio) &&
+		ratio >= MIN_THRESHOLD_RATIO &&
+		ratio <= MAX_THRESHOLD_RATIO
+			? ratio
+			: undefined;
+	return {
+		config: {
+			enabled,
+			strategy,
+			...(thresholdRatio !== undefined ? { thresholdRatio } : {}),
+			failOnProviderFault: true,
+		},
+		report: {
+			enabled,
+			strategy,
+			thresholdRatio: thresholdRatio ?? ACP_DEFAULT_COMPACTION_THRESHOLD_RATIO,
+			windowTokens: windowTokens ?? null,
+		},
+	};
+}
+
+function finite(value: unknown): number | undefined {
+	return typeof value === "number" && Number.isFinite(value)
+		? value
+		: undefined;
+}
+
+/**
+ * The compaction a status notice reports as completed, or undefined for any
+ * other event (a started or skipped compaction, or an unrelated notice).
+ */
+export function readCompactionRecord(
+	event: AgentEvent,
+): AcpCompactionRecord | undefined {
+	if (event.type !== "notice" || event.noticeType !== "status") {
+		return undefined;
+	}
+	const metadata = event.metadata;
+	if (!metadata || metadata.phase !== "completed") {
+		return undefined;
+	}
+	const mode =
+		metadata.reason === "auto_compaction"
+			? "auto"
+			: metadata.reason === "overflow_recovery_compaction"
+				? "overflow_recovery"
+				: metadata.reason === "manual_compaction"
+					? "manual"
+					: undefined;
+	if (!mode) {
+		return undefined;
+	}
+	const tokensBefore = finite(metadata.tokensBefore);
+	const tokensAfter = finite(metadata.tokensAfter);
+	const messagesBefore = finite(metadata.messagesBefore);
+	const messagesAfter = finite(metadata.messagesAfter);
+	return {
+		mode,
+		...(tokensBefore !== undefined ? { tokensBefore } : {}),
+		...(tokensAfter !== undefined ? { tokensAfter } : {}),
+		...(messagesBefore !== undefined ? { messagesBefore } : {}),
+		...(messagesAfter !== undefined ? { messagesAfter } : {}),
+	};
+}
