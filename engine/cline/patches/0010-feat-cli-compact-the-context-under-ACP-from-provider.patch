+import { describe, expect, it } from "vitest";
+import { splitCoreSessionConfig } from "./runtime-host";
+
+// Harness patch 0012: the session config the ACP agent builds reaches the local runtime host through
+// splitCoreSessionConfig, which listed the compaction fields it copies. thresholdRatio and
+// failOnProviderFault were dropped there, so a fake-Bedrock probe of the fork saw the default 0.9
+// trigger and a fallback to truncation after a failed summary call whatever providers.json said.
+
+describe("splitCoreSessionConfig compaction", () => {
+	const base = { providerId: "bedrock", modelId: "m", apiKey: "" } as never;
+
+	it("keeps thresholdRatio and failOnProviderFault with the fields it already copied", () => {
+		const { config } = splitCoreSessionConfig({
+			...(base as object),
+			compaction: {
+				enabled: true,
+				strategy: "basic",
+				preserveRecentTokens: 5_000,
+				thresholdRatio: 0.8,
+				failOnProviderFault: true,
+			},
+		} as never);
+		expect(config.compaction).toEqual({
+			enabled: true,
+			strategy: "basic",
+			preserveRecentTokens: 5_000,
+			summarizer: undefined,
+			thresholdRatio: 0.8,
+			failOnProviderFault: true,
+		});
+	});
+
+	it("leaves a session with no compaction settings without a compaction member", () => {
+		const { config } = splitCoreSessionConfig(base);
+		expect(config.compaction).toBeUndefined();
+	});
+});
