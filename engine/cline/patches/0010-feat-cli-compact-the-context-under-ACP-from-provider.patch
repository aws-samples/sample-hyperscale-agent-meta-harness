+		expect(
+			(responses[1]?._meta as { harness: { compactions: unknown[] } }).harness
+				.compactions,
+		).toEqual([]);
+	});
+
+	it("reports compaction off with its reason when the window is unknown", async () => {
+		writeSettings({});
+		const { responses } = await prompt(UNKNOWN);
+		expect(
+			(responses[0]?._meta as { harness: { compaction: unknown } }).harness
+				.compaction,
+		).toEqual({
+			enabled: false,
+			strategy: "agentic",
