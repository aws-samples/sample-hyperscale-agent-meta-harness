diff --git a/sdk/packages/core/src/extensions/context/compaction.acp.test.ts b/sdk/packages/core/src/extensions/context/compaction.acp.test.ts
new file mode 100644
index 0000000..4bd8ae6
--- /dev/null
+++ b/sdk/packages/core/src/extensions/context/compaction.acp.test.ts
@@ -0,0 +1,305 @@
+import type * as LlmsProviders from "@cline/llms";
+import { estimateRequestInputTokens } from "@cline/shared";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { CoreCompactionConfig } from "../../types/config";
+import { createContextCompactionPrepareTurn } from "./compaction";
+
+// Harness patch 0012: compaction under ACP takes its trigger ratio from the session config
+// (providers.json settings.compaction.thresholdRatio) and can end the turn on a provider fault in
+// the summary call instead of falling back to lossy truncation.
+
+type FakeChunk = Record<string, unknown>;
+
+const createHandlerMock = vi.fn();
+
+vi.mock("@cline/llms", () => ({
+	createHandlerAsync: (config: unknown) => createHandlerMock(config),
+}));
+
+async function* streamChunks(chunks: FakeChunk[]): AsyncGenerator<FakeChunk> {
+	for (const chunk of chunks) {
+		yield chunk;
+	}
+}
+
+const transcript: LlmsProviders.Message[] = [
+	{ role: "user", content: "Original task" },
+	{ role: "assistant", content: `Old answer ${"x".repeat(600)}` },
+	{ role: "user", content: "Older follow-up" },
+	{ role: "assistant", content: `Older response ${"y".repeat(600)}` },
+	{ role: "user", content: "Latest request" },
+];
+
+const SYSTEM = "You are helpful.";
+
+function estimate(): number {
+	return estimateRequestInputTokens({
+		systemPrompt: SYSTEM,
+		messages: transcript,
+		tools: [],
+	});
+}
+
+function prepare(
+	compaction: CoreCompactionConfig,
+	utilization: number,
+	logger = { debug: vi.fn(), log: vi.fn() },
+	options: {
+		/** The input tokens the provider reported for the previous request. */
+		previous?: number;
+		/** A fixed input budget, instead of one sized from the estimate. */
+		maxInputTokens?: number;
+		/** The transcript to compact, instead of the shared one. */
+		messages?: LlmsProviders.Message[];
+	} = {},
+) {
+	const messages = options.messages ?? transcript;
+	const prepareTurn = createContextCompactionPrepareTurn({
+		providerId: "anthropic",
+		modelId: "mock-model",
+		providerConfig: {
+			providerId: "anthropic",
+			modelId: "mock-model",
+		} as LlmsProviders.ProviderConfig,
+		compaction,
+		logger,
+	});
+	return {
+		logger,
+		run: () =>
+			prepareTurn?.({
+				agentId: "agent-1",
+				conversationId: "conv-1",
+				parentAgentId: null,
+				iteration: 1,
+				abortSignal: new AbortController().signal,
+				systemPrompt: SYSTEM,
+				tools: [],
+				messages,
+				apiMessages: messages,
+				previousRequestInputTokens: options.previous,
+				model: {
+					id: "mock-model",
+					provider: "anthropic",
+					// The request is `utilization` of the input budget.
+					info: {
+						id: "mock-model",
+						maxInputTokens:
+							options.maxInputTokens ??
+							Math.ceil(
+								estimateRequestInputTokens({
+									systemPrompt: SYSTEM,
+									messages,
+									tools: [],
+								}) / utilization,
+							),
+					},
+				},
+			}),
+	};
+}
+
+beforeEach(() => {
+	createHandlerMock.mockReset();
+});
+
+describe("compaction thresholdRatio", () => {
+	it("compacts a request that sits at 0.6 of the budget when the ratio is 0.5, and not at the default 0.9", async () => {
+		const compact = vi.fn(async () => ({ messages: transcript.slice(-1) }));
+		const low = prepare({ enabled: true, compact, thresholdRatio: 0.5 }, 0.6);
+		const result = await low.run();
+		expect(compact).toHaveBeenCalledTimes(1);
+		expect(result?.messages).toHaveLength(1);
+		const ctx = (compact.mock.calls[0] as unknown[])[0] as {
+			budget: { request: { thresholdRatio: number; triggerTokens: number } };
+		};
+		expect(ctx.budget.request.thresholdRatio).toBe(0.5);
+
+		compact.mockClear();
+		const dflt = prepare({ enabled: true, compact }, 0.6);
+		expect(await dflt.run()).toBeUndefined();
+		expect(compact).not.toHaveBeenCalled();
+	});
+
+	it("does not compact at 0.89 of the budget and compacts at 0.91 with the default ratio", async () => {
+		const compact = vi.fn(async () => ({ messages: transcript.slice(-1) }));
+		expect(
+			await prepare({ enabled: true, compact }, 0.89).run(),
+		).toBeUndefined();
+		expect(compact).not.toHaveBeenCalled();
+		await prepare({ enabled: true, compact }, 0.91).run();
+		expect(compact).toHaveBeenCalledTimes(1);
+	});
+
+	it("keeps the default ratio for a value that is not a usable fraction", async () => {
+		for (const bad of [0, -1, 1, 5, Number.NaN, Number.POSITIVE_INFINITY]) {
+			const compact = vi.fn(async () => ({ messages: transcript.slice(-1) }));
+			// 0.6 of the budget: only a ratio at or below 0.6 would compact.
+			expect(
+				await prepare(
+					{ enabled: true, compact, thresholdRatio: bad },
+					0.6,
+				).run(),
+			).toBeUndefined();
+			expect(compact).not.toHaveBeenCalled();
+		}
+	});
+});
+
+describe("compaction trigger on the count the provider reported", () => {
+	const WINDOW = 100_000;
+	const compact = vi.fn(async () => ({ messages: transcript.slice(-1) }));
+
+	/** A one-message transcript of about `tokens` estimated tokens (the fork estimates 3 characters a token). */
+	function bulk(tokens: number): LlmsProviders.Message[] {
+		return [
+			{ role: "user", content: "Original task" },
+			{ role: "assistant", content: "x".repeat(tokens * 3) },
+			{ role: "user", content: "Latest request" },
+		];
+	}
+
+	beforeEach(() => compact.mockClear());
+
+	it("compacts at exactly 0.9 of the window whatever the estimate is, and at 0.5 for ratio 0.5", async () => {
+		// The correction the fork applies divides the budget by reported/estimate and multiplies by the
+		// ratio; in floating point that lands on either side of the estimate at exactly the threshold.
+		// 200 estimates between a quarter of the reported count and just under it must all compact.
+		let compacted = 0;
+		for (let i = 0; i < 200; i += 1) {
+			const tokens = 23_000 + i * 320;
+			const run = prepare({ enabled: true, compact }, 0.5, undefined, {
+				previous: 90_000,
+				maxInputTokens: WINDOW,
+				messages: bulk(tokens),
+			});
+			await run.run();
+			compacted = compact.mock.calls.length;
+		}
+		expect(compacted).toBe(200);
+		compact.mockClear();
+		for (let i = 0; i < 100; i += 1) {
+			const run = prepare(
+				{ enabled: true, compact, thresholdRatio: 0.5 },
+				0.5,
+				undefined,
+				{
+					previous: 50_000,
+					maxInputTokens: WINDOW,
+					messages: bulk(13_000 + i * 300),
+				},
+			);
+			await run.run();
+		}
+		expect(compact).toHaveBeenCalledTimes(100);
+	});
+
+	it("does not compact when the provider reported 0.89 of the window", async () => {
+		for (let i = 0; i < 100; i += 1) {
+			const run = prepare({ enabled: true, compact }, 0.5, undefined, {
+				previous: 89_000,
+				maxInputTokens: WINDOW,
+				messages: bulk(23_000 + i * 600),
+			});
+			await run.run();
+		}
+		expect(compact).not.toHaveBeenCalled();
+	});
+
+	it("takes a reported count of more than 4 times the estimate as 4 times the estimate", async () => {
+		// The cap keeps a tiny estimate from collapsing the budget and compacting every turn.
+		const run = prepare({ enabled: true, compact }, 0.5, undefined, {
+			previous: 90_000,
+			maxInputTokens: WINDOW,
+			messages: bulk(5_000),
+		});
+		expect(await run.run()).toBeUndefined();
+		expect(compact).not.toHaveBeenCalled();
+	});
+});
+
+describe("compaction failOnProviderFault", () => {
+	const serviceDown = {
+		errorName: "ServiceUnavailableException",
+		statusCode: 503,
+		isRetryable: true,
+		attempts: 6,
+	};
+
+	function failingSummary(details: Record<string, unknown> | undefined) {
+		createHandlerMock.mockReturnValue({
+			createMessage: vi.fn(() =>
+				streamChunks([
+					{
+						type: "done",
+						id: "summary",
+						success: false,
+						error: "The service isn't currently available. Retry your request.",
+						...(details ? { errorDetails: details } : {}),
+					},
+				]),
+			),
+		});
+	}
+
+	const agentic = {
+		enabled: true,
+		strategy: "agentic",
+		preserveRecentTokens: 1,
+	} as const;
+
+	it("ends the turn with the summary call's structured error when the flag is set", async () => {
+		failingSummary(serviceDown);
+		const p = prepare({ ...agentic, failOnProviderFault: true }, 0.95);
+		const error = await Promise.resolve(p.run()).then(
+			() => undefined,
+			(e: unknown) => e as Error & { errorDetails?: unknown },
+		);
+		expect(error?.message).toBe(
+			"The service isn't currently available. Retry your request.",
+		);
+		expect(error?.errorDetails).toEqual(serviceDown);
+		expect(p.logger.log).not.toHaveBeenCalledWith(
+			"Agentic compaction failed; falling back to basic compaction",
+			expect.anything(),
+		);
+	});
+
+	it("also ends the turn on an authentication failure", async () => {
+		failingSummary({
+			errorName: "AccessDeniedException",
+			statusCode: 403,
+			isRetryable: false,
+		});
+		await expect(
+			prepare({ ...agentic, failOnProviderFault: true }, 0.95).run(),
+		).rejects.toMatchObject({ errorDetails: { statusCode: 403 } });
+	});
+
+	it("falls back to basic truncation for a failure that is not a provider fault", async () => {
+		for (const details of [
+			undefined,
+			{ errorName: "ValidationException", statusCode: 400, isRetryable: false },
+		]) {
+			failingSummary(details);
+			const p = prepare({ ...agentic, failOnProviderFault: true }, 0.95);
+			const result = await p.run();
+			expect(result?.messages).toBeDefined();
+			expect(p.logger.log).toHaveBeenCalledWith(
+				"Agentic compaction failed; falling back to basic compaction",
+				expect.objectContaining({ severity: "warn" }),
+			);
+		}
+	});
+
+	it("keeps the upstream fallback to basic truncation when the flag is not set", async () => {
+		failingSummary(serviceDown);
+		const p = prepare(agentic, 0.95);
+		const result = await p.run();
+		expect(result?.messages).toBeDefined();
+		expect(p.logger.log).toHaveBeenCalledWith(
+			"Agentic compaction failed; falling back to basic compaction",
+			expect.objectContaining({ severity: "warn" }),
+		);
+	});
+});
diff --git a/sdk/packages/core/src/extensions/context/compaction.pairing.test.ts b/sdk/packages/core/src/extensions/context/compaction.pairing.test.ts
new file mode 100644
index 0000000..d48d983
--- /dev/null
+++ b/sdk/packages/core/src/extensions/context/compaction.pairing.test.ts
@@ -0,0 +1,228 @@
+import type * as LlmsProviders from "@cline/llms";
+import type { MessageWithMetadata } from "@cline/shared";
+import { estimateRequestInputTokens } from "@cline/shared";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { createContextCompactionPrepareTurn } from "./compaction";
+
+// Harness patch 0012: compaction now runs under ACP, where a request whose tool calls and tool results
+// do not pair is rejected by Bedrock's Converse API. The pairing is checked on the transcript a
+// compaction returns, for a few hundred generated transcripts (parallel calls, several rounds, one typed
+// prompt or several) and for every place the cut can fall, with both strategies.
+
+type Chunk = Record<string, unknown>;
+
+const createHandlerMock = vi.fn();
+
+vi.mock("@cline/llms", () => ({
+	createHandlerAsync: (config: unknown) => createHandlerMock(config),
+}));
+
+async function* summary(): AsyncGenerator<Chunk> {
+	yield {
+		type: "text",
+		id: "s",
+		text: "## Goal\nFinish the task\n\n## Next\nContinue from the last result",
+	};
+	yield { type: "done", id: "s", success: true };
+}
+
+/** A small deterministic generator (mulberry32) so a failure names its seed. */
+function rng(seed: number): () => number {
+	let a = seed >>> 0;
+	return () => {
+		a = (a + 0x6d2b79f5) >>> 0;
+		let t = a;
+		t = Math.imul(t ^ (t >>> 15), t | 1);
+		t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+	};
+}
+
+function generate(seed: number): MessageWithMetadata[] {
+	const next = rng(seed);
+	const int = (lo: number, hi: number) =>
+		lo + Math.floor(next() * (hi - lo + 1));
+	const filler = (n: number) => "x".repeat(n);
+	const messages: MessageWithMetadata[] = [];
+	let id = 0;
+	const prompts = int(1, 3);
+	for (let p = 0; p < prompts; p += 1) {
+		messages.push({
+			role: "user",
+			content: `Task ${p + 1} ${filler(int(20, 400))}`,
+		});
+		const rounds = int(0, 4);
+		for (let r = 0; r < rounds; r += 1) {
+			const calls = int(1, 3);
+			const ids = Array.from({ length: calls }, () => `tool-${(id += 1)}`);
+			messages.push({
+				role: "assistant",
+				content: [
+					{ type: "text", text: `Round ${r} ${filler(int(10, 300))}` },
+					...ids.map((tid) => ({
+						type: "tool_use" as const,
+						id: tid,
+						name: "read_files",
+						input: { file_paths: [`/tmp/${tid}.ts`] },
+					})),
+				],
+			});
+			messages.push({
+				role: "user",
+				content: ids.map((tid) => ({
+					type: "tool_result" as const,
+					tool_use_id: tid,
+					name: "read_files",
+					content: filler(int(10, 900)),
+				})),
+			});
+		}
+		messages.push({
+			role: "assistant",
+			content: [
+				{ type: "text", text: `Done ${p + 1} ${filler(int(10, 200))}` },
+			],
+		});
+	}
+	messages.push({ role: "user", content: "One more thing please" });
+	return messages;
+}
+
+function blocks(message: MessageWithMetadata | undefined) {
+	return message && typeof message.content !== "string" ? message.content : [];
+}
+
+/** The pairing rule Converse enforces, on a transcript's messages. */
+function pairingErrors(messages: MessageWithMetadata[]): string[] {
+	const errors: string[] = [];
+	messages.forEach((message, i) => {
+		const uses = blocks(message)
+			.filter((b) => b.type === "tool_use")
+			.map((b) => (b as { id: string }).id);
+		const results = blocks(message)
+			.filter((b) => b.type === "tool_result")
+			.map((b) => (b as { tool_use_id: string }).tool_use_id);
+		if (message.role === "assistant" && uses.length > 0) {
+			const next = messages[i + 1];
+			const answered = new Set(
+				next?.role === "user"
+					? blocks(next)
+							.filter((b) => b.type === "tool_result")
+							.map((b) => (b as { tool_use_id: string }).tool_use_id)
+					: [],
+			);
+			for (const use of uses) {
+				if (!answered.has(use)) {
+					errors.push(`message ${i}: tool_use ${use} has no result`);
+				}
+			}
+		}
+		if (results.length > 0) {
+			const prev = messages[i - 1];
+			const prevUses = new Set(
+				prev?.role === "assistant"
+					? blocks(prev)
+							.filter((b) => b.type === "tool_use")
+							.map((b) => (b as { id: string }).id)
+					: [],
+			);
+			for (const result of results) {
+				if (!prevUses.has(result)) {
+					errors.push(`message ${i}: tool_result ${result} is an orphan`);
+				}
+			}
+		}
+	});
+	return errors;
+}
+
+const SYSTEM = "You are helpful.";
+
+async function compact(
+	messages: MessageWithMetadata[],
+	options: { strategy: "basic" | "agentic"; preserve: number; forced: boolean },
+) {
+	const estimate = estimateRequestInputTokens({
+		systemPrompt: SYSTEM,
+		messages,
+		tools: [],
+	});
+	const prepareTurn = createContextCompactionPrepareTurn({
+		providerId: "anthropic",
+		modelId: "mock-model",
+		providerConfig: {
+			providerId: "anthropic",
+			modelId: "mock-model",
+		} as LlmsProviders.ProviderConfig,
+		compaction: {
+			enabled: true,
+			strategy: options.strategy,
+			preserveRecentTokens: options.preserve,
+		},
+		logger: { debug: vi.fn(), log: vi.fn() },
+	});
+	return await prepareTurn?.({
+		agentId: "agent-1",
+		conversationId: "conv-1",
+		parentAgentId: null,
+		iteration: 2,
+		abortSignal: new AbortController().signal,
+		systemPrompt: SYSTEM,
+		tools: [],
+		messages,
+		apiMessages: messages,
+		overflowRecovery: options.forced || undefined,
+		model: {
+			id: "mock-model",
+			provider: "anthropic",
+			// The request sits at 0.95 of the budget, over the 0.9 trigger.
+			info: { id: "mock-model", maxInputTokens: Math.ceil(estimate / 0.95) },
+		},
+	});
+}
+
+beforeEach(() => {
+	createHandlerMock.mockReset();
+	createHandlerMock.mockReturnValue({ createMessage: vi.fn(() => summary()) });
+});
+
+describe("a compacted transcript keeps every tool call paired with its result", () => {
+	it("generates transcripts that pair to begin with", () => {
+		for (let seed = 1; seed <= 50; seed += 1) {
+			expect(pairingErrors(generate(seed)), `seed ${seed}`).toEqual([]);
+		}
+	});
+
+	for (const strategy of ["basic", "agentic"] as const) {
+		it(`stays paired under the ${strategy} strategy for 200 transcripts and every preserved size`, async () => {
+			let compacted = 0;
+			for (let seed = 1; seed <= 200; seed += 1) {
+				const messages = generate(seed);
+				for (const preserve of [1, 80, 400, 1_500]) {
+					const result = await compact(messages, {
+						strategy,
+						preserve,
+						// Basic runs in the forced (overflow recovery) mode, which always compacts;
+						// the agentic strategy runs in auto mode over the trigger.
+						forced: strategy === "basic",
+					});
+					if (!result?.messages) {
+						continue;
+					}
+					compacted += 1;
+					expect(
+						pairingErrors(result.messages),
+						`seed ${seed}, preserve ${preserve}`,
+					).toEqual([]);
+					expect(result.messages.length, `seed ${seed}`).toBeGreaterThan(0);
+					// The latest typed prompt survives.
+					expect(
+						JSON.stringify(result.messages.at(-1)),
+						`seed ${seed}, preserve ${preserve}`,
+					).toContain("One more thing please");
+				}
+			}
+			expect(compacted).toBeGreaterThan(200);
+		});
+	}
+});
diff --git a/sdk/packages/core/src/extensions/context/compaction.ts b/sdk/packages/core/src/extensions/context/compaction.ts
