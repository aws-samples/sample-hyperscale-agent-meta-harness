+import { describe, expect, it } from "vitest";
+import { ProviderSettingsSchema } from "./provider-settings";
+
+// Harness patch 0012: providers.json `settings.compaction` (the harness writes it per turn) is kept by
+// the settings schema. A value it cannot use must not invalidate the rest of the entry (region,
+// endpoint, maxTokens, contextWindow), so the schema only types the keys and the reader validates.
+
+describe("ProviderSettingsSchema compaction", () => {
+	it("keeps enabled, strategy and thresholdRatio", () => {
+		const parsed = ProviderSettingsSchema.parse({
+			provider: "bedrock",
+			contextWindow: 1_000_000,
+			compaction: { enabled: true, strategy: "basic", thresholdRatio: 0.8 },
+		});
+		expect(parsed.compaction).toEqual({
+			enabled: true,
+			strategy: "basic",
+			thresholdRatio: 0.8,
+		});
+		expect(parsed.contextWindow).toBe(1_000_000);
+	});
+
+	it("accepts an entry with no compaction settings", () => {
+		const parsed = ProviderSettingsSchema.parse({ provider: "bedrock" });
+		expect(parsed.compaction).toBeUndefined();
+	});
+
+	it("does not reject the entry over a compaction value the reader will ignore", () => {
+		const parsed = ProviderSettingsSchema.safeParse({
+			provider: "bedrock",
+			region: "us-east-1",
+			compaction: { strategy: "someday", thresholdRatio: 7 },
+		});
+		expect(parsed.success).toBe(true);
+	});
+
+	it("drops a compaction value of the wrong type instead of rejecting the entry", () => {
+		const parsed = ProviderSettingsSchema.safeParse({
+			provider: "bedrock",
+			region: "us-east-1",
+			compaction: { enabled: "yes" },
+		});
+		expect(parsed.success).toBe(true);
+		expect(parsed.success && parsed.data.compaction).toBeUndefined();
+		expect(parsed.success && parsed.data.region).toBe("us-east-1");
+	});
+});
