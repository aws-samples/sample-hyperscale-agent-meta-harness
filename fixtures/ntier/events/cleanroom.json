{
  "schemaVersion": 1,
  "kind": "events",
  "composeFiles": [
    "compose.yaml",
    "compose.yml",
    "docker-compose.yaml",
    "docker-compose.yml"
  ],
  "services": [
    "db",
    "broker"
  ],
  "composeImage": "docker:27-cli@sha256:851f91d241214e7c6db86513b270d58776379aacc5eb9c4a87e5b47115e3065c",
  "runtimeSecrets": [
    "BROKER_PASSWORD"
  ],
  "env": {
    "DATABASE_URL": "postgres://app@db:5432/app?sslmode=disable",
    "BROKER_URL": "amqp://app:${BROKER_PASSWORD}@broker:5672/",
    "GOPROXY": "https://proxy.golang.org",
    "GOSUMDB": "sum.golang.org"
  },
  "tiers": [
    {
      "name": "unit",
      "tier": "unit",
      "image": "golang:1.27-bookworm@sha256:8d48e12ec56735e9358640898b9d9b9fcca110612ed8a5567438c0a1baa24e66",
      "command": "scripts/test-unit.sh",
      "junit": "test-results/unit"
    },
    {
      "name": "integration",
      "tier": "integration",
      "image": "golang:1.27-bookworm@sha256:8d48e12ec56735e9358640898b9d9b9fcca110612ed8a5567438c0a1baa24e66",
      "command": "scripts/test-integration.sh",
      "junit": "test-results/integration"
    },
    {
      "name": "e2e",
      "tier": "e2e",
      "image": "golang:1.27-bookworm@sha256:8d48e12ec56735e9358640898b9d9b9fcca110612ed8a5567438c0a1baa24e66",
      "command": "scripts/test-e2e.sh",
      "junit": "test-results/e2e"
    }
  ],
  "oracle": [
    {
      "name": "oracle",
      "image": "golang:1.27-bookworm@sha256:8d48e12ec56735e9358640898b9d9b9fcca110612ed8a5567438c0a1baa24e66",
      "command": "run.sh",
      "minTests": 20
    }
  ],
  "egress": [
    "proxy.golang.org",
    "sum.golang.org"
  ],
  "timeoutMin": 30
}
