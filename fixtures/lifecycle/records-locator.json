 "baseCases": [
  {
   "name": "neither folder",
   "files": [],
   "expect": "current"
  },
  {
   "name": "only the current folder, a card",
   "files": [
    ".ham/lifecycle/GOAL.md"
   ],
   "expect": "current"
  },
  {
   "name": "only the current folder, the locator",
   "files": [
    ".ham/records"
   ],
   "expect": "current"
  },
  {
   "name": "only the legacy folder, a card",
   "files": [
    ".cah/lifecycle/GOAL.md"
   ],
   "expect": "legacy"
  },
  {
   "name": "only the legacy folder, a red record deep down",
   "files": [
    ".cah/lifecycle/red/01-add.txt"
   ],
   "expect": "legacy"
  },
  {
   "name": "only the legacy folder, the locator",
   "files": [
    {
     "path": ".cah/records",
     "text": "docs\n"
    }
   ],
   "expect": "legacy"
  },
  {
   "name": "only the legacy folder, the test command",
   "files": [
    {
     "path": ".cah/test-command",
     "text": "make test\n"
    }
   ],
   "expect": "legacy"
  },
  {
   "name": "only the legacy folder, a research note",
   "files": [
    ".cah/research/01-topic.md"
   ],
   "expect": "legacy"
  },
  {
   "name": "only the legacy folder, the context index",
   "files": [
    ".cah/context/INDEX.md"
   ],
   "expect": "legacy"
  },
  {
   "name": "both folders hold a card",
   "files": [
    ".ham/lifecycle/GOAL.md",
    ".cah/lifecycle/GOAL.md"
   ],
   "expect": "refuse"
  },
  {
   "name": "the current locator and a legacy card",
   "files": [
    ".ham/records",
    ".cah/lifecycle/GOAL.md"
   ],
   "expect": "refuse"
  },
  {
   "name": "the current test command and a legacy card",
   "files": [
    ".ham/test-command",
    ".cah/lifecycle/GOAL.md"
   ],
   "expect": "refuse"
  },
  {
   "name": "an empty current folder never hides legacy records",
   "emptyDirs": [
    ".ham"
   ],
   "files": [
    ".cah/lifecycle/LOG.md"
   ],
   "expect": "legacy"
  },
  {
   "name": "empty record folders in the current folder hide nothing",
   "emptyDirs": [
    ".ham/lifecycle",
    ".ham/research",
    ".ham/context"
   ],
   "files": [
    ".cah/lifecycle/LOG.md"
   ],
   "expect": "legacy"
  },
  {
   "name": "empty legacy folders hold no state",
   "emptyDirs": [
    ".cah/lifecycle",
    ".cah/context"
   ],
   "expect": "current"
  },
  {
   "name": "a stray file in the legacy folder is no state",
   "files": [
    ".cah/notes.txt"
   ],
   "expect": "current"
  },
  {
   "name": "a stray file in the current folder does not count against legacy records",
   "files": [
    ".ham/notes.txt",
    ".cah/lifecycle/GOAL.md"
   ],
   "expect": "legacy"
  },
  {
   "name": "a legacy folder that is a link holds nothing",
   "links": [
    {
     "path": ".cah",
     "target": "elsewhere"
    }
   ],
   "files": [
    "elsewhere/lifecycle/GOAL.md"
   ],
   "expect": "current"
  },
  {
   "name": "a current folder that is a link holds nothing",
   "links": [
    {
     "path": ".ham",
     "target": "elsewhere"
    }
   ],
   "files": [
    "elsewhere/lifecycle/GOAL.md",
    ".cah/lifecycle/GOAL.md"
   ],
   "expect": "legacy"
  },
  {
   "name": "a record folder that is a link holds nothing",
   "emptyDirs": [
    ".cah"
   ],
   "links": [
    {
     "path": ".cah/lifecycle",
     "target": "../elsewhere"
    }
   ],
   "files": [
    "elsewhere/GOAL.md"
   ],
   "expect": "current"
  },
  {
   "name": "a card that is a link is not a regular file",
   "emptyDirs": [
    ".cah/lifecycle"
   ],
   "links": [
    {
     "path": ".cah/lifecycle/GOAL.md",
     "target": "../../elsewhere.md"
    }
   ],
   "files": [
    "elsewhere.md"
   ],
   "expect": "current"
  },
  {
   "name": "a locator that is a link is not a regular file",
   "emptyDirs": [
    ".cah"
   ],
   "links": [
    {
     "path": ".cah/records",
     "target": "../elsewhere.txt"
    }
   ],
   "files": [
    "elsewhere.txt"
   ],
   "expect": "current"
  },
  {
   "name": "a locator that is a directory is not a regular file",
   "emptyDirs": [
    ".cah/records"
   ],
   "expect": "current"
  }
 ]
