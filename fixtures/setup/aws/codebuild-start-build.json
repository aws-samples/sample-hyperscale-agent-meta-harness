{
    "build": {
        "id": "{id}",
        "arn": "arn:aws:codebuild:{region}:{account}:build/{id}",
        "buildNumber": "{number}",
        "startTime": "2026-10-29T17:05:00.000000+00:00",
        "currentPhase": "QUEUED",
        "buildStatus": "IN_PROGRESS",
        "projectName": "{project}",
        "phases": [
            {
                "phaseType": "SUBMITTED",
                "phaseStatus": "SUCCEEDED"
            },
            {
                "phaseType": "QUEUED",
                "startTime": "2026-10-29T17:05:00.000000+00:00"
            }
        ],
        "source": {
            "type": "S3",
            "location": "{bucket}/{source}"
        },
        "environment": {
            "type": "LINUX_CONTAINER",
            "image": "aws/codebuild/amazonlinux-x86_64-standard:5.0",
            "computeType": "BUILD_GENERAL1_LARGE",
            "environmentVariables": "{environment}"
        },
        "logs": {
            "deepLink": "https://console.aws.amazon.com/cloudwatch/home?region={region}#logEvent:group={group};stream={stream}",
            "groupName": "{group}",
            "streamName": "{stream}"
        }
    }
}
