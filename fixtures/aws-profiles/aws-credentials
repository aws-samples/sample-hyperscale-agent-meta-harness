# Shaped like ~/.aws/credentials. Static keys for profiles of the file "aws-config" (placeholders, not keys), and one credential_process profile.
[keys]
aws_access_key_id = AKIDNOTAKEY
aws_secret_access_key = not-a-secret

[both]
aws_access_key_id = AKIDNOTAKEY
aws_secret_access_key = not-a-secret

[proc-in-credentials]
credential_process = helper print
